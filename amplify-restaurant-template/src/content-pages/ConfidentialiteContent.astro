---
// Minimal, honest privacy page — required the moment any tracking script
// (Analytics, Meta Pixel) gets added, so it ships now even though nothing
// is tracked yet. Update the second paragraph the day tracking is added —
// don't let this page go stale and become inaccurate, which is worse than
// not having one.
//
// See HomeContent.astro's top comment for the shared-body-per-route
// pattern this and every other src/content-pages/*.astro file follows.
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.config';
import { t, localizedPath, type Language } from '../i18n/languages';
import { seoDefaults } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = siteConfig.identity.city;

const copy = {
  metaTitle: { fr: `Confidentialité — ${name}`, en: `Privacy — ${name}`, ar: `الخصوصية — ${name}` },
  metaDescription: {
    fr: `Politique de confidentialité de ${name}, ${primaryKeyword} à ${city}.`,
    en: `Privacy policy of ${name}, ${primaryKeyword} in ${city}.`,
    ar: `سياسة الخصوصية لـ${name}, ${primaryKeyword} في ${city}.`,
  },
  heading: { fr: 'Politique de confidentialité', en: 'Privacy policy', ar: 'سياسة الخصوصية' },
  p1: {
    fr: `Ce site est édité par ${name} (${siteConfig.contact.address}). Cette page décrit quelles données sont collectées lors de votre visite et comment elles sont utilisées.`,
    en: `This site is published by ${name} (${siteConfig.contact.address}). This page describes what data is collected during your visit and how it is used.`,
    ar: `يُنشر هذا الموقع من طرف ${name} (${siteConfig.contact.address}). تصف هذه الصفحة البيانات التي تُجمع أثناء زيارتكم وكيفية استخدامها.`,
  },
  p2: {
    fr: "À ce jour, ce site n'utilise aucun cookie de suivi ni outil d'analyse (Google Analytics, pixel publicitaire ou équivalent) : votre navigation n'est pas suivie. Si un tel outil est ajouté à l'avenir, cette page sera mise à jour en conséquence et, le cas échéant, un bandeau de consentement sera ajouté avant toute activation.",
    en: 'As of today, this site uses no tracking cookies or analytics tools (Google Analytics, advertising pixel or equivalent): your browsing is not tracked. If such a tool is added in the future, this page will be updated accordingly and, where required, a consent banner will be added before any activation.',
    ar: 'لا يستخدم هذا الموقع حاليًا أي ملفات تعريف ارتباط للتتبع أو أدوات تحليل (Google Analytics أو بكسل إعلاني أو ما شابه): لا يتم تتبع تصفحكم. إذا أُضيفت أداة كهذه مستقبلًا، ستُحدَّث هذه الصفحة تبعًا لذلك، وسيُضاف عند الاقتضاء شريط موافقة قبل أي تفعيل.',
  },
  p3: {
    fr: 'Les seules données personnelles transmises le sont directement par vous, si vous choisissez de nous contacter par téléphone, WhatsApp ou via le site de commande en ligne — elles servent uniquement à traiter votre demande ou votre commande et ne sont pas revendues à des tiers.',
    en: 'The only personal data transmitted is provided directly by you, should you choose to contact us by phone, WhatsApp or through the online ordering site — it is used solely to process your request or order and is never resold to third parties.',
    ar: 'البيانات الشخصية الوحيدة التي تُنقل هي تلك التي تقدمونها مباشرة، في حال اخترتم التواصل معنا عبر الهاتف أو واتساب أو موقع الطلب الإلكتروني — وتُستخدم فقط لمعالجة طلبكم ولا تُباع لأي طرف ثالث.',
  },
  p4: { fr: 'Pour toute question concernant vos données, contactez-nous au', en: 'For any question regarding your data, contact us at', ar: 'لأي استفسار بخصوص بياناتكم، تواصلوا معنا على' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const path = localizedPath('/confidentialite', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  noindex
>
  <section class="max-w-2xl mx-auto px-5 sm:px-8 pt-28 sm:pt-36 pb-20">
    <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-2" style="color: var(--color-accent)">{t(seoDefaults.legal, lang)}</span>
    <h1 class="font-display text-3xl sm:text-4xl font-semibold mb-8" style="color: var(--color-text-primary)">
      {t(copy.heading, lang)}
    </h1>

    <div class="space-y-5 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">
      <p>{t(copy.p1, lang)}</p>
      <p>{t(copy.p2, lang)}</p>
      <p>{t(copy.p3, lang)}</p>
      <p>
        {t(copy.p4, lang)}{' '}
        <a href={siteConfig.contact.phoneHref} class="hover:underline" style="color: var(--color-accent)">
          {siteConfig.contact.phoneDisplay}
        </a>.
      </p>
    </div>
  </section>
</Layout>
