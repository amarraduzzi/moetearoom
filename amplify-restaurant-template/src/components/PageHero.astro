---
// Compact photo-hero for interior pages — same visual grammar as the big
// Home hero (full-bleed photo, dark gradient rising from the bottom, gold
// kicker + serif H1 sitting in the same spot) but shorter (44-50vh instead
// of 88vh/min-h-screen). Home's hero is deliberately the one "big" opening
// moment on the site; repeating it at full size on every page would dilute
// that and get repetitive fast with only a handful of real photos to draw
// from. This gives every page the same "opening" feeling without
// competing with Home for attention.
interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
  image: string;
  alt: string;
}
const { kicker, title, subtitle, image, alt } = Astro.props;
---
<section class="relative h-[42vh] min-h-[320px] sm:h-[48vh] sm:min-h-[380px] flex items-end overflow-hidden">
  <img src={image} alt={alt} class="absolute inset-0 w-full h-full object-cover" />
  <div
    class="absolute inset-0"
    style="background: linear-gradient(0deg, var(--color-background) 10%, rgba(11,11,12,0.5) 60%, rgba(11,11,12,0.7) 100%)"
  ></div>

  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-10 sm:pb-14 w-full">
    <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-2" style="color: var(--color-accent)">
      {kicker}
    </span>
    <h1 class="font-display text-3xl sm:text-5xl font-semibold" style="color: var(--color-text-primary)">
      {title}
    </h1>
    {subtitle && (
      <p class="mt-3 max-w-xl text-sm sm:text-base" style="color: var(--color-text-muted)">
        {subtitle}
      </p>
    )}
  </div>
</section>
