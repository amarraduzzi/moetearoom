---
// Compact photo-hero for interior pages — same visual grammar as the big
// Home hero (full-bleed photo, feathered vignette rising from the bottom,
// gold kicker + serif H1 sitting in the same spot) but shorter (44-50vh
// instead of 88vh/min-h-screen). Home's hero is deliberately the one "big"
// opening moment on the site; repeating it at full size on every page
// would dilute that and get repetitive fast with only a handful of real
// photos to draw from. This gives every page the same "opening" feeling
// without competing with Home for attention.
//
// Previously this used a page-cream (var(--color-background)) wash across
// the WHOLE photo, up to 70% opacity even near the top — every interior
// page photo read as hazy/washed-out next to Home's crisp one. Fixed to
// use Home's actual technique instead: a dark, feathered vignette confined
// to where the text sits, near-white text on top, and the rest of the
// photo left fully bright and untouched.
interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
  image: string;
  alt: string;
}
const { kicker, title, subtitle, image, alt } = Astro.props;
---
<section class="relative h-[42vh] min-h-[320px] sm:h-[48vh] sm:min-h-[380px] flex items-end overflow-hidden">
  <img src={image} alt={alt} class="absolute inset-0 w-full h-full object-cover" style="filter: saturate(1.1) contrast(1.05)" />
  <div
    class="absolute inset-0"
    style="background: linear-gradient(0deg, rgba(20,14,8,0.68) 0%, rgba(20,14,8,0.4) 30%, rgba(20,14,8,0.08) 60%, transparent 78%)"
  ></div>

  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-10 sm:pb-14 w-full">
    <span class="hero-shadow block text-[10px] font-bold uppercase tracking-[0.25em] mb-2" style="color: var(--color-accent)">
      {kicker}
    </span>
    <h1 class="hero-shadow font-display text-3xl sm:text-5xl font-semibold" style="color: #FFFCF3">
      {title}
    </h1>
    {subtitle && (
      <p class="hero-shadow mt-3 max-w-xl text-sm sm:text-base" style="color: rgba(255,252,243,0.92)">
        {subtitle}
      </p>
    )}
  </div>
</section>

<style>
  /* Same rationale as Home's hero-shadow: a soft, tight drop-shadow so the
     near-white text keeps a hairline of separation from the photo in the
     few spots the vignette runs light, without resorting to a text-stroke
     "sticker" look. */
  .hero-shadow {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 18px rgba(0, 0, 0, 0.45);
  }
</style>
