---
// Site-wide cart + checkout widget, rendered once in Layout.astro (same
// pattern as WhatsAppButton.astro) so it's available on every page. Static
// HTML for the closed state (floating button); everything else — opening
// the drawer, adding/removing lines, the checkout form — is vanilla JS
// against src/lib/cart.ts's localStorage-backed cart. No framework: this
// site ships zero client-side JS runtime by design (astro.config.mjs,
// `output: 'static'`), so a full cart/checkout UI still has to be plain
// TypeScript + DOM, not React/Vue state.
//
// On submit this does two things, fired together, neither waiting on the
// other: (1) opens a pre-filled WhatsApp chat with the order (same "the
// order lives in the WhatsApp message" pattern already used by
// WhatsAppButton.astro), and (2) POSTs the order straight to Supabase's
// REST API (same fetch-with-apikey-header pattern as
// ReservationContent.astro) so it shows up live on the in-restaurant staff
// screen. Supabase is a genuine dependency here — WITHOUT
// siteConfig.ordering.supabaseUrl/supabaseAnonKey set to a real project,
// the WhatsApp message still sends fine, but nothing appears on the staff
// screen. See SUPABASE_SETUP.md.
import { siteConfig } from '../../config/site.config';
import { t, type Language } from '../../i18n/languages';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const copy = {
  cartTitle: { fr: 'Votre commande', en: 'Your order', ar: 'طلبك' },
  empty: { fr: 'Votre panier est vide.', en: 'Your cart is empty.', ar: 'سلتك فارغة.' },
  emptyCta: { fr: 'Voir le menu', en: 'View the menu', ar: 'شاهد القائمة' },
  subtotal: { fr: 'Sous-total', en: 'Subtotal', ar: 'المجموع الفرعي' },
  continue: { fr: 'Passer la commande', en: 'Checkout', ar: 'إتمام الطلب' },
  back: { fr: 'Retour au panier', en: 'Back to cart', ar: 'العودة إلى السلة' },
  coordinatesSection: { fr: 'Vos coordonnées', en: 'Your details', ar: 'بياناتك' },
  name: { fr: 'Nom complet', en: 'Full name', ar: 'الاسم الكامل' },
  namePlaceholder: { fr: 'Ex : Fatima Zahra', en: 'E.g. Fatima Zahra', ar: 'مثال: فاطمة الزهراء' },
  phone: { fr: 'Téléphone / WhatsApp', en: 'Phone / WhatsApp', ar: 'الهاتف / واتساب' },
  phonePlaceholder: { fr: 'Ex : +212 6 00 00 00 00', en: 'E.g. +212 6 00 00 00 00', ar: 'مثال: 00 00 00 00 6 212+' },
  mode: { fr: 'Mode de commande', en: 'Order type', ar: 'طريقة الطلب' },
  modeDineIn: { fr: 'Sur place', en: 'Dine-in', ar: 'في المكان' },
  modeTakeaway: { fr: 'À emporter', en: 'Takeaway', ar: 'سفري' },
  modeDelivery: { fr: 'Livraison', en: 'Delivery', ar: 'توصيل' },
  table: { fr: 'Numéro de table', en: 'Table number', ar: 'رقم الطاولة' },
  tablePlaceholder: { fr: 'Ex : 12', en: 'E.g. 12', ar: 'مثال: 12' },
  address: { fr: 'Adresse de livraison', en: 'Delivery address', ar: 'عنوان التوصيل' },
  addressPlaceholder: {
    fr: `Ex : Appt 5, Immeuble B, ${siteConfig.identity.city}`,
    en: `E.g. Apt 5, Building B, ${siteConfig.identity.city}`,
    ar: `مثال: شقة 5، عمارة ب، ${siteConfig.identity.city}`,
  },
  addressHint: {
    fr: 'Pour une localisation plus précise, vous pouvez aussi partager votre position en direct via l’icône 📎 dans WhatsApp après l’envoi de la commande.',
    en: 'For a more precise location, you can also share your live position via the 📎 icon in WhatsApp after sending the order.',
    ar: 'لمزيد من الدقة، يمكنك أيضًا مشاركة موقعك المباشر عبر أيقونة 📎 في واتساب بعد إرسال الطلب.',
  },
  notes: { fr: 'Remarques & allergies (optionnel)', en: 'Notes & allergies (optional)', ar: 'ملاحظات وحساسية (اختياري)' },
  notesPlaceholder: {
    fr: 'Ex : Moins épicé, sans oignons, sauce à part...',
    en: 'E.g. Less spicy, no onions, sauce on the side...',
    ar: 'مثال: أقل حرارة، بدون بصل، الصلصة جانبًا...',
  },
  submit: { fr: 'Envoyer via WhatsApp', en: 'Send via WhatsApp', ar: 'إرسال عبر واتساب' },
  submitting: { fr: 'Envoi...', en: 'Sending...', ar: 'جارٍ الإرسال...' },
  fieldRequired: { fr: 'Ce champ est requis.', en: 'This field is required.', ar: 'هذا الحقل مطلوب.' },
  successTitle: { fr: 'Commande reçue en cuisine !', en: 'Order received in the kitchen!', ar: 'تم استلام الطلب في المطبخ!' },
  successBody: {
    fr: 'Il reste une étape : confirmez votre commande dans la conversation WhatsApp qui vient de s’ouvrir en appuyant sur Envoyer.',
    en: 'One step left: confirm your order in the WhatsApp chat that just opened by tapping Send.',
    ar: 'خطوة أخيرة: أكّد طلبك في محادثة واتساب التي فُتحت للتو بالضغط على إرسال.',
  },
  successResend: {
    fr: 'Le message WhatsApp ne s’est pas ouvert, ou vous l’avez fermé ? Rouvrez-le :',
    en: 'The WhatsApp message didn’t open, or you closed it? Reopen it:',
    ar: 'لم تُفتح رسالة واتساب، أو أغلقتها؟ أعد فتحها:',
  },
  successResendBtn: { fr: 'Rouvrir WhatsApp', en: 'Reopen WhatsApp', ar: 'إعادة فتح واتساب' },
  successAnother: { fr: 'Nouvelle commande', en: 'New order', ar: 'طلب جديد' },
  close: { fr: 'Fermer', en: 'Close', ar: 'إغلاق' },
  remove: { fr: 'Retirer', en: 'Remove', ar: 'إزالة' },
  clearCart: { fr: 'Vider le panier', en: 'Clear cart', ar: 'إفراغ السلة' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const { supabaseUrl, supabaseAnonKey } = siteConfig.ordering;
const whatsappNumber = siteConfig.contact.whatsappNumber;
const { currency, name: restaurantName } = siteConfig.identity;
---
<div id="cart-root" data-lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <!-- Floating trigger — sits above WhatsAppButton.astro's FAB, same side,
       badge only shows once the cart has at least one line. -->
  <button id="cart-fab" type="button" aria-label={t(copy.cartTitle, lang)} class="cart-fab fab-defer">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="18" cy="21" r="1.4" fill="currentColor" stroke="none" />
      <path d="M2.5 3h2.4l2.2 11.6a2 2 0 002 1.6h8.6a2 2 0 002-1.6L20.5 7H6" />
    </svg>
    <span id="cart-fab-badge" class="cart-fab-badge hidden">0</span>
  </button>

  <!-- Sticky bottom order bar (Amar, Sept 2026 — reference: Indian
       Flavors' own order bar, same idea, this site's own colors/shape):
       pinned to the bottom of the viewport whenever the cart has at least
       one line, so the order is always in view while browsing the menu —
       no need to open anything to see it's there. Replaces an earlier
       attempt that auto-opened the full drawer on every add-to-cart,
       which was too disruptive. Hidden by default via .is-visible,
       toggled in renderLines() below. The FAB above still exists for
       reaching the cart from anywhere (e.g. a page without this bar), but
       hides itself while this bar is showing so the two don't stack. -->
  <div id="cart-bar" class="cart-bar" aria-hidden="true">
    <button id="cart-bar-clear" type="button" class="cart-bar-icon-btn" aria-label={t(copy.clearCart, lang)}>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 7h16 M9 7V4.6a1 1 0 011-1h4a1 1 0 011 1V7 M6.5 7l1 12.4a2 2 0 002 1.6h5a2 2 0 002-1.6L17.5 7" />
      </svg>
    </button>
    <button id="cart-bar-open" type="button" class="cart-bar-icon-btn" aria-label={t(copy.cartTitle, lang)}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="18" cy="21" r="1.4" fill="currentColor" stroke="none" />
        <path d="M2.5 3h2.4l2.2 11.6a2 2 0 002 1.6h8.6a2 2 0 002-1.6L20.5 7H6" />
      </svg>
      <span id="cart-bar-badge" class="cart-bar-badge">0</span>
    </button>
    <button id="cart-bar-checkout" type="button" class="cart-bar-checkout">
      <span class="cart-bar-checkout-text">
        <span>{t(copy.continue, lang)}</span>
        <span id="cart-bar-total" class="cart-bar-checkout-total">0 {currency}</span>
      </span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </button>
  </div>

  <!-- Overlay + drawer — hidden by default, toggled via .is-open (no
       framework, plain class toggles + a couple of CSS transitions). -->
  <div id="cart-overlay" class="cart-overlay" aria-hidden="true">
    <div id="cart-panel" class="cart-panel" role="dialog" aria-modal="true" aria-label={t(copy.cartTitle, lang)}>
      <div class="cart-panel-header">
        <div class="cart-panel-heading">
          <span class="cart-avatar" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.6" />
              <path d="M4.5 19.5c1.7-4.1 4.3-6 7.5-6s5.8 1.9 7.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </span>
          <div>
            <h2 class="font-display text-lg font-semibold" style="color: var(--color-text-primary)">{t(copy.cartTitle, lang)}</h2>
            <p id="cart-items-count" class="cart-items-count"></p>
          </div>
        </div>
        <button id="cart-close" type="button" class="cart-icon-btn" aria-label={t(copy.close, lang)}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>

      <div class="cart-steps" aria-hidden="true">
        <span class="cart-step-dot is-active" data-step="lines"></span>
        <span class="cart-step-line"></span>
        <span class="cart-step-dot" data-step="checkout"></span>
        <span class="cart-step-line"></span>
        <span class="cart-step-dot" data-step="success"></span>
      </div>

      <!-- Step 1: line items -->
      <div id="cart-step-lines" class="cart-step">
        <div id="cart-lines" class="cart-lines"></div>
        <div id="cart-empty" class="cart-empty hidden">
          <p style="color: var(--color-text-muted)">{t(copy.empty, lang)}</p>
          <a href={`/${lang === 'fr' ? '' : lang + '/'}menu`} class="cart-btn cart-btn-outline mt-3">{t(copy.emptyCta, lang)}</a>
        </div>
        <div id="cart-summary" class="cart-summary">
          <div class="cart-subtotal-row">
            <span style="color: var(--color-text-muted)">{t(copy.subtotal, lang)}</span>
            <span id="cart-subtotal" class="font-bold" style="color: var(--color-accent)">0 {currency}</span>
          </div>
          <button id="cart-to-checkout" type="button" class="cart-btn cart-btn-filled w-full mt-3">{t(copy.continue, lang)}</button>
        </div>
      </div>

      <!-- Step 2: checkout form -->
      <div id="cart-step-checkout" class="cart-step hidden">
        <button id="cart-back-to-lines" type="button" class="cart-back-link">← {t(copy.back, lang)}</button>
        <p class="cart-section-label mt-3">{t(copy.coordinatesSection, lang)}</p>
        <form id="cart-checkout-form" novalidate>
          <div class="cart-field">
            <label class="cart-label">{t(copy.mode, lang)}</label>
            <div class="cart-segmented cart-segmented-modes" id="co-mode-segmented" role="tablist">
              <button type="button" class="cart-segment" data-mode="delivery" role="tab" aria-selected="false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7h11v8H3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M14 10h3.5L20 13v2h-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="7" cy="17.5" r="1.6" stroke="currentColor" stroke-width="1.5" /><circle cx="16.5" cy="17.5" r="1.6" stroke="currentColor" stroke-width="1.5" /></svg>
                <span>{t(copy.modeDelivery, lang)}</span>
              </button>
              <button type="button" class="cart-segment" data-mode="takeaway" role="tab" aria-selected="false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 9h14l-1.2 10.2a2 2 0 01-2 1.8H8.2a2 2 0 01-2-1.8L5 9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M8.5 9V7a3.5 3.5 0 017 0v2" stroke="currentColor" stroke-width="1.5" /></svg>
                <span>{t(copy.modeTakeaway, lang)}</span>
              </button>
              <button type="button" class="cart-segment is-active" data-mode="dinein" role="tab" aria-selected="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 3v8M4 3v5a2 2 0 002 2 2 2 0 002-2V3M8 11v10M18 3c-1.7 0-3 2-3 5.5S16.3 13 18 13m0-10v18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>{t(copy.modeDineIn, lang)}</span>
              </button>
            </div>
            <input type="hidden" id="co-mode" name="mode" value="dinein" />
          </div>
          <div class="cart-field">
            <label class="cart-label" for="co-name">{t(copy.name, lang)}</label>
            <div class="cart-input-wrap">
              <svg class="cart-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.6" />
                <path d="M4.5 19.5c1.7-4.1 4.3-6 7.5-6s5.8 1.9 7.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
              <input class="cart-input" type="text" id="co-name" name="name" autocomplete="name" placeholder={t(copy.namePlaceholder, lang)} required />
            </div>
          </div>
          <div class="cart-field cart-collapse" id="co-phone-field">
            <label class="cart-label" for="co-phone">{t(copy.phone, lang)}</label>
            <div class="cart-input-wrap">
              <svg class="cart-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7.5 4h2.3l1.1 3.4-1.7 1.4a9.5 9.5 0 004.6 4.6l1.4-1.7 3.4 1.1v2.3a1.5 1.5 0 01-1.6 1.5A12.5 12.5 0 016 6.1 1.5 1.5 0 017.5 4z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <input class="cart-input" type="tel" id="co-phone" name="phone" autocomplete="tel" placeholder={t(copy.phonePlaceholder, lang)} />
            </div>
          </div>
          <div class="cart-field cart-collapse is-open" id="co-table-field">
            <label class="cart-label" for="co-table">{t(copy.table, lang)}</label>
            <input class="cart-input" type="text" id="co-table" name="table" placeholder={t(copy.tablePlaceholder, lang)} />
          </div>
          <div class="cart-field cart-collapse" id="co-address-field">
            <label class="cart-label" for="co-address">{t(copy.address, lang)}</label>
            <div class="cart-input-wrap">
              <svg class="cart-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 21s7-6.1 7-11a7 7 0 10-14 0c0 4.9 7 11 7 11z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <circle cx="12" cy="10" r="2.3" stroke="currentColor" stroke-width="1.5" />
              </svg>
              <input class="cart-input" type="text" id="co-address" name="address" placeholder={t(copy.addressPlaceholder, lang)} />
            </div>
            <p class="cart-field-hint">📎 {t(copy.addressHint, lang)}</p>
          </div>
          <div class="cart-field">
            <label class="cart-label" for="co-notes">{t(copy.notes, lang)}</label>
            <div class="cart-input-wrap">
              <svg class="cart-field-icon cart-field-icon-top" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 4h11l3 3v13H5V4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M8 10h8M8 14h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
              <textarea class="cart-input" id="co-notes" name="notes" rows="2" placeholder={t(copy.notesPlaceholder, lang)}></textarea>
            </div>
          </div>
          <button id="cart-submit" type="submit" class="cart-btn cart-btn-filled w-full mt-4">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 21l1.4-4.2A8 8 0 1110 19.6L3 21z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M8 10c0 3 3 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <span id="cart-submit-label">{t(copy.submit, lang)}</span>
          </button>
          <div id="cart-status" class="mt-3" aria-live="polite"></div>
        </form>
      </div>

      <!-- Step 3: confirmation — order is already live on the staff screen
           via Supabase at this point (reliable), but the WhatsApp message
           itself can only be sent by the customer tapping Send in their own
           WhatsApp app — nothing on this page can detect or force that, so
           this step's whole job is to make that step impossible to miss and
           trivial to redo if it got closed/blocked. See the standing note
           on `waUrl`/`lastWaUrl` further down in the script. -->
      <div id="cart-step-success" class="cart-step hidden text-center py-8">
        <p class="font-display text-xl font-semibold" style="color: var(--color-text-primary)">{t(copy.successTitle, lang)}</p>
        <div class="cart-success-callout mt-4">
          <p class="text-sm" style="color: var(--color-text-primary)">{t(copy.successBody, lang)}</p>
          <p class="text-xs mt-3" style="color: var(--color-text-muted)">{t(copy.successResend, lang)}</p>
          <button id="cart-resend-wa" type="button" class="cart-btn cart-btn-filled w-full mt-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 21l1.4-4.2A8 8 0 1110 19.6L3 21z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M8 10c0 3 3 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            {t(copy.successResendBtn, lang)}
          </button>
        </div>
        <button id="cart-reset" type="button" class="cart-btn cart-btn-outline mt-4">{t(copy.successAnother, lang)}</button>
      </div>
    </div>
  </div>
</div>

<style>
  .cart-fab {
    position: fixed;
    bottom: 84px;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-background);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    right: 18px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  [dir='rtl'] .cart-fab {
    right: auto;
    left: 18px;
  }
  .cart-fab:hover {
    transform: scale(1.08);
  }
  @media (min-width: 640px) {
    .cart-fab {
      bottom: 96px;
      width: 58px;
      height: 58px;
      right: 28px;
    }
    [dir='rtl'] .cart-fab {
      right: auto;
      left: 28px;
    }
  }
  /* .hidden (Tailwind's shared `display:none` utility) and this scoped
     rule both have single-class specificity — whichever loads later in
     the cascade wins, and that's load-order dependent, not something to
     rely on. Same class of bug as the site-wide color override earlier in
     this project: give the hidden state its own higher-specificity rule
     below so it always wins regardless of stylesheet order. */
  .cart-fab-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background-color: var(--color-background);
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
    font-size: 0.65rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cart-fab-badge.hidden {
    display: none;
  }
  .cart-fab.is-hidden-by-bar {
    display: none;
  }

  /* Sticky bottom order bar — a fixed, full-width strip instead of the
     round FAB once there's something to show, so the order is visible at
     a glance without opening anything. env(safe-area-inset-bottom) keeps
     it clear of a phone's home-swipe gesture bar. */
  .cart-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .cart-bar.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .cart-bar-icon-btn {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    background-color: var(--color-surface-muted);
    color: var(--color-text-primary);
  }
  .cart-bar-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 999px;
