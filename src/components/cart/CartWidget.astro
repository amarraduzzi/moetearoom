<!-- Two script tags on purpose: `define:vars` forces Astro to keep that
     block as a raw, unbundled inline script (it can't run it through
     Vite — that's how define:vars injects the serialized values before
     execution). A dynamic import() inside a define:vars block therefore
     never gets resolved/bundled and 404s in the production build. So the
     values are handed off through a tiny define:vars block, and the actual
     logic — including the dynamic import of cart.ts — lives in a second,
     plain <script> with no define:vars, which Astro DOES bundle normally. -->
<script define:vars={{ supabaseUrl, supabaseAnonKey, whatsappNumber, currency, restaurantName, lang }}>
  window.__moeCartConfig = { supabaseUrl, supabaseAnonKey, whatsappNumber, currency, restaurantName, lang };
</script>
<script>
  const { supabaseUrl, supabaseAnonKey, whatsappNumber, currency, restaurantName, lang } = window.__moeCartConfig;

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('cart-root');
    if (!root || root.dataset.wired === 'true') return;
    root.dataset.wired = 'true';

    // Dynamic import keeps this a normal ES module dependency (bundled by
    // Vite) instead of duplicating the cart logic inline in every page.
    import('/src/lib/cart.ts').then((cart) => wire(cart));

    function wire(cart) {
      const fab = document.getElementById('cart-fab');
      const badge = document.getElementById('cart-fab-badge');
      const bar = document.getElementById('cart-bar');
      const barBadge = document.getElementById('cart-bar-badge');
      const barTotal = document.getElementById('cart-bar-total');
      const barClearBtn = document.getElementById('cart-bar-clear');
      const barOpenBtn = document.getElementById('cart-bar-open');
      const barCheckoutBtn = document.getElementById('cart-bar-checkout');
      const overlay = document.getElementById('cart-overlay');
      const closeBtn = document.getElementById('cart-close');
      const linesEl = document.getElementById('cart-lines');
      const emptyEl = document.getElementById('cart-empty');
      const summaryEl = document.getElementById('cart-summary');
      const subtotalEl = document.getElementById('cart-subtotal');
      const stepLines = document.getElementById('cart-step-lines');
      const stepCheckout = document.getElementById('cart-step-checkout');
      const stepSuccess = document.getElementById('cart-step-success');
      const toCheckoutBtn = document.getElementById('cart-to-checkout');
      const backBtn = document.getElementById('cart-back-to-lines');
      const form = document.getElementById('cart-checkout-form');
      const modeSegmented = document.getElementById('co-mode-segmented');
      const modeInput = document.getElementById('co-mode');
      const phoneField = document.getElementById('co-phone-field');
      const tableField = document.getElementById('co-table-field');
      const addressField = document.getElementById('co-address-field');
      const submitBtn = document.getElementById('cart-submit');
      const submitLabel = document.getElementById('cart-submit-label');
      const statusEl = document.getElementById('cart-status');
      const resetBtn = document.getElementById('cart-reset');
      const resendWaBtn = document.getElementById('cart-resend-wa');
      const itemsCountEl = document.getElementById('cart-items-count');

      // Set right before window.open() in the submit handler below, reused
      // by the "Reopen WhatsApp" button on the success step — see the note
      // on that step in the markup above for why this exists at all.
      let lastWaUrl = null;

      const LABELS = {
        remove: { fr: 'Retirer', en: 'Remove', ar: 'إزالة' },
        required: { fr: 'Ce champ est requis.', en: 'This field is required.', ar: 'هذا الحقل مطلوب.' },
        submit: { fr: 'Envoyer via WhatsApp', en: 'Send via WhatsApp', ar: 'إرسال عبر واتساب' },
        submitting: { fr: 'Envoi...', en: 'Sending...', ar: 'جارٍ الإرسال...' },
        errorTitle: {
          fr: 'La commande a été ouverte dans WhatsApp, mais n’a pas pu être envoyée au restaurant automatiquement.',
          en: 'The order opened in WhatsApp, but could not be sent to the restaurant automatically.',
          ar: 'تم فتح الطلب في واتساب، لكن تعذر إرساله تلقائيًا إلى المطعم.',
        },
      };
      const L = (key) => LABELS[key][lang] ?? LABELS[key].fr;
      const ITEMS_COUNT_LABEL = (n) =>
        ({
          fr: `${n} article${n > 1 ? 's' : ''} sélectionné${n > 1 ? 's' : ''}`,
          en: `${n} item${n > 1 ? 's' : ''} selected`,
          ar: `${n} صنف مختار`,
        }[lang] ?? `${n}`);

      function renderLines() {
        const lines = cart.getCart();
        linesEl.innerHTML = '';
        const hasLines = lines.length > 0;
        emptyEl.classList.toggle('hidden', hasLines);
        summaryEl.classList.toggle('hidden', !hasLines);

        lines.forEach((line) => {
          const row = document.createElement('div');
          row.className = 'cart-line';
          row.innerHTML = `
            <div class="cart-line-info">
              <p class="cart-line-name">${escapeHtml(line.name)}</p>
              <p class="cart-line-price">${line.price} ${currency}</p>
            </div>
            <div class="cart-qty">
              <button type="button" class="cart-qty-btn" data-action="dec" data-id="${line.id}">−</button>
              <span style="min-width:1.2rem;text-align:center;color:var(--color-text-primary)">${line.quantity}</span>
              <button type="button" class="cart-qty-btn" data-action="inc" data-id="${line.id}">+</button>
            </div>
          `;
          linesEl.appendChild(row);
        });

        const total = cart.getCartTotal(lines);
        subtotalEl.textContent = `${total} ${currency}`;

        const count = cart.getCartCount(lines);
        badge.textContent = String(count);
        badge.classList.toggle('hidden', count === 0);
        itemsCountEl.textContent = ITEMS_COUNT_LABEL(count);

        // Sticky bottom order bar — see its markup comment above. Mirrors
        // the same count/total as the FAB badge and the drawer's subtotal;
        // the FAB itself hides while this bar is visible so they never
        // show side by side.
        barBadge.textContent = String(count);
        barTotal.textContent = `${total} ${currency}`;
        bar.classList.toggle('is-visible', hasLines);
        bar.setAttribute('aria-hidden', String(!hasLines));
        fab.classList.toggle('is-hidden-by-bar', hasLines);
      }

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      linesEl.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        const lines = cart.getCart();
        const line = lines.find((l) => l.id === id);
        if (!line) return;
        const delta = btn.getAttribute('data-action') === 'inc' ? 1 : -1;
        cart.updateQuantity(id, line.quantity + delta);
      });

      cart.onCartUpdated(renderLines);
      renderLines();

      function openDrawer() {
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      const STEP_KEY = {
        'cart-step-lines': 'lines',
        'cart-step-checkout': 'checkout',
        'cart-step-success': 'success',
      };
      const STEP_ORDER = ['lines', 'checkout', 'success'];
      function showStep(step) {
        [stepLines, stepCheckout, stepSuccess].forEach((el) => el.classList.add('hidden'));
        step.classList.remove('hidden');
        const key = STEP_KEY[step.id];
        const idx = STEP_ORDER.indexOf(key);
        document.querySelectorAll('.cart-step-dot').forEach((dot) => {
          const dotIdx = STEP_ORDER.indexOf(dot.dataset.step);
          dot.classList.toggle('is-active', dot.dataset.step === key);
          dot.classList.toggle('is-done', dotIdx < idx);
        });
      }

      fab.addEventListener('click', () => {
        showStep(stepLines);
        openDrawer();
      });

      barOpenBtn.addEventListener('click', () => {
        showStep(stepLines);
        openDrawer();
      });
      barCheckoutBtn.addEventListener('click', () => {
        showStep(stepLines);
        openDrawer();
      });
      barClearBtn.addEventListener('click', () => {
        cart.clearCart();
      });

      closeBtn.addEventListener('click', closeDrawer);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeDrawer();
      });

      // "Commander" buttons sitewide (Button.astro with cartTrigger) —
      // delegated on document since they exist on every page, not just
      // wherever this widget's own markup lives.
      //
      // Registered on the CAPTURE phase, not bubble: Astro's <ViewTransitions />
      // (Layout.astro) also delegates a click listener on document to intercept
      // `<a>` clicks for SPA-style page swaps, registered on the bubble phase.
      // With both on bubble, Astro's own handler ran first and had already
      // kicked off its navigate-to-/menu before this handler's preventDefault
      // landed — that's the bug the client saw (cart flashes open, then the
      // page still navigates to /menu). Capture fires before any bubble
      // listener, so stopPropagation() here stops the click from ever
      // reaching Astro's router at all.
      document.addEventListener(
        'click',
        (e) => {
          const trigger = e.target.closest('[data-cart-trigger]');
          if (!trigger) return;
          e.preventDefault();
          e.stopPropagation();
          showStep(stepLines);
          openDrawer();
        },
        true
      );

      toCheckoutBtn.addEventListener('click', () => {
        if (cart.getCart().length === 0) return;
        showStep(stepCheckout);
      });
      backBtn.addEventListener('click', () => showStep(stepLines));
      resetBtn.addEventListener('click', () => {
        cart.clearCart();
        form.reset();
        showStep(stepLines);
      });
      resendWaBtn.addEventListener('click', () => {
        // Same URL the submit handler opened the first time — reopening it
        // is the whole fix: it's a fresh user click (not a JS-triggered
        // popup), so it's never blocked, and it re-prefills the exact same
        // order message whether the customer's first tab got closed, the
        // popup was blocked, or they just want to send it again.
        if (lastWaUrl) window.open(lastWaUrl, '_blank', 'noopener');
      });

      // Which contact fields a mode actually needs: dine-in staff can just
      // walk to the table, so phone isn't required there (it still shows
      // for takeaway/delivery, where a callback number matters — e.g. if
      // the customer's own WhatsApp message never gets sent, see the
      // success-step "Reopen WhatsApp" note above, staff still has a
      // number to reach them on for takeaway/delivery specifically).
      function applyMode(mode) {
        modeInput.value = mode;
        modeSegmented.querySelectorAll('.cart-segment').forEach((b) => {
          const active = b.dataset.mode === mode;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', String(active));
        });
        phoneField.classList.toggle('is-open', mode !== 'dinein');
        tableField.classList.toggle('is-open', mode === 'dinein');
        addressField.classList.toggle('is-open', mode === 'delivery');
        if (mode === 'dinein') {
          document.getElementById('co-phone').classList.remove('cart-invalid');
        }
      }
      modeSegmented.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-mode]');
        if (!btn) return;
        applyMode(btn.dataset.mode);
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        statusEl.innerHTML = '';

        const nameInput = document.getElementById('co-name');
        const phoneInput = document.getElementById('co-phone');
        const tableInput = document.getElementById('co-table');
        const addressInput = document.getElementById('co-address');
        const notesInput = document.getElementById('co-notes');

        const mode = modeInput.value;
        // Phone is only required for takeaway/delivery — for dine-in the
        // customer is physically at the table, so staff never need to call
        // them back (see applyMode() above for the full reasoning).
        const required = mode === 'dinein' ? [nameInput] : [nameInput, phoneInput];
        let firstInvalid = null;
        for (const el of required) {
          const empty = !el.value || el.value.trim() === '';
          el.classList.toggle('cart-invalid', empty);
          if (empty && !firstInvalid) firstInvalid = el;
        }
        if (firstInvalid) {
          firstInvalid.focus();
          return;
        }

        const lines = cart.getCart();
        if (lines.length === 0) return;
        const addressOrTable = mode === 'delivery' ? addressInput.value.trim() : tableInput.value.trim();
        const total = cart.getCartTotal(lines);
        const orderRef = Math.random().toString(36).slice(2, 8).toUpperCase();

        const MODE_LABEL = {
          dinein: { fr: 'Sur place', en: 'Dine-in', ar: 'في المكان' },
          takeaway: { fr: 'À emporter', en: 'Takeaway', ar: 'سفري' },
          delivery: { fr: 'Livraison', en: 'Delivery', ar: 'توصيل' },
        };
        const modeLabel = MODE_LABEL[mode][lang] ?? MODE_LABEL[mode].fr;

        // Build the WhatsApp message synchronously and open the chat in
        // the SAME click-event tick as the submit, before any `await` —
        // opening a new tab after an awaited fetch is what popup blockers
        // catch. The Supabase insert below fires right after, unawaited by
        // the tab-open itself.
        const msgLines = [];
        msgLines.push(`*NOUVELLE COMMANDE — ${restaurantName.toUpperCase()}*`);
        msgLines.push(`*Réf:* ${orderRef}`);
        msgLines.push('---------------------------------------');
        msgLines.push(`*Client:* ${nameInput.value.trim()}`);
        msgLines.push(`*Mode:* ${modeLabel}${addressOrTable ? ` (${addressOrTable})` : ''}`);
        if (phoneInput.value.trim()) msgLines.push(`*Tél:* ${phoneInput.value.trim()}`);
        msgLines.push('---------------------------------------');
        msgLines.push('*DÉTAIL DE LA COMMANDE:*');
        // Grouped by prep station (☕ Bar / 🍽 Cuisine) so whoever reads this
        // WhatsApp message — same as the staff screen's order cards — can
        // route each part without re-reading the whole list. `line.station`
        // is set at add-to-cart time (see cart.ts / MenuContent.astro's
        // data-station), defaulting to cuisine for any older cart line that
        // predates this field.
        const barLines = lines.filter((l) => l.station === 'bar');
        const cuisineLines = lines.filter((l) => l.station !== 'bar');
        const pushGroup = (label, group) => {
          if (!group.length) return;
          msgLines.push('');
          msgLines.push(`_${label}_`);
          group.forEach((line) => {
            msgLines.push(`${line.quantity}x ${line.name} — ${line.price * line.quantity} ${currency}`);
          });
        };
        pushGroup('☕ BAR', barLines);
        pushGroup('🍽 CUISINE', cuisineLines);
        msgLines.push('---------------------------------------');
        if (notesInput.value.trim()) msgLines.push(`*Note:* ${notesInput.value.trim()}`);
        msgLines.push(`*TOTAL À PAYER:* *${total} ${currency}*`);

        const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msgLines.join('\n'))}`;
        lastWaUrl = waUrl;
        window.open(waUrl, '_blank', 'noopener');

        // Fire-and-forget insert into Supabase so the order shows up live
        // on the in-restaurant staff screen. Not awaited before opening
        // WhatsApp above — a slow/failed insert must never block or break
        // the WhatsApp send, which is the one path that always works.
        if (supabaseUrl && supabaseAnonKey) {
          submitBtn.disabled = true;
          submitLabel.textContent = L('submitting');
          fetch(`${supabaseUrl}/rest/v1/orders`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: supabaseAnonKey,
              Authorization: `Bearer ${supabaseAnonKey}`,
              Prefer: 'return=minimal',
            },
            body: JSON.stringify({
              order_ref: orderRef,
              customer_name: nameInput.value.trim(),
              customer_phone: phoneInput.value.trim() || null,
              order_type: mode,
              address_or_table: addressOrTable || null,
              items: lines.map((l) => ({ name: l.name, quantity: l.quantity, price: l.price, station: l.station === 'bar' ? 'bar' : 'cuisine' })),
              total,
              notes: notesInput.value.trim() || null,
              status: 'pending',
            }),
          })
            .catch((err) => {
              console.error('[cart] Supabase insert failed', err);
              statusEl.innerHTML = `<div class="cart-status-error">${L('errorTitle')}</div>`;
            })
            .finally(() => {
              submitBtn.disabled = false;
              submitLabel.textContent = L('submit');
            });
        } else {
          console.warn('[cart] siteConfig.ordering.supabaseUrl/supabaseAnonKey not set — order will not appear on the staff screen.');
        }

        cart.clearCart();
        form.reset();
        showStep(stepSuccess);
      });
    }
  });
</script>
