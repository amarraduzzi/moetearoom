---
// Site-wide cart + checkout widget, rendered once in Layout.astro (same
// pattern as WhatsAppButton.astro) so it's available on every page. Static
// HTML for the closed state (floating button); everything else — opening
// the drawer, adding/removing lines, the checkout form — is vanilla JS
// against src/lib/cart.ts's localStorage-backed cart. No framework: this
// site ships zero client-side JS runtime by design (astro.config.mjs,
// `output: 'static'`), so a full cart/checkout UI still has to be plain
// TypeScript + DOM, not React/Vue state.
//
// On submit this does two things, fired together, neither waiting on the
// other: (1) opens a pre-filled WhatsApp chat with the order (same "the
// order lives in the WhatsApp message" pattern already used by
// WhatsAppButton.astro), and (2) POSTs the order straight to Supabase's
// REST API (same fetch-with-apikey-header pattern as
// ReservationContent.astro) so it shows up live on the in-restaurant staff
// screen. Supabase is a genuine dependency here — WITHOUT
// siteConfig.ordering.supabaseUrl/supabaseAnonKey set to a real project,
// the WhatsApp message still sends fine, but nothing appears on the staff
// screen. See SUPABASE_SETUP.md.
import { siteConfig } from '../../config/site.config';
import { t, type Language } from '../../i18n/languages';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const copy = {
  cartTitle: { fr: 'Votre commande', en: 'Your order', ar: 'طلبك' },
  empty: { fr: 'Votre panier est vide.', en: 'Your cart is empty.', ar: 'سلتك فارغة.' },
  emptyCta: { fr: 'Voir le menu', en: 'View the menu', ar: 'شاهد القائمة' },
  subtotal: { fr: 'Sous-total', en: 'Subtotal', ar: 'المجموع الفرعي' },
  continue: { fr: 'Passer la commande', en: 'Checkout', ar: 'إتمام الطلب' },
  back: { fr: 'Retour au panier', en: 'Back to cart', ar: 'العودة إلى السلة' },
  name: { fr: 'Nom complet', en: 'Full name', ar: 'الاسم الكامل' },
  phone: { fr: 'Téléphone (WhatsApp de préférence)', en: 'Phone (WhatsApp preferred)', ar: 'الهاتف (يفضل واتساب)' },
  mode: { fr: 'Mode', en: 'Mode', ar: 'طريقة الطلب' },
  modeDineIn: { fr: 'Sur place', en: 'Dine-in', ar: 'في المكان' },
  modeTakeaway: { fr: 'À emporter', en: 'Takeaway', ar: 'سفري' },
  modeDelivery: { fr: 'Livraison', en: 'Delivery', ar: 'توصيل' },
  table: { fr: 'Numéro de table', en: 'Table number', ar: 'رقم الطاولة' },
  address: { fr: 'Adresse de livraison', en: 'Delivery address', ar: 'عنوان التوصيل' },
  notes: { fr: 'Remarque (optionnel)', en: 'Note (optional)', ar: 'ملاحظة (اختياري)' },
  submit: { fr: 'Envoyer via WhatsApp', en: 'Send via WhatsApp', ar: 'إرسال عبر واتساب' },
  submitting: { fr: 'Envoi...', en: 'Sending...', ar: 'جارٍ الإرسال...' },
  fieldRequired: { fr: 'Ce champ est requis.', en: 'This field is required.', ar: 'هذا الحقل مطلوب.' },
  successTitle: { fr: 'Commande envoyée !', en: 'Order sent!', ar: 'تم إرسال الطلب!' },
  successBody: {
    fr: 'Confirmez votre commande dans la conversation WhatsApp qui vient de s’ouvrir.',
    en: 'Confirm your order in the WhatsApp chat that just opened.',
    ar: 'أكّد طلبك في محادثة واتساب التي فُتحت للتو.',
  },
  successAnother: { fr: 'Nouvelle commande', en: 'New order', ar: 'طلب جديد' },
  close: { fr: 'Fermer', en: 'Close', ar: 'إغلاق' },
  remove: { fr: 'Retirer', en: 'Remove', ar: 'إزالة' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const { supabaseUrl, supabaseAnonKey } = siteConfig.ordering;
const whatsappNumber = siteConfig.contact.whatsappNumber;
const { currency, name: restaurantName } = siteConfig.identity;
---
<div id="cart-root" data-lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <!-- Floating trigger — sits above WhatsAppButton.astro's FAB, same side,
       badge only shows once the cart has at least one line. -->
  <button id="cart-fab" type="button" aria-label={t(copy.cartTitle, lang)} class="cart-fab fab-defer">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="18" cy="21" r="1.4" fill="currentColor" stroke="none" />
      <path d="M2.5 3h2.4l2.2 11.6a2 2 0 002 1.6h8.6a2 2 0 002-1.6L20.5 7H6" />
    </svg>
    <span id="cart-fab-badge" class="cart-fab-badge hidden">0</span>
  </button>

  <!-- Overlay + drawer — hidden by default, toggled via .is-open (no
       framework, plain class toggles + a couple of CSS transitions). -->
  <div id="cart-overlay" class="cart-overlay" aria-hidden="true">
    <div id="cart-panel" class="cart-panel" role="dialog" aria-modal="true" aria-label={t(copy.cartTitle, lang)}>
      <div class="cart-panel-header">
        <div class="cart-panel-brand">
          <img src="/images/logo-mark.webp" alt="" aria-hidden="true" class="cart-panel-logo" />
          <h2 class="font-display text-lg font-semibold" style="color: var(--color-text-primary)">{t(copy.cartTitle, lang)}</h2>
        </div>
        <button id="cart-close" type="button" class="cart-icon-btn" aria-label={t(copy.close, lang)}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>

      <!-- Step 1: line items -->
      <div id="cart-step-lines" class="cart-step">
        <div id="cart-lines" class="cart-lines"></div>
        <div id="cart-empty" class="cart-empty hidden">
          <p style="color: var(--color-text-muted)">{t(copy.empty, lang)}</p>
          <a href={`/${lang === 'fr' ? '' : lang + '/'}menu`} class="cart-btn cart-btn-outline mt-3">{t(copy.emptyCta, lang)}</a>
        </div>
        <div id="cart-summary" class="cart-summary">
          <div class="cart-subtotal-row">
            <span style="color: var(--color-text-muted)">{t(copy.subtotal, lang)}</span>
            <span id="cart-subtotal" class="font-bold" style="color: var(--color-accent)">0 {currency}</span>
          </div>
          <button id="cart-to-checkout" type="button" class="cart-btn cart-btn-filled w-full mt-3">{t(copy.continue, lang)}</button>
        </div>
      </div>

      <!-- Step 2: checkout form -->
      <div id="cart-step-checkout" class="cart-step hidden">
        <button id="cart-back-to-lines" type="button" class="cart-back-link">← {t(copy.back, lang)}</button>
        <form id="cart-checkout-form" novalidate class="mt-3">
          <div class="cart-field">
            <label class="cart-label" for="co-name">{t(copy.name, lang)}</label>
            <input class="cart-input" type="text" id="co-name" name="name" autocomplete="name" required />
          </div>
          <div class="cart-field">
            <label class="cart-label" for="co-phone">{t(copy.phone, lang)}</label>
            <input class="cart-input" type="tel" id="co-phone" name="phone" autocomplete="tel" required />
          </div>
          <div class="cart-field">
            <label class="cart-label" for="co-mode">{t(copy.mode, lang)}</label>
            <select class="cart-input" id="co-mode" name="mode">
              <option value="dinein">{t(copy.modeDineIn, lang)}</option>
              <option value="takeaway">{t(copy.modeTakeaway, lang)}</option>
              <option value="delivery">{t(copy.modeDelivery, lang)}</option>
            </select>
          </div>
          <div class="cart-field" id="co-table-field">
            <label class="cart-label" for="co-table">{t(copy.table, lang)}</label>
            <input class="cart-input" type="text" id="co-table" name="table" />
          </div>
          <div class="cart-field hidden" id="co-address-field">
            <label class="cart-label" for="co-address">{t(copy.address, lang)}</label>
            <input class="cart-input" type="text" id="co-address" name="address" />
          </div>
          <div class="cart-field">
            <label class="cart-label" for="co-notes">{t(copy.notes, lang)}</label>
            <textarea class="cart-input" id="co-notes" name="notes" rows="2"></textarea>
          </div>
          <button id="cart-submit" type="submit" class="cart-btn cart-btn-filled w-full mt-4">
            <span id="cart-submit-label">{t(copy.submit, lang)}</span>
          </button>
          <div id="cart-status" class="mt-3" aria-live="polite"></div>
        </form>
      </div>

      <!-- Step 3: confirmation -->
      <div id="cart-step-success" class="cart-step hidden text-center py-8">
        <p class="font-display text-xl font-semibold" style="color: var(--color-text-primary)">{t(copy.successTitle, lang)}</p>
        <p class="text-sm mt-2" style="color: var(--color-text-muted)">{t(copy.successBody, lang)}</p>
        <button id="cart-reset" type="button" class="cart-btn cart-btn-outline mt-5">{t(copy.successAnother, lang)}</button>
      </div>
    </div>
  </div>
</div>

<style>
  .cart-fab {
    position: fixed;
    bottom: 84px;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-background);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    right: 18px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  [dir='rtl'] .cart-fab {
    right: auto;
    left: 18px;
  }
  .cart-fab:hover {
    transform: scale(1.08);
  }
  @media (min-width: 640px) {
    .cart-fab {
      bottom: 96px;
      width: 58px;
      height: 58px;
      right: 28px;
    }
    [dir='rtl'] .cart-fab {
      right: auto;
      left: 28px;
    }
  }
  /* .hidden (Tailwind's shared `display:none` utility) and this scoped
     rule both have single-class specificity — whichever loads later in
     the cascade wins, and that's load-order dependent, not something to
     rely on. Same class of bug as the site-wide color override earlier in
     this project: give the hidden state its own higher-specificity rule
     below so it always wins regardless of stylesheet order. */
  .cart-fab-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background-color: var(--color-background);
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
    font-size: 0.65rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cart-fab-badge.hidden {
    display: none;
  }

  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .cart-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .cart-panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 100%;
    max-width: 420px;
    background-color: var(--color-surface);
    border-left: 1px solid var(--color-border);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
  }
  [dir='rtl'] .cart-panel {
    right: auto;
    left: 0;
    border-left: none;
    border-right: 1px solid var(--color-border);
    transform: translateX(-100%);
  }
  .cart-overlay.is-open .cart-panel {
    transform: translateX(0);
  }
  .cart-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }
  .cart-panel-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .cart-panel-logo {
    height: 22px;
    width: auto;
    display: block;
  }
  /* Faint watermark so the empty/line-items area doesn't feel bare */
  #cart-step-lines {
    background-image: url('/images/logo-watermark.webp');
    background-repeat: no-repeat;
    background-position: center bottom 1.25rem;
    background-size: 130px auto;
  }
  .cart-icon-btn {
    color: var(--color-text-muted);
  }
  .cart-icon-btn:hover {
    color: var(--color-accent);
  }
  .cart-step.hidden {
    display: none;
  }
  .cart-lines {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cart-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.75rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
  }
  .cart-line-info {
    flex: 1;
    min-width: 0;
  }
  .cart-line-name {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text-primary);
  }
  .cart-line-price {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .cart-qty {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .cart-qty-btn {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cart-qty-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .cart-empty {
    text-align: center;
    padding: 2rem 0;
  }
  .cart-empty.hidden {
    display: none;
  }
  .cart-summary.hidden {
    display: none;
  }
  .cart-subtotal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    margin-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
  }
  .cart-back-link {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .cart-field {
    margin-bottom: 0.9rem;
  }
  .cart-field.hidden {
    display: none;
  }
  .cart-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
    color: var(--color-text-muted);
  }
  .cart-input {
    width: 100%;
    border-radius: 0.6rem;
    padding: 0.7rem 0.9rem;
    font-size: 0.875rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }
  .cart-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }
  .cart-input.cart-invalid {
    border-color: #ff5a5a;
  }
  .cart-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    padding: 0.8rem 1.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    text-decoration: none;
  }
  .cart-btn-filled {
    background-color: var(--color-accent);
    color: var(--color-background);
  }
  .cart-btn-filled:hover {
    filter: brightness(1.08);
  }
  .cart-btn-outline {
    background-color: transparent;
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent);
  }
  .cart-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .cart-status-success,
  .cart-status-error {
    border-radius: 0.6rem;
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
  }
  .cart-status-error {
    background-color: color-mix(in srgb, #ff5a5a 14%, var(--color-background));
    border: 1px solid color-mix(in srgb, #ff5a5a 35%, transparent);
    color: var(--color-text-primary);
  }
</style>

<!-- Two script tags on purpose: `define:vars` forces Astro to keep that
     block as a raw, unbundled inline script (it can't run it through
     Vite — that's how define:vars injects the serialized values before
     execution). A dynamic import() inside a define:vars block therefore
     never gets resolved/bundled and 404s in the production build. So the
     values are handed off through a tiny define:vars block, and the actual
     logic — including the dynamic import of cart.ts — lives in a second,
     plain <script> with no define:vars, which Astro DOES bundle normally. -->
<script define:vars={{ supabaseUrl, supabaseAnonKey, whatsappNumber, currency, restaurantName, lang }}>
  window.__moeCartConfig = { supabaseUrl, supabaseAnonKey, whatsappNumber, currency, restaurantName, lang };
</script>
<script>
  const { supabaseUrl, supabaseAnonKey, whatsappNumber, currency, restaurantName, lang } = window.__moeCartConfig;

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('cart-root');
    if (!root || root.dataset.wired === 'true') return;
    root.dataset.wired = 'true';

    // Dynamic import keeps this a normal ES module dependency (bundled by
    // Vite) instead of duplicating the cart logic inline in every page.
    import('/src/lib/cart.ts').then((cart) => wire(cart));

    function wire(cart) {
      const fab = document.getElementById('cart-fab');
      const badge = document.getElementById('cart-fab-badge');
      const overlay = document.getElementById('cart-overlay');
      const closeBtn = document.getElementById('cart-close');
      const linesEl = document.getElementById('cart-lines');
      const emptyEl = document.getElementById('cart-empty');
      const summaryEl = document.getElementById('cart-summary');
      const subtotalEl = document.getElementById('cart-subtotal');
      const stepLines = document.getElementById('cart-step-lines');
      const stepCheckout = document.getElementById('cart-step-checkout');
      const stepSuccess = document.getElementById('cart-step-success');
      const toCheckoutBtn = document.getElementById('cart-to-checkout');
      const backBtn = document.getElementById('cart-back-to-lines');
      const form = document.getElementById('cart-checkout-form');
      const modeSelect = document.getElementById('co-mode');
      const tableField = document.getElementById('co-table-field');
      const addressField = document.getElementById('co-address-field');
      const submitBtn = document.getElementById('cart-submit');
      const submitLabel = document.getElementById('cart-submit-label');
      const statusEl = document.getElementById('cart-status');
      const resetBtn = document.getElementById('cart-reset');

      const LABELS = {
        remove: { fr: 'Retirer', en: 'Remove', ar: 'إزالة' },
        required: { fr: 'Ce champ est requis.', en: 'This field is required.', ar: 'هذا الحقل مطلوب.' },
        submit: { fr: 'Envoyer via WhatsApp', en: 'Send via WhatsApp', ar: 'إرسال عبر واتساب' },
        submitting: { fr: 'Envoi...', en: 'Sending...', ar: 'جارٍ الإرسال...' },
        errorTitle: {
          fr: 'La commande a été ouverte dans WhatsApp, mais n’a pas pu être envoyée au restaurant automatiquement.',
          en: 'The order opened in WhatsApp, but could not be sent to the restaurant automatically.',
          ar: 'تم فتح الطلب في واتساب، لكن تعذر إرساله تلقائيًا إلى المطعم.',
        },
      };
      const L = (key) => LABELS[key][lang] ?? LABELS[key].fr;

      function renderLines() {
        const lines = cart.getCart();
        linesEl.innerHTML = '';
        const hasLines = lines.length > 0;
        emptyEl.classList.toggle('hidden', hasLines);
        summaryEl.classList.toggle('hidden', !hasLines);

        lines.forEach((line) => {
          const row = document.createElement('div');
          row.className = 'cart-line';
          row.innerHTML = `
            <div class="cart-line-info">
              <p class="cart-line-name">${escapeHtml(line.name)}</p>
              <p class="cart-line-price">${line.price} ${currency}</p>
            </div>
            <div class="cart-qty">
              <button type="button" class="cart-qty-btn" data-action="dec" data-id="${line.id}">−</button>
              <span style="min-width:1.2rem;text-align:center;color:var(--color-text-primary)">${line.quantity}</span>
              <button type="button" class="cart-qty-btn" data-action="inc" data-id="${line.id}">+</button>
            </div>
          `;
          linesEl.appendChild(row);
        });

        const total = cart.getCartTotal(lines);
        subtotalEl.textContent = `${total} ${currency}`;

        const count = cart.getCartCount(lines);
        badge.textContent = String(count);
        badge.classList.toggle('hidden', count === 0);
      }

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      linesEl.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        const lines = cart.getCart();
        const line = lines.find((l) => l.id === id);
        if (!line) return;
        const delta = btn.getAttribute('data-action') === 'inc' ? 1 : -1;
        cart.updateQuantity(id, line.quantity + delta);
      });

      cart.onCartUpdated(renderLines);
      renderLines();

      function openDrawer() {
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function closeDrawer() {
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      function showStep(step) {
        [stepLines, stepCheckout, stepSuccess].forEach((el) => el.classList.add('hidden'));
        step.classList.remove('hidden');
      }

      fab.addEventListener('click', () => {
        showStep(stepLines);
        openDrawer();
      });
      closeBtn.addEventListener('click', closeDrawer);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeDrawer();
      });

      // "Commander" buttons sitewide (Button.astro with cartTrigger) —
      // delegated on document since they exist on every page, not just
      // wherever this widget's own markup lives.
      document.addEventListener('click', (e) => {
        const trigger = e.target.closest('[data-cart-trigger]');
        if (!trigger) return;
        e.preventDefault();
        showStep(stepLines);
        openDrawer();
      });

      toCheckoutBtn.addEventListener('click', () => {
        if (cart.getCart().length === 0) return;
        showStep(stepCheckout);
      });
      backBtn.addEventListener('click', () => showStep(stepLines));
      resetBtn.addEventListener('click', () => {
        cart.clearCart();
        form.reset();
        showStep(stepLines);
      });

      modeSelect.addEventListener('change', () => {
        const isDelivery = modeSelect.value === 'delivery';
        tableField.classList.toggle('hidden', isDelivery);
        addressField.classList.toggle('hidden', !isDelivery);
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        statusEl.innerHTML = '';

        const nameInput = document.getElementById('co-name');
        const phoneInput = document.getElementById('co-phone');
        const tableInput = document.getElementById('co-table');
        const addressInput = document.getElementById('co-address');
        const notesInput = document.getElementById('co-notes');

        const required = [nameInput, phoneInput];
        let firstInvalid = null;
        for (const el of required) {
          const empty = !el.value || el.value.trim() === '';
          el.classList.toggle('cart-invalid', empty);
          if (empty && !firstInvalid) firstInvalid = el;
        }
        if (firstInvalid) {
          firstInvalid.focus();
          return;
        }

        const lines = cart.getCart();
        if (lines.length === 0) return;

        const mode = modeSelect.value;
        const addressOrTable = mode === 'delivery' ? addressInput.value.trim() : tableInput.value.trim();
        const total = cart.getCartTotal(lines);
        const orderRef = Math.random().toString(36).slice(2, 8).toUpperCase();

        const MODE_LABEL = {
          dinein: { fr: 'Sur place', en: 'Dine-in', ar: 'في المكان' },
          takeaway: { fr: 'À emporter', en: 'Takeaway', ar: 'سفري' },
          delivery: { fr: 'Livraison', en: 'Delivery', ar: 'توصيل' },
        };
        const modeLabel = MODE_LABEL[mode][lang] ?? MODE_LABEL[mode].fr;

        // Build the WhatsApp message synchronously and open the chat in
        // the SAME click-event tick as the submit, before any `await` —
        // opening a new tab after an awaited fetch is what popup blockers
        // catch. The Supabase insert below fires right after, unawaited by
        // the tab-open itself.
        const msgLines = [];
        msgLines.push(`*NOUVELLE COMMANDE — ${restaurantName.toUpperCase()}*`);
        msgLines.push(`*Réf:* ${orderRef}`);
        msgLines.push('---------------------------------------');
        msgLines.push(`*Client:* ${nameInput.value.trim()}`);
        msgLines.push(`*Mode:* ${modeLabel}${addressOrTable ? ` (${addressOrTable})` : ''}`);
        msgLines.push(`*Tél:* ${phoneInput.value.trim()}`);
        msgLines.push('---------------------------------------');
        msgLines.push('*DÉTAIL DE LA COMMANDE:*');
        msgLines.push('');
        lines.forEach((line, idx) => {
          msgLines.push(`${idx + 1}. *${line.quantity}x ${line.name}* — ${line.price * line.quantity} ${currency}`);
        });
        msgLines.push('---------------------------------------');
        if (notesInput.value.trim()) msgLines.push(`*Note:* ${notesInput.value.trim()}`);
        msgLines.push(`*TOTAL À PAYER:* *${total} ${currency}*`);

        const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msgLines.join('\n'))}`;
        window.open(waUrl, '_blank', 'noopener');

        // Fire-and-forget insert into Supabase so the order shows up live
        // on the in-restaurant staff screen. Not awaited before opening
        // WhatsApp above — a slow/failed insert must never block or break
        // the WhatsApp send, which is the one path that always works.
        if (supabaseUrl && supabaseAnonKey) {
          submitBtn.disabled = true;
          submitLabel.textContent = L('submitting');
          fetch(`${supabaseUrl}/rest/v1/orders`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: supabaseAnonKey,
              Authorization: `Bearer ${supabaseAnonKey}`,
              Prefer: 'return=minimal',
            },
            body: JSON.stringify({
              order_ref: orderRef,
              customer_name: nameInput.value.trim(),
              customer_phone: phoneInput.value.trim(),
              order_type: mode,
              address_or_table: addressOrTable || null,
              items: lines.map((l) => ({ name: l.name, quantity: l.quantity, price: l.price })),
              total,
              notes: notesInput.value.trim() || null,
              status: 'pending',
            }),
          })
            .catch((err) => {
              console.error('[cart] Supabase insert failed', err);
              statusEl.innerHTML = `<div class="cart-status-error">${L('errorTitle')}</div>`;
            })
            .finally(() => {
              submitBtn.disabled = false;
              submitLabel.textContent = L('submit');
            });
        } else {
          console.warn('[cart] siteConfig.ordering.supabaseUrl/supabaseAnonKey not set — order will not appear on the staff screen.');
        }

        cart.clearCart();
        form.reset();
        showStep(stepSuccess);
      });
    }
  });
</script>
