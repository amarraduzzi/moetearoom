---
// Reverted the red-gradient `cta` variant — it read as a coupon-site
// "BUY NOW" sticker, not premium, and clashed with "strak" (the client's
// own word). Back to gold-only, but the order CTA now gets real motion
// instead of color to stand out: a magnetic pointer-follow (see the script
// in Layout.astro, ported from the order-engine's MagneticButton — same
// idea, no framer-motion, ~15 lines of vanilla JS) plus the existing
// fill-sweep. Movement instead of paint is the whole point of this pass.
interface Props {
  href: string;
  external?: boolean;
  variant?: 'outline' | 'filled' | 'cta';
  class?: string;
  // Set on every "Commander" CTA sitewide (see src/lib/nav.ts) — opens the
  // in-site cart drawer (src/components/cart/CartWidget.astro) via a
  // delegated click listener instead of navigating. `href` stays a real,
  // working link to /menu underneath (no-JS fallback + still a valid,
  // crawlable link), so this is progressive enhancement, not the only way
  // the button works.
  cartTrigger?: boolean;
}
const { href, external = false, variant = 'outline', class: className = '', cartTrigger = false } = Astro.props;
// `cta` now stacks on the FILLED look, not outline — this is the one
// button on the page meant to visually win at a glance (the header CTA and
// hero's primary action), so it needs solid contrast, not the same
// low-weight outline treatment as the secondary "Voir le menu" button next
// to it. Keeps the magnetic pointer-follow + sliding arrow from before.
const variantClass = variant === 'outline' ? 'amp-btn-outline' : variant === 'cta' ? 'amp-btn-cta amp-btn-filled' : 'amp-btn-filled';
---
<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  data-magnetic={variant === 'cta' ? 'true' : undefined}
  data-cart-trigger={cartTrigger ? 'open' : undefined}
  class:list={[
    'amp-btn relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-lg px-6 py-3.5 text-sm font-bold tracking-wide transition-colors duration-200',
    variantClass,
    className,
  ]}
>
  <span class="relative z-10 inline-flex items-center gap-2">
    <slot />
    {variant === 'cta' && (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="amp-btn-arrow">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
  </span>
</a>

<style>
  .amp-btn-outline {
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent);
    background-color: transparent;
  }
  .amp-btn-outline::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }
  .amp-btn-outline:hover::before,
  .amp-btn-outline:active::before {
    transform: scaleX(1);
  }
  .amp-btn-outline:hover,
  .amp-btn-outline:active {
    color: var(--color-background);
  }
  .amp-btn-filled {
    background-color: var(--color-accent);
    color: var(--color-background);
  }
  .amp-btn-filled:hover {
    filter: brightness(1.08);
  }

  /* .amp-btn-cta stacks on top of .amp-btn-outline (same gold look, same
     fill-sweep) — the only addition is the magnetic pointer-follow, driven
     by the shared script in Layout.astro via data-magnetic, plus a touch
     more padding and the sliding arrow so it still reads as the primary
     action without needing a different color to do it. */
  .amp-btn-cta {
    padding-left: 1.75rem;
    padding-right: 1.75rem;
    transition: transform 0.15s ease-out, color 0.2s ease;
  }
  .amp-btn-arrow {
    transition: transform 0.2s ease;
  }
  .amp-btn-cta:hover .amp-btn-arrow {
    transform: translateX(3px);
  }
  /* Arabic pages read right-to-left — an arrow that still points and
     slides right would point AWAY from the reading direction instead of
     toward it. Mirror the icon, then the same translateX(3px) reads as
     "toward reading-start" once the local axis is flipped. */
  [dir='rtl'] .amp-btn-arrow {
    transform: scaleX(-1);
  }
  [dir='rtl'] .amp-btn-cta:hover .amp-btn-arrow {
    transform: scaleX(-1) translateX(3px);
  }
</style>
