---
// A small centered divider glyph — a simplified lotus/petal motif that
// echoes the client's real logo shape without reproducing it exactly. Used
// between sections so a transition sometimes gets a quiet decorative beat
// instead of always being a flat color change. This is the one bit of
// "Indian restaurant" texture the site had zero of before — everything was
// carrying that signal through photos and the logo alone.
---
<div class="flex items-center justify-center py-2" aria-hidden="true">
  <span class="h-px w-10 sm:w-16" style="background: linear-gradient(90deg, transparent, var(--color-border))"></span>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="mx-4 shrink-0" style="color: var(--color-accent)">
    <path
      d="M12 3c-1.5 3-4.5 4.5-4.5 8.5a4.5 4.5 0 009 0C16.5 7.5 13.5 6 12 3z"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linejoin="round"
    />
    <path d="M6 16c2 1.2 4 1.6 6 1.6s4-.4 6-1.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    <circle cx="12" cy="10.5" r="1.1" fill="currentColor" />
  </svg>
  <span class="h-px w-10 sm:w-16" style="background: linear-gradient(90deg, var(--color-border), transparent)"></span>
</div>
