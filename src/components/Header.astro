---
// Same header behavior as the order-landing-page engine's Header.tsx v3:
// fully transparent at the top of the page (sits directly on the hero
// photo, no bar), gains a blurred surface + border the moment you scroll,
// plus a thin gold scroll-progress hairline. No React/framer-motion here —
// it's a ~20-line vanilla script instead, since this is a static multi-page
// site and shipping a JS framework runtime just for this would undercut the
// entire reason this project is Astro (fast, crawlable, no hydration tax).
//
// Departure from the order-engine convention: that engine deliberately
// never uses a client logo file (quality varies too much client to client).
// For Indian Flavors specifically, the client's actual gold emblem (cropped
// from their real storefront photography, not a vector supplied by them) is
// strong enough to be worth the exception — a real mark reads as more
// "wow" than typography alone. If a future client's logo photography isn't
// this clean, fall back to the typographic-only header.
import { siteConfig } from '../config/site.config';
import { getOrderCtaLabel } from '../lib/nav';
import { LANGUAGES, LANGUAGE_LABEL, LANGUAGE_NATIVE_NAME, localizedPath, arrow, t, type Language } from '../i18n/languages';
import { nav as navUi } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;
const orderCtaLabel = getOrderCtaLabel(lang);
// The header's three CTA links (desktop bar, mobile top bar, mobile
// hamburger panel) are plain links to /reservation via getOrderCtaLabel
// (see nav.ts). This used to be "Commander" → the in-site cart/checkout;
// both are gone now (Amar, Sept 2026 — the menu is browse-only, ordering
// removed sitewide) and every one of these CTAs is "Réserver" instead.

const nav = [
  { href: '/', label: t(navUi.accueil, lang) },
  { href: '/menu', label: t(navUi.menu, lang) },
  { href: '/reservation', label: t(navUi.reservation, lang) },
  { href: '/a-propos', label: t(navUi.aPropos, lang) },
  { href: '/avis', label: t(navUi.avis, lang) },
  { href: '/faq', label: t(navUi.faq, lang) },
  { href: '/contact', label: t(navUi.contact, lang) },
].map((item) => ({ ...item, href: localizedPath(item.href, lang) }));

// Current path with the OTHER languages' equivalent URLs, for the
// switcher — same page, different language, never the homepage of that
// language regardless of where you currently are on the site.
const currentPath = Astro.url.pathname;
const langLinks = LANGUAGES.map((l) => ({ lang: l, href: localizedPath(currentPath, l) }));
---
<header id="site-header" class="sticky top-0 z-40 transition-all duration-300" data-scrolled="false">
  <!-- Desktop/tablet bar (md and up) — unchanged structure: logo left,
       nav center-ish, always-visible language pills, CTA, no hamburger.
       Only the logo itself changed (accent-green recolor + larger), per
       Amar's request; the mobile bar below is a fully separate layout
       rather than squeezing one row to serve both, since "centered logo"
       and "logo on the left next to nav links" aren't reconcilable in a
       single flex row. -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 hidden md:flex items-center justify-between gap-4">
    <a href={localizedPath('/', lang)} class="flex items-center min-w-0 shrink">
      <img src="/images/logo-mark-accent.webp" alt={siteConfig.identity.name} class="h-14 w-auto shrink-0" />
    </a>

    <nav class="flex items-center gap-7 shrink-0">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-sm font-semibold transition-colors"
          style={`color: ${currentPath === item.href ? 'var(--color-accent)' : 'var(--color-text-primary)'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Language switcher — real links to the same page's other-language
         URL (see langLinks above), not a JS toggle: each is an actual
         separately-crawlable static page (see astro.config.mjs's i18n
         comment for why that matters here). -->
    <div class="flex items-center gap-1 shrink-0 rounded-full p-0.5" style="border: 1px solid var(--color-border)">
      {langLinks.map((l) => (
        <a
          href={l.href}
          aria-label={LANGUAGE_NATIVE_NAME[l.lang]}
          aria-current={lang === l.lang ? 'true' : undefined}
          class="px-2 py-1 rounded-full text-xs font-bold transition-colors"
          style={`color: ${lang === l.lang ? 'var(--color-background)' : 'var(--color-text-muted)'}; background-color: ${lang === l.lang ? 'var(--color-accent)' : 'transparent'}`}
        >
          {LANGUAGE_LABEL[l.lang]}
        </a>
      ))}
    </div>

    <a
      href={orderCtaLabel.href}
      class="inline-flex items-center gap-1.5 text-sm font-bold shrink-0"
      style="color: var(--color-accent)"
    >
      {orderCtaLabel.label} {arrow(lang)}
    </a>
  </div>

  <!-- Mobile bar (below md) — logo stays left-aligned (Amar clarified:
       "in the middle of the header" meant vertically centered within the
       bar's own height, via items-center below — NOT horizontally centered
       across the screen). Just bigger and accent-green now. Language is
       one compact dropdown button directly to the left of the hamburger,
       not three pills spread toward the middle of the bar. -->
  <div class="max-w-7xl mx-auto px-4 h-16 flex md:hidden items-center justify-between gap-2">
    <a href={localizedPath('/', lang)} class="flex items-center min-w-0 shrink">
      <img src="/images/logo-mark-accent.webp" alt={siteConfig.identity.name} class="h-11 w-auto shrink-0" />
    </a>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href={orderCtaLabel.href}
        class="hidden sm:inline-flex items-center gap-1.5 text-sm font-bold shrink-0"
        style="color: var(--color-accent)"
      >
        {orderCtaLabel.label}
      </a>

    <!-- Language dropdown: a single button showing the current language,
         expanding a short list downward on click — replaces the old
         side-by-side FR/EN/AR pills on mobile specifically. -->
    <div class="relative shrink-0">
      <button
        id="lang-toggle"
        type="button"
        class="flex items-center gap-1 px-2.5 py-1.5 rounded-full text-xs font-bold"
        style="border: 1px solid var(--color-border); color: var(--color-text-primary)"
        aria-haspopup="true"
        aria-expanded="false"
      >
        {LANGUAGE_LABEL[lang]}
        <svg id="lang-toggle-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-200">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <div
        id="lang-dropdown"
        class="hidden absolute right-0 mt-2 min-w-[8rem] rounded-xl overflow-hidden z-50"
        style="background-color: var(--color-surface); border: 1px solid var(--color-border); box-shadow: 0 12px 28px rgba(0,0,0,0.3)"
      >
        {langLinks.map((l) => (
          <a
            href={l.href}
            aria-current={lang === l.lang ? 'true' : undefined}
            class="block px-3.5 py-2.5 text-sm font-semibold"
            style={`color: ${lang === l.lang ? 'var(--color-accent)' : 'var(--color-text-primary)'}; background-color: ${lang === l.lang ? 'color-mix(in srgb, var(--color-accent) 10%, transparent)' : 'transparent'}`}
          >
            {LANGUAGE_NATIVE_NAME[l.lang]}
          </a>
        ))}
      </div>
    </div>

      <!-- Mobile nav toggle -->
      <button id="mobile-nav-toggle" class="shrink-0" aria-label="Menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--color-text-primary)">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav-panel" class="md:hidden hidden flex-col px-4 pb-4" style="background-color: var(--color-surface)">
    {nav.map((item) => (
      <a href={item.href} class="py-2.5 text-sm font-semibold" style="color: var(--color-text-primary)">
        {item.label}
      </a>
    ))}
    <!-- Language pills are no longer repeated here — they're always visible
         in the header bar itself now (see above), including on mobile, so
         duplicating them inside this panel would just be clutter. -->
    <a
      href={orderCtaLabel.href}
      class="mt-3 pt-3 py-2.5 text-sm font-bold"
      style="border-top: 1px solid var(--color-border); color: var(--color-accent)"
    >
      {orderCtaLabel.label} {arrow(lang)}
    </a>
  </div>

  <div class="h-px w-full transition-colors duration-300" id="header-track">
    <div id="header-progress" class="h-full" style="width: 0%; background-color: var(--color-accent)"></div>
  </div>
</header>

<style>
  #site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  /* Scrolled state now carries a touch of the same wine-red used in the
     section bands below (color-mix'd into --color-surface first, then
     that result mixed toward transparent for the blur) instead of being
     the one part of the site that stays neutral grey no matter what page
     you're on. Still subtle — this is the header, restraint matters most
     here — but it means the "opening" moment ties back to the brand. */
  #site-header[data-scrolled='true'] {
    background-color: color-mix(in srgb, color-mix(in srgb, var(--color-primary-dark) 10%, var(--color-surface)) 95%, transparent);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }
  #header-track {
    background-color: transparent;
  }
  #site-header[data-scrolled='true'] #header-track {
    background-color: var(--color-border);
  }
  #mobile-nav-panel.open {
    display: flex;
  }
</style>

<script>
  // Wrapped in 'astro:page-load' (fires on first load AND after every View
  // Transitions client-side navigation — see Layout.astro's scripts for the
  // same pattern). The header re-renders on every navigation (different
  // active nav item, different lang-switcher state per page), so its old
  // DOM nodes and any listeners bound to them are gone after a transition;
  // this re-queries fresh nodes and rebinds every time instead of only once.
  // `scrollHandler` is tracked at module scope purely to remove the
  // previous page's `window` scroll listener first — `window` itself isn't
  // swapped between navigations, so without this, every navigation would
  // stack another listener on top instead of replacing it.
  let scrollHandler = null;
  // Same reasoning as scrollHandler above: this listener lives on
  // `document`, which survives every client-side navigation, so it must be
  // removed and re-added each time too or clicks anywhere on the page
  // would close (or re-close) the language dropdown once per past
  // navigation instead of once.
  let langDropdownOutsideClick = null;

  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header');
    const progress = document.getElementById('header-progress');
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    const langToggle = document.getElementById('lang-toggle');
    const langDropdown = document.getElementById('lang-dropdown');
    const langChevron = document.getElementById('lang-toggle-chevron');

    function onScroll() {
      if (!header || !progress) return;
      const scrolled = window.scrollY > 8;
      header.dataset.scrolled = String(scrolled);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      progress.style.width = `${pct * 100}%`;
    }
    onScroll();

    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
    scrollHandler = onScroll;
    window.addEventListener('scroll', scrollHandler, { passive: true });

    toggle?.addEventListener('click', () => {
      const isOpen = panel?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });

    function closeLangDropdown() {
      langDropdown?.classList.add('hidden');
      langToggle?.setAttribute('aria-expanded', 'false');
      if (langChevron) langChevron.style.transform = 'rotate(0deg)';
    }

    langToggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      const willOpen = langDropdown?.classList.contains('hidden');
      if (willOpen) {
        langDropdown?.classList.remove('hidden');
        langToggle.setAttribute('aria-expanded', 'true');
        if (langChevron) langChevron.style.transform = 'rotate(180deg)';
      } else {
        closeLangDropdown();
      }
    });

    if (langDropdownOutsideClick) document.removeEventListener('click', langDropdownOutsideClick);
    langDropdownOutsideClick = () => closeLangDropdown();
    document.addEventListener('click', langDropdownOutsideClick);
  });
</script>
