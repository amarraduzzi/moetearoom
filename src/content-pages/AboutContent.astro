---
// See HomeContent.astro's top comment for the shared-body-per-route
// pattern this and every other src/content-pages/*.astro file follows.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Ornament from '../components/Ornament.astro';
import LogoWatermark from '../components/LogoWatermark.astro';
import FloralSprig from '../components/FloralSprig.astro';
import { siteConfig } from '../config/site.config';
import { aggregateRating } from '../content/testimonials';
import { t, localizedPath, type Language } from '../i18n/languages';
import { place } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = t(place.city, lang);

const copy = {
  metaTitle: {
    fr: `À propos — ${name}, ${primaryKeyword} à ${city}`,
    en: `About — ${name}, ${primaryKeyword} in ${city}`,
    ar: `من نحن — ${name}, ${primaryKeyword} في ${city}`,
  },
  metaDescription: {
    fr: `${name}, salon de thé à ${city} ouvert tous les jours de 8h30 à 23h30 : formules selon l'heure, menu sur le pouce, boissons chaudes, thés, jus frais et notre expérience éclair signature.`,
    en: `${name}, a tea room in ${city} open every day from 8:30 AM to 11:30 PM: time-of-day formules, quick bites, hot drinks, teas, fresh juices and our signature éclair experience.`,
    ar: `${name}، صالون شاي في ${city}، مفتوح يوميًا من 8:30 صباحًا حتى 11:30 مساءً: عروض حسب الوقت، وجبات سريعة، مشروبات ساخنة، شاي، عصائر طازجة، وتجربة الإكلير المميزة لدينا.`,
  },
  kicker: { fr: 'Notre histoire', en: 'Our story', ar: 'قصتنا' },
  heroTitle: { fr: `À propos de ${name}`, en: `About ${name}`, ar: `عن ${name}` },
  heroAlt: {
    fr: `Intérieur du ${primaryKeyword} ${name}`,
    en: `Interior of ${name}, ${primaryKeyword}`,
    ar: `داخل ${name}, ${primaryKeyword}`,
  },
  // Real copy, grounded in what's actually on the site (menu-highlights.ts,
  // menu-formules.ts, site.config.ts) rather than invented history — no
  // founding date, no "years of experience" figure, no sourcing claim has
  // been confirmed with the client, so none of those appear below. Same
  // honesty standard as testimonials.ts: everything here is either a
  // description of the concept itself (the day/time formules, the éclair
  // counter, the three-menus structure) or pulled straight from
  // site.config's own verified fields (city, hours). REPLACE only if the
  // client gives a different founding story to tell.
  p1: {
    fr: `Niché au cœur de ${city}, ${name} est un salon de thé pensé pour se vivre du matin jusqu'au soir : un café pour démarrer la journée, une pause déjeuner, une douceur l'après-midi, une adresse où prolonger la soirée. Ici, la tradition marocaine — thé à la menthe, rfissa du mercredi, couscous du vendredi — côtoie une carte plus contemporaine, entre pâtisserie fine et expérience éclair signature.`,
    en: `Tucked in the heart of ${city}, ${name} is a tea room built to be visited from morning to night: a coffee to start the day, a lunch break, a sweet afternoon treat, a place to linger into the evening. Here, Moroccan tradition — mint tea, Wednesday's rfissa, Friday's couscous — sits alongside a more contemporary menu, from fine pastry to our signature éclair experience.`,
    ar: `يقع ${name} في قلب ${city}، وهو صالون شاي صُمم ليُزار من الصباح إلى المساء: قهوة لبدء اليوم، وقفة غداء، حلوى بعد الظهر، ومكان لإطالة السهرة. هنا يلتقي التقليد المغربي — شاي بالنعناع، رفيسة الأربعاء، كسكس الجمعة — بقائمة أكثر عصرية، من الحلويات الراقية إلى تجربة الإكلير المميزة.`,
  },
  p2: {
    fr: "Notre carte change avec les heures. Chaque moment de la journée a sa propre formule, pensée pour lui : le panier du boulanger de Good Morning Moë au réveil, deux entrées signature et deux suggestions du jour au déjeuner, le Rfissa du mercredi, le Couscous du vendredi, la Gastronomie Dima Maghreb le vendredi soir, et le Brunch signature du week-end. Rien n'est figé à l'avance : ces formules suivent le rythme naturel d'une vraie journée, pas un menu unique servi à toute heure.",
    en: "Our menu changes with the hours. Every moment of the day has its own formule, designed for it: the baker's basket of Good Morning Moë at sunrise, two signature starters and two daily suggestions at lunch, Wednesday's Rfissa, Friday's Couscous, Friday evening's Gastronomie Dima Maghreb, and the weekend's signature brunch. Nothing is fixed in advance — these formules follow the natural rhythm of a real day, not one menu served around the clock.",
    ar: "قائمتنا تتغير مع ساعات اليوم. لكل لحظة من اليوم عرضها الخاص المصمم لها: سلة الخباز في صباح الخير موي عند الاستيقاظ، مقبلتان من توقيعنا واقتراحان يوميان عند الغداء، رفيسة الأربعاء، كسكس الجمعة، غاسترونومي ديما مغرب مساء الجمعة، وبرانش نهاية الأسبوع المميز. لا شيء ثابت مسبقًا: هذه العروض تتبع إيقاع يوم حقيقي، وليست قائمة واحدة تُقدَّم في كل الأوقات.",
  },
  p3: {
    fr: `Entre deux formules, la carte reste ouverte à tout moment : un encas du Menu sur le pouce, un thé ou une infusion, un café ou une boisson chaude, un jus frais ou un milkshake — et notre vitrine d'éclairs, préparés avec soin et renouvelés au fil des créations du chef pâtissier. Trois menus, un seul endroit, ouvert tous les jours de 8h30 à 23h30.`,
    en: `Between formules, the menu stays open at any time: a quick bite from the Menu Sur Le Pouce, a tea or infusion, a hot drink, a fresh juice or milkshake — and our éclair counter, prepared with care and renewed with the pastry chef's own creations. Three menus, one place, open every day from 8:30 AM to 11:30 PM.`,
    ar: `بين عرض وآخر، تبقى القائمة مفتوحة في كل وقت: وجبة سريعة من قائمة وجبات سريعة، شاي أو أعشاب، مشروب ساخن، عصير طازج أو ميلك شيك — وواجهة الإكلير لدينا، المُحضّرة بعناية والمتجددة مع إبداعات شيف الحلويات. ثلاث قوائم في مكان واحد، مفتوح كل يوم من 8:30 صباحًا حتى 11:30 مساءً.`,
  },
  statOuvert: { fr: 'ouvert du matin au soir', en: 'open morning to night', ar: 'مفتوح من الصباح حتى المساء' },
  statMenus: { fr: 'menus réunis en un seul lieu', en: 'menus, all in one place', ar: 'قوائم في مكان واحد' },
  statAvis: { fr: 'avis Tripadvisor', en: 'Tripadvisor reviews', ar: 'تقييم على Tripadvisor' },
  noteMoyenne: { fr: 'note moyenne', en: 'average rating', ar: 'متوسط التقييم' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const path = localizedPath('/a-propos', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
>
  <PageHero
    kicker={t(copy.kicker, lang)}
    title={t(copy.heroTitle, lang)}
    image="/images/interior-1.webp"
    alt={t(copy.heroAlt, lang)}
  />
  <section class="relative max-w-3xl mx-auto px-5 sm:px-8 pt-12 sm:pt-16 pb-20 overflow-hidden">
    <!-- Large faded emblem behind the copy — the real gold mark, not a
         generic decorative shape, used at a scale it can never appear at
         in the header. A quiet "wow" texture instead of another flat
         paragraph block. Now shared via LogoWatermark.astro — see that
         component for why this became the site's one recurring motif. -->
    <LogoWatermark />
    <div class="relative space-y-5 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)" data-reveal>
      <p>{t(copy.p1, lang)}</p>
      <p>{t(copy.p2, lang)}</p>
      <p>{t(copy.p3, lang)}</p>
    </div>
  </section>

  <!-- Oversized, unboxed numbers instead of three identical grey tiles.
       First pass of this looked fine on desktop's 3-column grid but flat
       on mobile — a border-left divider does nothing once the grid stacks
       to one column, so it was just three plain lines of text in a row.
       Fixed: each stat gets its own small icon (so it reads as a distinct
       moment, not just a number), the divider switches to a horizontal
       rule on mobile / vertical rule on desktop, and a soft red glow sits
       behind the whole band so it isn't just another flat tinted box. -->
  <div class="section-tint relative overflow-hidden">
    <div class="section-glow" style="width: 340px; height: 340px; background: var(--color-primary); opacity: 0.07; left: 50%; top: -120px; transform: translateX(-50%);"></div>
    {/* Same printed-menu sprig used on the Menu/Home pages (see
        FloralSprig.astro) — the client's own botanical graphic from the
        physical menu cards, added sitewide on request (Sept 2026). Bottom
        corner here since the top of this band is already busy with the
        section-glow blur above. */}
    <FloralSprig corner="bottom-left" />
    <section class="relative max-w-3xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
      <div class="grid sm:grid-cols-3 gap-10 sm:gap-6">
        {[
          {
            n: '7j/7', // verified — matches site.config.ts's contact.openingHours exactly
            l: t(copy.statOuvert, lang),
            icon: 'M12 21a9 9 0 100-18 9 9 0 000 18z M12 7v5l3.5 2',
          },
          {
            n: '3', // verified — Menu sur le pouce, Boissons & Pâtisserie, Formules & Moments (see MenuContent.astro's group tabs)
            l: t(copy.statMenus, lang),
            icon: 'M12 2 2 7l10 5 10-5-10-5zM2 12l10 5 10-5M2 17l10 5 10-5',
          },
          {
            n: `${aggregateRating.ratingValue}/5`,
            l: `${t(copy.noteMoyenne, lang)} · ${aggregateRating.reviewCount} ${t(copy.statAvis, lang)}`,
            icon: 'M12 2.5l2.9 6.1 6.6.7-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.2 1.3-6.6-4.9-4.6 6.6-.7z',
          },
        ].map((stat, i) => (
          <div
            class={`text-center sm:text-left pb-8 sm:pb-0 sm:pl-8 ${i > 0 ? 'border-t sm:border-t-0 sm:border-l pt-8 sm:pt-0' : ''}`}
            style={`border-color: var(--color-border); transition-delay: ${i * 100}ms`}
            data-reveal
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke-width="1.5" class="mb-3 mx-auto sm:mx-0" style="color: var(--color-accent)">
              <path d={stat.icon} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <p class="stat-huge">{stat.n}</p>
            <p class="text-xs mt-2 max-w-[14rem] mx-auto sm:mx-0" style="color: var(--color-text-muted)">{stat.l}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <Ornament />
</Layout>
