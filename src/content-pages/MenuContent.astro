<style>
  /* Same text-shadow used on Home's hero (see HomeContent.astro) — Astro
     scopes <style> per file, so this can't be shared, just kept identical.
     Gives the near-white hero heading a hairline of separation from the
     photo without reading as a sticker/stroke effect. */
  .hero-shadow {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .menu-filter-row {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .menu-filter-row::-webkit-scrollbar {
    display: none;
  }
  .menu-filter-btn {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background-color: transparent;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .menu-filter-btn.is-active {
    color: var(--color-background);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .menu-filter-btn:not(.is-active):hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .back-to-menu-link {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .back-to-menu-link:hover {
    color: var(--color-accent);
  }
  /* Le Brunch Signature Moë — a vertical, numbered course list rather
     than a card grid, so it reads as a sequence (a tasting menu) instead
     of a set of interchangeable dishes. A left rule threads the courses
     together; each course's own index sits on it like a station marker. */
  .signature-course-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .signature-course {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .signature-course:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .signature-course-index {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-accent);
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
  }
</style>

<script>
  // Client-side only, no reload. Wrapped in 'astro:page-load' (same
  // pattern as Layout.astro's sitewide scripts) so this re-initializes
  // correctly if the Menu page is reached via a View Transitions
  // client-side navigation, not just a hard load.
  //
  // Every pill is a table-of-contents link: scroll straight to its
  // section, mark it active for orientation. No filtering (the old
  // "Végétarien" chip and free-text search were both already removed
  // long before this rewrite).
  document.addEventListener('astro:page-load', () => {
    const filterButtons = document.querySelectorAll('.menu-filter-btn');
    if (!filterButtons.length) return;

    const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    filterButtons.forEach((btn) => {
      const scrollTargetId = btn.getAttribute('data-scroll-to');
      if (!scrollTargetId) return;
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        document.getElementById(scrollTargetId)?.scrollIntoView({ behavior: scrollBehavior });
      });
    });

    // "Back to menu" link under each category — same scroll-to-top-of-list
    // behaviour.
    document.querySelectorAll('.back-to-menu-link').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        document.getElementById('menu-list')?.scrollIntoView({ behavior: scrollBehavior });
      });
    });
  });
</script>
