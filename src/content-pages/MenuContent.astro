---
// See HomeContent.astro's top comment for the shared-body-per-route
// pattern this and every other src/content-pages/*.astro file follows.
//
// Browse-only menu (Amar, Sept 2026 — "de klant wil opeens de menu pagina
// niet meer doorlinken naar het scherm. Het menu moet gewoon alleen
// visueel zijn"): no "add to cart"/ordering IN this page — the in-site
// cart + checkout (CartWidget.astro, src/lib/cart.ts) was removed
// sitewide long ago.
//
// FULL CONTENT REPLACEMENT (Amar, Sept 2026 — pasted the owner's actual
// printed-menu text and asked: "Verwijder alle content wat er nu staat
// bij /menu/ zet er dit op een overzichtelijke manier. dit wilt de
// eigenaar graag"): this page used to render the exact same live catalog
// as /commande (src/content/menu-catalog.ts). It now renders its own
// content from src/content/menu-formules.ts instead — see that file's
// top comment for the full reasoning, confirmed with Amar before
// building this:
//   - Scope is /menu ONLY. /commande (QR in-restaurant ordering) is
//     UNCHANGED and keeps using menu-catalog.ts — the two pages now
//     intentionally show different things. Don't "fix" that by pointing
//     this page back at menu-catalog.ts.
//   - This content is translated FR/EN/AR up front (Amar: "nu al EN/AR
//     vertalen"), unlike menu-catalog.ts's own deliberately FR-only
//     items — don't copy that shortcut here.
// Because this content no longer maps to the in-restaurant POS
// (menu_items table), the old "menu-extra-dishes" staff-sync script and
// section are gone too — they existed to merge live /commande data onto
// this page, which no longer applies now the two pages have diverged.
import Layout from '../layouts/Layout.astro';
import FloralSprig from '../components/FloralSprig.astro';
import { siteConfig } from '../config/site.config';
import { goodMorningMoe, brunchLunch, brunchSignature, pancakes, matchaSignature } from '../content/menu-formules';
import { t, localizedPath, type Language } from '../i18n/languages';
import { place } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name, currency } = siteConfig.identity;
const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = t(place.city, lang);

const copy = {
  metaTitle: {
    fr: `Menu — ${primaryKeyword} à ${city} | ${name}`,
    en: `Menu — ${primaryKeyword} in ${city} | ${name}`,
    ar: `القائمة — ${primaryKeyword} في ${city} | ${name}`,
  },
  metaDescription: {
    fr: `Formules petit-déjeuner, brunch & lunch, brunch signature et Matcha Moë : découvrez le menu complet de ${name}, ${primaryKeyword} à ${city}.`,
    en: `Breakfast set menus, brunch & lunch, signature brunch and Moë Matcha: discover the full menu of ${name}, ${primaryKeyword} in ${city}.`,
    ar: `تركيبات الإفطار، البرانش والغداء، البرانش المميز وماتشا موي: اكتشف القائمة الكاملة لـ${name}, ${primaryKeyword} في ${city}.`,
  },
  heroAlt: {
    fr: `Plats du menu de ${name}`,
    en: `Dishes from ${name}'s menu`,
    ar: `أطباق من قائمة ${name}`,
  },
  // "Majestueux • Élégant • Opulent" is the owner's own brand wordplay on
  // the letters of MOË — kept verbatim/untranslated in every language,
  // same established convention as ReservationContent.astro's own
  // formTagline ("MOË — Majestueux, Élégant, Opulent").
  heroTagline: {
    fr: 'Majestueux • Élégant • Opulent',
    en: 'Majestueux • Élégant • Opulent',
    ar: 'Majestueux • Élégant • Opulent',
  },
  heroSubtitle: {
    fr: 'Une expérience culinaire pensée dans les moindres détails, du petit-déjeuner à notre brunch signature.',
    en: 'A dining experience considered down to the smallest detail, from breakfast to our signature brunch.',
    ar: 'تجربة طعام مدروسة بأدق التفاصيل، من الإفطار إلى برانشنا المميز.',
  },
  backToMenu: { fr: '↑ Retour au menu', en: '↑ Back to menu', ar: '↑ العودة إلى القائمة' },
  orderBannerKicker: { fr: 'Vous êtes au restaurant ?', en: 'Already at the restaurant?', ar: 'هل أنتم في المطعم؟' },
  orderBannerText: {
    fr: 'Commandez en ligne depuis votre table',
    en: 'Order online from your table',
    ar: 'اطلبوا عبر الإنترنت من طاولتكم',
  },
  formuleBadge: { fr: 'Formule', en: 'Set menu', ar: 'تركيبة' },
  inclusionsLabel: { fr: 'Compris dans la formule', en: 'Included in the set menu', ar: 'ضمن التركيبة' },
  priceOnRequest: { fr: 'Tarif sur demande', en: 'Price on request', ar: 'السعر عند الطلب' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

// The five sections, in page order — drives the table-of-contents pill
// row and the anchor each section renders under. Stable string ids
// (not indices, unlike the old menu-catalog.ts-driven loop) so
// HomeContent.astro's Moëtcha CTA and any other cross-page link can
// point at a specific section without breaking if a section is ever
// reordered.
const tocSections = [
  { id: goodMorningMoe.id, label: goodMorningMoe.title },
  { id: brunchLunch.id, label: brunchLunch.title },
  { id: brunchSignature.id, label: brunchSignature.title },
  { id: pancakes.id, label: pancakes.title },
  { id: matchaSignature.id, label: matchaSignature.title },
];

const menuJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Menu — ${name}`,
  hasMenuSection: [
    {
      '@type': 'MenuSection',
      name: t(goodMorningMoe.title, lang),
      hasMenuItem: goodMorningMoe.formules.map((f) => ({
        '@type': 'MenuItem',
        name: t(f.name, lang),
        description: t(f.tagline, lang),
        offers: { '@type': 'Offer', price: f.price, priceCurrency: currency },
      })),
    },
    {
      '@type': 'MenuSection',
      name: t(brunchLunch.title, lang),
      hasMenuItem: brunchLunch.subsections.flatMap((sub) =>
        sub.items.map((item) => ({
          '@type': 'MenuItem',
          name: t(item.name, lang),
          description: item.desc ? t(item.desc, lang) : undefined,
          offers: { '@type': 'Offer', price: item.price, priceCurrency: currency },
        }))
      ),
    },
    {
      '@type': 'MenuSection',
      name: t(brunchSignature.title, lang),
      description: t(brunchSignature.intro, lang),
      hasMenuItem: brunchSignature.courses.flatMap((course) =>
        course.options.map((option) => ({
          '@type': 'MenuItem',
          name: t(option.name, lang),
          description: option.desc ? t(option.desc, lang) : undefined,
        }))
      ),
    },
    {
      '@type': 'MenuSection',
      name: t(pancakes.title, lang),
      hasMenuItem: pancakes.items.map((item) => ({
        '@type': 'MenuItem',
        name: t(item.name, lang),
        description: item.desc ? t(item.desc, lang) : undefined,
        offers: { '@type': 'Offer', price: item.price, priceCurrency: currency },
      })),
    },
    {
      '@type': 'MenuSection',
      name: t(matchaSignature.title, lang),
      hasMenuItem: matchaSignature.items.map((item) => ({
        '@type': 'MenuItem',
        name: t(item.name, lang),
        offers: { '@type': 'Offer', price: item.price, priceCurrency: currency },
      })),
    },
  ],
};

const path = localizedPath('/menu', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  jsonLd={menuJsonLd}
>
  <!-- Menu's own bolder opening moment — every interior page used the same
       compact PageHero, which made the whole site feel like one page
       repeated. Menu gets the exception: taller, with the same Ken Burns
       drift as the Home spotlight, since this is the page people actually
       linger on. Home stays the one full-height "big" hero — this is a
       step up from PageHero, not a rival to Home. -->
  <section class="relative min-h-[420px] sm:h-[64vh] flex items-end overflow-hidden" data-reveal="scale">
    <div class="ken-burns absolute inset-0">
      <img
        src="/images/gallery-3.webp"
        alt={t(copy.heroAlt, lang)}
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
    <!-- Same fix already proven on Home's own hero (see HomeContent.astro's
         comment above its vignette): this photo is naturally pale (white
         box, light background), so a light cream tint on top of it just
         washed the whole thing out instead of darkening it — the text
         color was the wrong half of the fix too, since dark-brown heading
         text only reads against that same light wash. Switching to a dark
         photographic vignette + near-white text keeps the photo crisp and
         still guarantees contrast for the title, the same approach used on
         Home instead of a one-off. -->
    <div class="absolute inset-0" style="background: linear-gradient(0deg, rgba(58,42,30,0.78) 0%, rgba(58,42,30,0.4) 45%, rgba(58,42,30,0.08) 75%, transparent 100%)"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-12 sm:pb-16 w-full">
      <span class="hero-shadow block text-[10px] font-bold uppercase tracking-[0.25em] mb-3" style="color: #F7F0DC">{city}</span>
      <h1 class="hero-shadow font-display text-3xl sm:text-5xl lg:text-6xl font-semibold" style="color: #FFFCF3">
        {name}
      </h1>
      <p class="hero-shadow mt-2 text-sm sm:text-base font-semibold tracking-wide" style="color: #E8C875">
        {t(copy.heroTagline, lang)}
      </p>
      <p class="hero-shadow mt-4 max-w-xl text-sm sm:text-base" style="color: rgba(255,252,243,0.9)">
        {t(copy.heroSubtitle, lang)}
      </p>
    </div>
  </section>

  <!-- Green "order now" banner — kept as-is (Amar's scope answer: only
       /menu's CONTENT changes; this banner still correctly sends anyone
       at the restaurant to /commande for actual ordering). See this
       file's top comment for why it's green instead of the site's usual
       gold CTA. Always links to the bare "/commande" path (never
       localized — see /commande's own src/pages/commande.astro). -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 pt-6 pb-5 sm:pt-8 sm:pb-6" data-reveal>
    <a href="/commande" class="order-banner flex items-center justify-between gap-4 rounded-2xl px-5 py-4 sm:px-7 sm:py-5">
      <span class="flex items-center gap-3 min-w-0">
        <span class="order-banner-icon shrink-0" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h12a1 1 0 0 1 1 1v16l-3.5-2-2.5 2-2.5-2-2.5 2-2.5-2-3.5 2V4a1 1 0 0 1 1-1z" />
            <path d="M8.5 8h7M8.5 11.5h7M8.5 15h4.5" />
          </svg>
        </span>
        <span class="min-w-0">
          <span class="block text-[10px] font-bold uppercase tracking-[0.15em] order-banner-kicker">{t(copy.orderBannerKicker, lang)}</span>
          <span class="block font-display text-base sm:text-lg font-semibold order-banner-text">{t(copy.orderBannerText, lang)}</span>
        </span>
      </span>
      <svg class="order-banner-arrow shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </section>

  <!-- Table-of-contents pill row — jumps straight to a section further
       down the page. Five sections now, matching the owner's printed
       menu structure (see menu-formules.ts), instead of the old
       menu-catalog.ts category list. -->
  <section id="menu-list" class="max-w-7xl mx-auto px-5 sm:px-8 pb-6 scroll-mt-24" data-reveal>
    <div class="menu-filter-row flex items-center gap-2 overflow-x-auto">
      {tocSections.map((section) => (
        <button type="button" class="menu-filter-btn shrink-0" data-scroll-to={section.id}>
          {t(section.label, lang)}
        </button>
      ))}
    </div>
  </section>

  <!-- 1. GOOD MORNING MOË — three fixed-price breakfast formules, each
       with a tagline and a bulleted list of what's included (no per-item
       price inside a formule — the formule itself is what's priced). -->
  <div id={goodMorningMoe.id} class="scroll-mt-24" data-menu-category>
    <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10 overflow-hidden">
      <FloralSprig corner="top-right" />
      <div class="relative">
        <div class="mb-5 pb-3" style="border-bottom: 1px solid var(--color-border)">
          <h2 class="font-display text-2xl font-semibold flex items-baseline gap-3" style="color: var(--color-text-primary)">
            <span class="text-xs font-bold" style="color: var(--color-accent)">01</span>
            {t(goodMorningMoe.title, lang)}
          </h2>
          <p class="mt-2 text-sm max-w-2xl leading-relaxed" style="color: var(--color-text-muted)">{t(goodMorningMoe.hours, lang)}</p>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          {goodMorningMoe.formules.map((formule, j) => (
            <div
              class="card-lift rounded-xl p-5 flex flex-col"
              style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
              data-reveal
            >
              <span class="self-start text-[10px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full mb-3" style="color: var(--color-background); background-color: var(--color-primary)">
                {t(copy.formuleBadge, lang)}
              </span>
              <div class="flex items-start justify-between gap-3 mb-1.5">
                <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">{t(formule.name, lang)}</h3>
                <span class="menu-item-price font-bold shrink-0" style="color: var(--color-accent)">{formule.price} {currency}</span>
              </div>
              <p class="text-sm italic mb-3" style="color: var(--color-text-muted)">{t(formule.tagline, lang)}</p>
              <p class="text-[10px] font-bold uppercase tracking-wide mb-2" style="color: var(--color-accent)">{t(copy.inclusionsLabel, lang)}</p>
              <ul class="text-sm space-y-1.5 mt-auto" style="color: var(--color-text-muted)">
                {formule.inclusions.map((line) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1.5 w-1 h-1 rounded-full shrink-0" style="background-color: var(--color-accent)"></span>
                    <span>{t(line, lang)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <a href="#menu-list" class="back-to-menu-link inline-block mt-5 text-xs font-bold">{t(copy.backToMenu, lang)}</a>
      </div>
    </section>
  </div>

  <!-- 2. BRUNCH & LUNCH — à-la-carte, grouped by subsection (Tartines,
       Incontournables, Fraîcheurs, À Partager, Sandwichs Moë). -->
  <div id={brunchLunch.id} class="scroll-mt-24 section-tint-warm" data-menu-category>
    <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
      <div class="relative">
        <div class="mb-5 pb-3" style="border-bottom: 1px solid var(--color-border)">
          <h2 class="font-display text-2xl font-semibold flex items-baseline gap-3" style="color: var(--color-text-primary)">
            <span class="text-xs font-bold" style="color: var(--color-accent)">02</span>
            {t(brunchLunch.title, lang)}
          </h2>
          <p class="mt-2 text-sm max-w-2xl leading-relaxed" style="color: var(--color-text-muted)">{t(brunchLunch.hours, lang)}</p>
        </div>
        <div class="space-y-6">
          {brunchLunch.subsections.map((sub) => (
            <div>
              <h3 class="text-[11px] font-bold uppercase tracking-[0.14em] mb-2.5" style="color: var(--color-accent)">{t(sub.title, lang)}</h3>
              <div class="grid sm:grid-cols-2 gap-4">
                {sub.items.map((item, j) => (
                  <div
                    class="card-lift flex items-start gap-4 rounded-xl p-4"
                    style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
                    data-reveal
                  >
                    <div class="min-w-0 flex-1">
                      <h4 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">{t(item.name, lang)}</h4>
                      {item.desc && (
                        <p class="text-sm mt-1" style="color: var(--color-text-muted)">{t(item.desc, lang)}</p>
                      )}
                    </div>
                    <span class="menu-item-price font-bold shrink-0" style="color: var(--color-accent)">{item.price} {currency}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <a href="#menu-list" class="back-to-menu-link inline-block mt-5 text-xs font-bold">{t(copy.backToMenu, lang)}</a>
      </div>
    </section>
  </div>

  <!-- 3. LE BRUNCH SIGNATURE MOË — the owner's multi-course tasting
       experience. Distinct layout from everything above: a sequential
       course list (not a grid of cards), with two courses offering a
       choice between two dishes ("Au choix"). No price is shown — the
       owner's own text doesn't list one for this experience. -->
  <div id={brunchSignature.id} class="scroll-mt-24" data-menu-category>
    <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
      <div class="relative">
        <div class="mb-6 pb-3" style="border-bottom: 1px solid var(--color-border)">
          <h2 class="font-display text-2xl font-semibold flex items-baseline gap-3" style="color: var(--color-text-primary)">
            <span class="text-xs font-bold" style="color: var(--color-accent)">03</span>
            {t(brunchSignature.title, lang)}
          </h2>
          <p class="mt-1.5 text-xs font-semibold tracking-wide" style="color: var(--color-primary)">{t(copy.heroTagline, lang)}</p>
          <p class="mt-2 text-sm max-w-2xl leading-relaxed" style="color: var(--color-text-muted)">{t(brunchSignature.intro, lang)}</p>
          <p class="mt-2 text-xs italic" style="color: var(--color-text-muted)">{t(copy.priceOnRequest, lang)}</p>
        </div>
        <ol class="signature-course-list">
          {brunchSignature.courses.map((course, j) => (
            <li class="signature-course" data-reveal style={`transition-delay: ${j * 60}ms`}>
              <span class="signature-course-index" aria-hidden="true">{String(j + 1).padStart(2, '0')}</span>
              <div class="min-w-0 flex-1">
                <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">{t(course.title, lang)}</h3>
                {course.choiceLabel && (
                  <p class="text-[10px] font-bold uppercase tracking-wide mt-1 mb-2" style="color: var(--color-accent)">{t(course.choiceLabel, lang)}</p>
                )}
                <div class={course.options.length > 1 ? 'grid sm:grid-cols-2 gap-3 mt-2' : 'mt-1.5'}>
                  {course.options.map((option) => (
                    <div class={course.options.length > 1 ? 'rounded-lg p-3' : ''} style={course.options.length > 1 ? 'background-color: var(--color-surface-muted); border: 1px solid var(--color-border)' : ''}>
                      <p class="text-sm font-semibold" style="color: var(--color-text-primary)">{t(option.name, lang)}</p>
                      {option.desc && <p class="text-sm mt-0.5" style="color: var(--color-text-muted)">{t(option.desc, lang)}</p>}
                    </div>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ol>
        <a href="#menu-list" class="back-to-menu-link inline-block mt-5 text-xs font-bold">{t(copy.backToMenu, lang)}</a>
      </div>
    </section>
  </div>

  <!-- 4. LES PANCAKES -->
  <div id={pancakes.id} class="scroll-mt-24 section-tint-warm" data-menu-category>
    <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
      <div class="relative">
        <div class="mb-5 pb-3" style="border-bottom: 1px solid var(--color-border)">
          <h2 class="font-display text-2xl font-semibold flex items-baseline gap-3" style="color: var(--color-text-primary)">
            <span class="text-xs font-bold" style="color: var(--color-accent)">04</span>
            {t(pancakes.title, lang)}
          </h2>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          {pancakes.items.map((item, j) => (
            <div
              class="card-lift rounded-xl p-4"
              style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
              data-reveal
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">{t(item.name, lang)}</h3>
                <span class="menu-item-price font-bold shrink-0" style="color: var(--color-accent)">{item.price} {currency}</span>
              </div>
              {item.desc && <p class="text-sm mt-1" style="color: var(--color-text-muted)">{t(item.desc, lang)}</p>}
            </div>
          ))}
        </div>
        <a href="#menu-list" class="back-to-menu-link inline-block mt-5 text-xs font-bold">{t(copy.backToMenu, lang)}</a>
      </div>
    </section>
  </div>

  <!-- 5. MATCHA SIGNATURE MOË — simple priced list, no descriptions in
       the owner's own text. -->
  <div id={matchaSignature.id} class="scroll-mt-24" data-menu-category>
    <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10 overflow-hidden">
      <FloralSprig corner="bottom-left" size="w-40 sm:w-56" />
      <div class="relative">
        <div class="mb-5 pb-3" style="border-bottom: 1px solid var(--color-border)">
          <h2 class="font-display text-2xl font-semibold flex items-baseline gap-3" style="color: var(--color-text-primary)">
            <span class="text-xs font-bold" style="color: var(--color-accent)">05</span>
            {t(matchaSignature.title, lang)}
          </h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {matchaSignature.items.map((item, j) => (
            <div
              class="card-lift flex items-center justify-between gap-4 rounded-xl p-4"
              style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
              data-reveal
            >
              <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">{t(item.name, lang)}</h3>
              <span class="menu-item-price font-bold shrink-0" style="color: var(--color-accent)">{item.price} {currency}</span>
            </div>
          ))}
        </div>
        <a href="#menu-list" class="back-to-menu-link inline-block mt-5 text-xs font-bold">{t(copy.backToMenu, lang)}</a>
      </div>
    </section>
  </div>

</Layout>

<style>
  /* Same text-shadow used on Home's hero (see HomeContent.astro) — Astro
     scopes <style> per file, so this can't be shared, just kept identical.
     Gives the near-white hero heading a hairline of separation from the
     photo without reading as a sticker/stroke effect. */
  .hero-shadow {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .menu-filter-row {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .menu-filter-row::-webkit-scrollbar {
    display: none;
  }
  .menu-filter-btn {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background-color: transparent;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .menu-filter-btn.is-active {
    color: var(--color-background);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .menu-filter-btn:not(.is-active):hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .back-to-menu-link {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .back-to-menu-link:hover {
    color: var(--color-accent);
  }
  /* Deliberately NOT var(--color-accent) (gold, this page's usual CTA
     color) — same dark green /commande itself uses (see
     CommandeContent.astro's --accent token), so this banner reads as
     "ordering" at a glance rather than blending into the gold CTAs
     already on the page (hero button on Home, "Réserver" everywhere). */
  .order-banner {
    background-color: #3F5D45;
    color: #FFFCF3;
    box-shadow: 0 8px 20px -8px rgba(63, 93, 69, 0.55);
    transition: filter 0.2s ease, transform 0.15s ease;
  }
  .order-banner:hover {
    filter: brightness(1.08);
  }
  .order-banner:active {
    transform: scale(0.99);
  }
  .order-banner-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background-color: rgba(255, 252, 243, 0.16);
  }
  .order-banner-kicker {
    color: rgba(255, 252, 243, 0.72);
  }
  .order-banner-arrow {
    transition: transform 0.2s ease;
  }
  .order-banner:hover .order-banner-arrow {
    transform: translateX(3px);
  }
  /* Same RTL mirror as Button.astro's amp-btn-arrow. */
  [dir='rtl'] .order-banner-arrow {
    transform: scaleX(-1);
  }
  [dir='rtl'] .order-banner:hover .order-banner-arrow {
    transform: scaleX(-1) translateX(3px);
  }
  /* Le Brunch Signature Moë — a vertical, numbered course list rather
     than a card grid, so it reads as a sequence (a tasting menu) instead
     of a set of interchangeable dishes. A left rule threads the courses
     together; each course's own index sits on it like a station marker. */
  .signature-course-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .signature-course {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .signature-course:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .signature-course-index {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-accent);
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
  }
</style>

<script>
  // Client-side only, no reload. Wrapped in 'astro:page-load' (same
  // pattern as Layout.astro's sitewide scripts) so this re-initializes
  // correctly if the Menu page is reached via a View Transitions
  // client-side navigation, not just a hard load.
  //
  // Every pill is a table-of-contents link: scroll straight to its
  // section, mark it active for orientation. No filtering (the old
  // "Végétarien" chip and free-text search were both already removed
  // long before this rewrite).
  document.addEventListener('astro:page-load', () => {
    const filterButtons = document.querySelectorAll('.menu-filter-btn');
    if (!filterButtons.length) return;

    const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    filterButtons.forEach((btn) => {
      const scrollTargetId = btn.getAttribute('data-scroll-to');
      if (!scrollTargetId) return;
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        document.getElementById(scrollTargetId)?.scrollIntoView({ behavior: scrollBehavior });
      });
    });

    // "Back to menu" link under each category — same scroll-to-top-of-list
    // behaviour.
    document.querySelectorAll('.back-to-menu-link').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        document.getElementById('menu-list')?.scrollIntoView({ behavior: scrollBehavior });
      });
    });
  });
</script>
