---
// See HomeContent.astro's top comment for the shared-body-per-route
// pattern this and every other src/content-pages/*.astro file follows.
//
// Browse-only menu (Amar, Sept 2026 — "de klant wil opeens de menu pagina
// niet meer doorlinken naar het scherm. Het menu moet gewoon alleen
// visueel zijn"): no "add to cart"/ordering here anymore — the in-site
// cart + checkout (CartWidget.astro, src/lib/cart.ts) was removed
// sitewide. Prices still sync live from the staff screen's menu_items
// table (see the fetch below) so a price change or sold-out flag set in
// the restaurant still reaches this page — only the ability to actually
// order from it is gone. Ordering/booking now happens by phone, WhatsApp,
// or the reservation form (see ReservationContent.astro).
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import LogoWatermark from '../components/LogoWatermark.astro';
import FloralSprig from '../components/FloralSprig.astro';
import FormuleSpotlight from '../components/FormuleSpotlight.astro';
import { siteConfig } from '../config/site.config';
import { menuHighlights } from '../content/menu-highlights';
import { menuFormules } from '../content/menu-formules';
import { t, localizedPath, type Language } from '../i18n/languages';
import { common, place, nav } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = t(place.city, lang);

const copy = {
  metaTitle: {
    fr: `Menu — ${primaryKeyword} à ${city} | ${name}`,
    en: `Menu — ${primaryKeyword} in ${city} | ${name}`,
    ar: `القائمة — ${primaryKeyword} في ${city} | ${name}`,
  },
  // REPLACE — mention the actual dish categories once this client's menu
  // is filled in (menu-highlights.ts).
  metaDescription: {
    fr: `Découvrez le menu complet de ${name}, ${primaryKeyword} à ${city}.`,
    en: `Discover the full menu of ${name}, ${primaryKeyword} in ${city}.`,
    ar: `اكتشف القائمة الكاملة لـ${name}, ${primaryKeyword} في ${city}.`,
  },
  heroAlt: {
    fr: `Plats du menu de ${name}`,
    en: `Dishes from ${name}'s menu`,
    ar: `أطباق من قائمة ${name}`,
  },
  heroTitle: { fr: `Le menu de notre ${primaryKeyword}`, en: `Our ${primaryKeyword}'s menu`, ar: `قائمة ${primaryKeyword} الخاص بنا` },
  heroSubtitle: {
    fr: 'Une sélection de nos plats signature. Le menu complet, avec toutes les options et suppléments, est disponible sur place.',
    en: 'A selection of our signature dishes. The full menu, with all options and extras, is available in the restaurant.',
    ar: 'تشكيلة من أطباقنا المميزة. القائمة الكاملة، بجميع الخيارات والإضافات، متوفرة في المطعم.',
  },
  backToMenu: { fr: '↑ Retour au menu', en: '↑ Back to menu', ar: '↑ العودة إلى القائمة' },
  formulesTitle: { fr: 'Nos formules & moments', en: 'Our formules & moments', ar: 'عروضنا وأوقاتنا المميزة' },
  groupDrinksPastry: { fr: 'Boissons & Pâtisserie', en: 'Drinks & Pastries', ar: 'المشروبات والحلويات' },
  formulesSubtitle: {
    fr: "Selon le jour et l'heure — la réservation est recommandée.",
    en: 'Depending on the day and time — reservation is recommended.',
    ar: 'حسب اليوم والوقت — يُنصح بالحجز.',
  },
  // Heading for dishes added from the staff screen (see the
  // menu-extra-dishes section below) — deliberately generic rather than
  // naming a specific category, since this section can hold dishes from
  // several different categories at once.
  nouveautesTitle: { fr: 'Nouveautés', en: 'New', ar: 'جديد' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;
const reservationPath = localizedPath('/reservation', lang);

const menuJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Menu — ${name}`,
  hasMenuSection: menuHighlights.map((cat) => ({
    '@type': 'MenuSection',
    name: t(cat.label, lang),
    hasMenuItem: cat.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      description: t(item.description, lang),
      offers: { '@type': 'Offer', price: item.price, priceCurrency: siteConfig.identity.currency },
    })),
  })),
};

const path = localizedPath('/menu', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  jsonLd={menuJsonLd}
>
  <!-- Menu's own bolder opening moment — every interior page used the same
       compact PageHero, which made the whole site feel like one page
       repeated. Menu gets the exception: taller, with the same Ken Burns
       drift as the Home spotlight, since this is the page people actually
       linger on. Home stays the one full-height "big" hero — this is a
       step up from PageHero, not a rival to Home. -->
  <section class="relative min-h-[420px] sm:h-[64vh] flex items-end overflow-hidden" data-reveal="scale">
    <div class="ken-burns absolute inset-0">
      <img
        src="/images/gallery-3.webp"
        alt={t(copy.heroAlt, lang)}
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
    <!-- Same fix already proven on Home's own hero (see HomeContent.astro's
         comment above its vignette): this photo is naturally pale (white
         box, light background), so a light cream tint on top of it just
         washed the whole thing out instead of darkening it — the text
         color was the wrong half of the fix too, since dark-brown heading
         text only reads against that same light wash. Switching to a dark
         photographic vignette + near-white text keeps the photo crisp and
         still guarantees contrast for the title, the same approach used on
         Home instead of a one-off. -->
    <div class="absolute inset-0" style="background: linear-gradient(0deg, rgba(58,42,30,0.78) 0%, rgba(58,42,30,0.4) 45%, rgba(58,42,30,0.08) 75%, transparent 100%)"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-12 sm:pb-16 w-full">
      <span class="hero-shadow block text-[10px] font-bold uppercase tracking-[0.25em] mb-3" style="color: #F7F0DC">{city}</span>
      <h1 class="hero-shadow font-display text-3xl sm:text-5xl lg:text-6xl font-semibold" style="color: #FFFCF3">
        {t(copy.heroTitle, lang)}
      </h1>
      <p class="hero-shadow mt-4 max-w-xl text-sm sm:text-base" style="color: rgba(255,252,243,0.9)">
        {t(copy.heroSubtitle, lang)}
      </p>
    </div>
  </section>

  <!-- Filter (final punch-list item #3, extended) — a real, useful
       interaction, not decoration. The category chips act as a
       table-of-contents: clicking one jumps straight to that section
       further down the page instead of hiding everything else (that was
       the original behaviour; the client asked for a direct scroll
       instead, since the categories are always there in the normal page
       flow anyway). The "Végétarien" chip is the one true filter left —
       it's the one dietary fact readable straight off each dish's own
       description (see menu-highlights.ts's comment for why it doesn't go
       further, e.g. vegan/spice-level). The free-text search box that used
       to sit here was removed on the client's own request (Sept 2026:
       "Haal de functie rechercher un plat eruit. Dat heeft geen functie in
       de site.") — the category chips below already cover finding a dish,
       so the search box was pure decoration to them, not a used feature. -->
  <section id="menu-list" class="max-w-7xl mx-auto px-5 sm:px-8 pb-6 scroll-mt-24" data-reveal>
    <!-- Three-menu tab strip — this client runs three genuinely different
         menus on one page (savoury "Menu sur le pouce", the drinks/pâtisserie
         card, and the day/time formules further down), which used to read as
         one long list. These tabs group the category chips below by which
         menu they belong to, instead of adding a second, competing
         navigation system.

         Grid, not the horizontal-scroll strip used below for the (much
         longer) category-chip row: only 3 tabs live here, and the client
         asked for exactly these three to be visible at a glance on mobile
         instead of requiring a left/right swipe to see all of them (Sept
         2026 feedback, with a screenshot of the cut-off "Boisson…" tab).
         Equal thirds fit on any phone width; a tab's own label is allowed
         to wrap to two lines rather than truncate or force horizontal
         scroll back in. -->
    <div class="menu-group-row grid grid-cols-3 gap-2 mb-2">
      <button type="button" class="menu-group-btn" data-group="pouce" data-group-scroll={`cat-section-0`}>{t(menuHighlights[0].label, lang)}</button>
      <button type="button" class="menu-group-btn" data-group="drinks" data-group-scroll={`cat-section-1`}>{t(copy.groupDrinksPastry, lang)}</button>
      <button type="button" class="menu-group-btn" data-group="formules" data-group-scroll="formules-moments">{t(copy.formulesTitle, lang)}</button>
    </div>
    <div class="menu-filter-row flex items-center gap-2 overflow-x-auto">
      <button type="button" class="menu-filter-btn is-active shrink-0" data-filter="all">{t(common.toutLeMenu, lang)}</button>
      {menuHighlights.map((category, i) => (
        <button type="button" class="menu-filter-btn shrink-0" data-scroll-to={`cat-section-${i}`} data-group={i === 0 ? 'pouce' : 'drinks'}>{t(category.label, lang)}</button>
      ))}
      <button type="button" class="menu-filter-btn shrink-0" data-filter="vegetarian">🌱 {t(common.vegetarienUniquement, lang)}</button>
    </div>
  </section>

  <!-- Live "what's on right now" spotlight for the formules below — option
       1 of 3 presented to the client, approved. Fully standalone from the
       à-la-carte menu (its own section, its own data), matching the
       client's own framing that these day/time offers are "los staand". -->
  <FormuleSpotlight formules={menuFormules} anchorId="formules-moments" lang={lang} />

  <!-- Alternating band now goes warm (--color-primary-dark) instead of
       plain grey — the deep wine tone from the order-engine, applied
       here rather than À propos/Avis because it's food, and warmth fits
       a menu the way it doesn't fit an editorial about-page. -->
  {menuHighlights.map((category, i) => (
    <div id={`cat-section-${i}`} class={`scroll-mt-24 ${i % 2 === 1 ? 'section-tint-warm' : ''}`} data-menu-category data-cat-index={i}>
      <section class={`relative max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10 ${i === 0 || i === menuHighlights.length - 1 ? 'overflow-hidden' : ''}`}>
        {/* The client's own printed-menu sprig (see FloralSprig.astro), used
            just twice — opening and closing the à-la-carte list like a
            printed card's own corner flourish, not repeated on every
            category, which would turn a quiet accent into wallpaper. */}
        {i === 0 && <FloralSprig corner="top-right" />}
        {i === menuHighlights.length - 1 && <FloralSprig corner="bottom-left" size="w-40 sm:w-56" />}
        <div class="relative">
          <div>
            <h2
              class="font-display text-2xl font-semibold mb-5 pb-3 flex items-baseline gap-3"
              style="color: var(--color-text-primary); border-bottom: 1px solid var(--color-border)"
            >
              <span class="text-xs font-bold" style="color: var(--color-accent)">{String(i + 1).padStart(2, '0')}</span>
              {t(category.label, lang)}
            </h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {category.items.map((item, j) => (
                <div
                  class="js-menu-item card-lift flex items-start gap-4 rounded-xl p-4"
                  style={`background-color: ${i % 2 === 1 ? 'color-mix(in srgb, var(--color-primary-dark) 14%, var(--color-surface-muted))' : 'var(--color-surface)'}; border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
                  data-reveal
                  data-veg={item.vegetarian ? 'true' : 'false'}
                  data-item-key={item.name}
                  data-cat={i}
                  data-search={`${item.name} ${t(item.description, lang)}`.toLowerCase()}
                >
                  <div class="min-w-0 flex-1">
                    <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">
                      <span class="js-item-name">{item.name}</span>
                      {item.vegetarian && <span class="text-xs align-middle" title={t(common.vegetarienUniquement, lang)}>🌱</span>}
                      <span class="js-sold-out-badge hidden text-[10px] font-bold uppercase tracking-wide ml-2 px-2 py-0.5 rounded-full align-middle" style="background-color: var(--color-primary-dark); color: var(--color-surface)">
                        {t(common.epuise, lang)}
                      </span>
                    </h3>
                    <p class="js-item-desc text-sm mt-1" style="color: var(--color-text-muted)">{t(item.description, lang)}</p>
                  </div>
                  <div class="flex flex-col items-end gap-2 shrink-0">
                    <span class="js-item-price menu-item-price font-bold" style="color: var(--color-accent)">{item.price} {siteConfig.identity.currency}</span>
                  </div>
                </div>
              ))}
            </div>
            <a href="#menu-list" class="back-to-menu-link inline-block mt-5 text-xs font-bold">
              {t(copy.backToMenu, lang)}
            </a>
          </div>
        </div>
      </section>
    </div>
  ))}

  <p id="menu-no-results" class="hidden max-w-7xl mx-auto px-5 sm:px-8 py-10 text-sm text-center" style="color: var(--color-text-muted)">
    {t(common.aucunPlatTrouve, lang)}
  </p>

  <!-- Dishes added from the in-restaurant staff screen (menu_items rows
       with no matching static item_key — see supabase/schema.sql's
       comment on that table) — populated client-side by the
       menu-items-sync script below. Deliberately its own section outside
       the search/category-filter system above rather than injected into
       one of the menuHighlights.map(...) categories: those categories and
       the filter chips that drive them are static, built at build time,
       while this content can appear seconds after a staff member adds it.
       Bolting a live section onto a static filter index would mean either
       re-querying every DOM list the filter script already captured (see
       that script's own comment) or silently letting these dishes fall
       outside search/category filtering while still claiming to be
       filterable — same "don't half-support something" standard as the
       rest of this project. Hidden until the sync script finds at least
       one row. -->
  <section id="menu-extra-dishes" class="hidden max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10 scroll-mt-24">
    <h2 class="font-display text-2xl font-semibold mb-5 pb-3" style="color: var(--color-text-primary); border-bottom: 1px solid var(--color-border)">
      {t(copy.nouveautesTitle, lang)}
    </h2>
    <div id="menu-extra-dishes-grid" class="grid sm:grid-cols-2 gap-4"></div>
  </section>

  <!-- Formules & moments — the client's day/time-window offers (Good
       Morning brunch, Déjeuner Moë, Rfissa/Couscous, Soirées, weekend
       brunch, Gastronomie Dima Maghreb). Deliberately NOT rendered inside
       the menuHighlights loop above: these carry no fixed item list or
       price in the client's own PDF. Each card links to the reservation
       form instead, matching the source PDF's own "réservation
       recommandée" note (all the more true now the whole menu is
       browse-only — see the top of this file). -->
  <section id="formules-moments" class="relative max-w-7xl mx-auto px-5 sm:px-8 py-10 sm:py-14 scroll-mt-24 overflow-hidden" data-reveal>
    <LogoWatermark size="w-[22rem] h-[22rem]" />
    <div class="mb-8 max-w-2xl">
      <h2 class="font-display text-2xl sm:text-3xl font-semibold" style="color: var(--color-text-primary)">
        {t(copy.formulesTitle, lang)}
      </h2>
      <p class="text-sm mt-2" style="color: var(--color-text-muted)">{t(copy.formulesSubtitle, lang)}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {menuFormules.map((formule, i) => (
        <div
          class="card-lift rounded-xl p-5"
          style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 60}ms`}
          data-reveal
        >
          <span
            class="inline-block text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full mb-3"
            style="color: var(--color-background); background-color: var(--color-accent)"
          >
            {t(formule.schedule, lang)}
          </span>
          <h3 class="font-display font-semibold text-lg" style="color: var(--color-text-primary)">{t(formule.name, lang)}</h3>
          <p class="text-sm mt-2" style="color: var(--color-text-muted)">{t(formule.description, lang)}</p>
          {formule.tagline && (
            <p class="text-sm mt-2 italic" style="color: var(--color-primary)">{t(formule.tagline, lang)}</p>
          )}
        </div>
      ))}
    </div>
    <div class="mt-8">
      <Button href={reservationPath} variant="cta">{t(nav.reservation, lang)}</Button>
    </div>
  </section>
</Layout>

<style>
  /* Same text-shadow used on Home's hero (see HomeContent.astro) — Astro
     scopes <style> per file, so this can't be shared, just kept identical.
     Gives the near-white hero heading a hairline of separation from the
     photo without reading as a sticker/stroke effect. */
  .hero-shadow {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .menu-filter-row {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .menu-filter-row::-webkit-scrollbar {
    display: none;
  }
  /* Deliberately a different shape from .menu-filter-btn (rounded rectangle,
     uppercase, wider tracking vs. the pills below) so the hierarchy reads at
     a glance: these three group the menu, the pills below navigate within
     whichever menu is selected. Grid-of-3 (see the markup above) means each
     button's width is fixed by its column, not its own text — center the
     label and let it wrap onto a second line instead of overflowing or
     forcing the row into horizontal scroll. */
  .menu-group-btn {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.5rem 0.4rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    text-align: center;
    line-height: 1.25;
    white-space: normal;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  @media (min-width: 640px) {
    .menu-group-btn {
      font-size: 0.7rem;
      padding: 0.45rem 0.9rem;
    }
  }
  .menu-group-btn.is-active {
    color: var(--color-background);
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .menu-group-btn:not(.is-active):hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .menu-filter-btn.is-group-hidden {
    display: none;
  }
  .menu-filter-btn {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background-color: transparent;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .menu-filter-btn.is-active {
    color: var(--color-background);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .menu-filter-btn:not(.is-active):hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .back-to-menu-link {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .back-to-menu-link:hover {
    color: var(--color-accent);
  }
</style>

<script>
  // Client-side only, no reload — see the filter section's comment above
  // for why this exists. Wrapped in 'astro:page-load' (same pattern as
  // Layout.astro's sitewide scripts) so this re-initializes correctly if
  // the Menu page is reached via a View Transitions client-side
  // navigation, not just a hard load.
  document.addEventListener('astro:page-load', () => {
    const filterButtons = document.querySelectorAll('.menu-filter-btn');
    const groupButtons = document.querySelectorAll('.menu-group-btn');
    if (!filterButtons.length) return;

    const items = document.querySelectorAll('[data-veg]');
    const categories = document.querySelectorAll('[data-menu-category]');
    const noResults = document.getElementById('menu-no-results');
    const categoryChips = document.querySelectorAll('.menu-filter-btn[data-group]');

    let activeFilter = 'all';

    // Any direct interaction with the chip row below (a category chip, "Tout
    // le menu", or "Végétarien") means the visitor wants the full picture
    // again — clear whichever group tab was narrowing the chip row so it
    // doesn't silently keep hiding categories.
    function resetGroupView() {
      groupButtons.forEach((b) => b.classList.remove('is-active'));
      categoryChips.forEach((c) => c.classList.remove('is-group-hidden'));
    }

    function applyFilters() {
      let anyVisible = false;

      items.forEach((item) => {
        const isVeg = item.getAttribute('data-veg') === 'true';
        const catIndex = item.getAttribute('data-cat');
        const show =
          activeFilter === 'all' ||
          (activeFilter === 'vegetarian' && isVeg) ||
          activeFilter === `cat-${catIndex}`;
        item.style.display = show ? '' : 'none';
        if (show) anyVisible = true;
      });

      categories.forEach((cat) => {
        const hasVisibleItem = Array.from(cat.querySelectorAll('[data-veg]')).some((item) => item.style.display !== 'none');
        cat.style.display = hasVisibleItem ? '' : 'none';
      });

      if (noResults) noResults.classList.toggle('hidden', anyVisible);
    }

    const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    filterButtons.forEach((btn) => {
      const scrollTargetId = btn.getAttribute('data-scroll-to');

      // Category chips (e.g. "Menu sur le pouce") are a table-of-contents,
      // not a filter — clicking one resets any active filter/search (so the
      // section you land on is guaranteed to actually show its dishes) and
      // scrolls straight to it, instead of hiding every other category the
      // way "Tout le menu" / "Végétarien" still do below.
      if (scrollTargetId) {
        btn.addEventListener('click', () => {
          resetGroupView();
          activeFilter = 'all';
          filterButtons.forEach((b) => b.classList.remove('is-active'));
          document.querySelector('.menu-filter-btn[data-filter="all"]')?.classList.add('is-active');
          applyFilters();

          document.getElementById(scrollTargetId)?.scrollIntoView({ behavior: scrollBehavior });
        });
        return;
      }

      btn.addEventListener('click', () => {
        resetGroupView();
        filterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        activeFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    // Group tabs — narrow the category-chip row to the selected menu and
    // jump to it, instead of hiding items like the "Tout le menu" /
    // "Végétarien" filters do (a group is a set of whole categories, not a
    // dish-level filter).
    groupButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.getAttribute('data-group');
        const scrollTarget = btn.getAttribute('data-group-scroll');

        groupButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        if (group === 'formules') {
          categoryChips.forEach((c) => c.classList.remove('is-group-hidden'));
        } else {
          categoryChips.forEach((c) => {
            c.classList.toggle('is-group-hidden', c.getAttribute('data-group') !== group);
          });
          activeFilter = 'all';
          filterButtons.forEach((b) => b.classList.remove('is-active'));
          document.querySelector('.menu-filter-btn[data-filter="all"]')?.classList.add('is-active');
          applyFilters();
        }

        if (scrollTarget) document.getElementById(scrollTarget)?.scrollIntoView({ behavior: scrollBehavior });
      });
    });

    // "Back to menu" link under each category — same scroll-to-top-of-list
    // behaviour, but doesn't need the filter reset above since it never
    // changes what's currently shown.
    document.querySelectorAll('.back-to-menu-link').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        document.getElementById('menu-list')?.scrollIntoView({ behavior: scrollBehavior });
      });
    });

    applyFilters();
  });
</script>

<script
  define:vars={{
    supabaseUrl: siteConfig.ordering.supabaseUrl,
    supabaseAnonKey: siteConfig.ordering.supabaseAnonKey,
    currency: siteConfig.identity.currency,
  }}
>
  // Applies staff-screen changes from the `menu_items` table on top of the
  // statically-rendered menu — see the long comment on that table in
  // supabase/schema.sql. Two different kinds of row, both fetched in one
  // request:
  //   1. Overrides of an EXISTING static dish (item_key matches a card
  //      already on the page, row.name is null) — sold-out / price edits,
  //      applied onto that card in place, same as before.
  //   2. Brand new dishes ADDED from the staff screen (row.name is set,
  //      item_key is a slug the staff screen generated, doesn't match any
  //      static card) — rendered as extra cards in the #menu-extra-dishes
  //      section below the normal categories (see that section's own
  //      comment for why it's separate from the search/filter system).
  //
  // Safe no-op until siteConfig.ordering.supabaseUrl/supabaseAnonKey are
  // set, and safe to fail silently on a flaky connection: worst case the
  // customer just sees the site's normal static menu with no staff-screen
  // changes applied.
  document.addEventListener('astro:page-load', () => {
    if (!supabaseUrl || !supabaseAnonKey) return;

    fetch(`${supabaseUrl}/rest/v1/menu_items?select=item_key,name,description,category,price,available,station`, {
      headers: { apikey: supabaseAnonKey, Authorization: `Bearer ${supabaseAnonKey}` },
    })
      .then((res) => (res.ok ? res.json() : []))
      .then((rows) => {
        // Which rows are an OVERRIDE of a dish this page already rendered
        // vs a BRAND NEW dish added from the staff screen used to be "does
        // it carry a name" — an override never used to set one. Now the
        // staff screen also lets staff rename/re-describe an existing
        // dish, so an override row carries a name too; the real
        // distinguisher is whether its item_key matches a card already on
        // this page (a real static item_key), read straight from the DOM
        // this page just rendered rather than duplicating that list here.
        const staticKeys = new Set(
          [...document.querySelectorAll('.js-menu-item[data-item-key]')].map((el) => el.getAttribute('data-item-key'))
        );
        applyStaticOverrides(rows.filter((r) => staticKeys.has(r.item_key)));
        renderExtraDishes(rows.filter((r) => !staticKeys.has(r.item_key)));
      })
      .catch(() => {
        // Network hiccup or Supabase not reachable — site keeps working
        // with its normal static prices, deliberately no error shown.
      });

    function applyStaticOverrides(overrideRows) {
      const cards = document.querySelectorAll('.js-menu-item');
      if (!cards.length) return;
      const overrides = new Map(overrideRows.map((row) => [row.item_key, row]));
      cards.forEach((card) => {
        const key = card.getAttribute('data-item-key');
        const override = key ? overrides.get(key) : null;
        if (!override) return;

        if (override.available === false) {
          card.querySelector('.js-sold-out-badge')?.classList.remove('hidden');
          card.style.opacity = '0.55';
        }
        if (override.price != null) {
          const priceEl = card.querySelector('.js-item-price');
          if (priceEl) priceEl.textContent = `${override.price} ${currency}`;
        }
        // Renamed/re-described from the staff screen — the join key
        // (data-item-key) never changes, only what's displayed.
        let nameText = null;
        let descText = null;
        if (override.name) {
          const nameEl = card.querySelector('.js-item-name');
          if (nameEl) nameEl.textContent = override.name;
          nameText = override.name;
        }
        if (override.description != null) {
          const descEl = card.querySelector('.js-item-desc');
          if (descEl) descEl.textContent = override.description;
          descText = override.description;
        }
        if (nameText || descText) {
          // Keep the search box matching the text actually on screen —
          // it was built from the static copy at render time and won't
          // otherwise know a title/description changed.
          const currentName = card.querySelector('.js-item-name')?.textContent || '';
          const currentDesc = card.querySelector('.js-item-desc')?.textContent || '';
          card.setAttribute('data-search', `${currentName} ${currentDesc}`.toLowerCase());
        }
      });
    }

    function escapeHtml(str) {
      return String(str ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function renderExtraDishes(customRows) {
      const available = customRows.filter((r) => r.available !== false);
      if (!available.length) return;
      const section = document.getElementById('menu-extra-dishes');
      const grid = document.getElementById('menu-extra-dishes-grid');
      if (!section || !grid) return;

      grid.innerHTML = available
        .map((row) => {
          const search = `${row.name} ${row.description || ''}`.toLowerCase();
          return `
            <div class="js-menu-item card-lift flex items-start gap-4 rounded-xl p-4" style="background-color: var(--color-surface); border: 1px solid var(--color-border)" data-item-key="${escapeHtml(row.item_key)}" data-search="${escapeHtml(search)}">
              <div class="min-w-0 flex-1">
                <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)"><span class="js-item-name">${escapeHtml(row.name)}</span></h3>
                ${row.description ? `<p class="js-item-desc text-sm mt-1" style="color: var(--color-text-muted)">${escapeHtml(row.description)}</p>` : ''}
                ${row.category ? `<p class="text-xs mt-1 uppercase tracking-wide" style="color: var(--color-accent)">${escapeHtml(row.category)}</p>` : ''}
              </div>
              <div class="flex flex-col items-end gap-2 shrink-0">
                <span class="js-item-price menu-item-price font-bold" style="color: var(--color-accent)">${row.price != null ? row.price : '—'} ${currency}</span>
              </div>
            </div>
          `;
        })
        .join('');

      section.classList.remove('hidden');
    }
  });
</script>
