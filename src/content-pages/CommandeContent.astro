        { id: 'pa-eclair-framboise', cat: 'patisserie', station: 'cuisine', sub: 'Éclairs', name: 'Éclair Framboise', price: 38 },
        { id: 'pa-eclair-citron', cat: 'patisserie', station: 'cuisine', sub: 'Éclairs', name: 'Éclair Citron', price: 38 },
