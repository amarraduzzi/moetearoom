---
// Commande à table (QR code sur chaque table), v1 — Sept 2026.
//
// Deliberately NOT built on Layout.astro: this is a focused ordering
// screen meant to be scanned and used at the table, not a marketing page,
// so it skips Header/Footer/WhatsApp entirely and ships its own minimal
// <html> document (same idea as staff-screen/index.html and public/screen
// living outside the Layout-wrapped page tree).
//
// One QR code is printed for every table (not one per table) — the page
// asks the customer to type their table number on arrival instead of
// encoding it in the link (see the #gate overlay below).
//
// Writes real orders into the SAME `orders` table CartWidget.astro used to
// write to before the in-site cart was removed sitewide from the main menu
// (Amar, Sept 2026 — "het menu moet gewoon alleen visueel zijn"). That
// removal only affected the marketing site's Menu page; the Supabase
// project, its `orders` table/RLS policies, and the staff screen at
// /screen were never torn down — this page reconnects to that same
// existing backend rather than rebuilding it, so orders placed here appear
// live on /screen exactly the way they did before. Insert pattern (POST to
// {supabaseUrl}/rest/v1/orders, apikey + Authorization headers, fire on
// submit) is copied from CartWidget.astro's checkout handler.
//
// FR-only for this first version — the rest of the site is FR/EN/AR but a
// table-side ordering screen doesn't need to wait on a full trilingual
// pass to be useful; `lang` is threaded through anyway so EN/AR can be
// added later without restructuring this file.
import { siteConfig } from '../config/site.config';
import type { Language } from '../i18n/languages';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name: restaurantName } = siteConfig.identity;
const { currency: currencyCode } = siteConfig.identity;
const { supabaseUrl, supabaseAnonKey } = siteConfig.ordering;
---
<!doctype html>
<html lang={lang} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Commande à table — {restaurantName}</title>
  <meta name="description" content="Commandez directement depuis votre table par QR code." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600;6..96,700&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    /* is:global — most of this page's DOM (menu cards, cart lines,
       category nav) is built client-side via document.createElement /
       innerHTML in the script below, and Astro's default scoped styles
       only tag elements present in the static build-time template with
       the data-astro-cid attribute its compiled selectors match against.
       Scoped mode would silently drop every rule below for anything the
       script renders — global is correct and safe here since this is a
       standalone document that shares no DOM with any other page. */
    :root {
      --bg: #F7F0DC;
      --surface: #FFFCF3;
      --surface-2: #EFE4C4;
      --text: #3A2A1E;
      --text-muted: #7A6A57;
      --border: rgba(58,42,30,0.14);
      --accent: #3F5D45;
      --accent-soft: #E4EADD;
      --brown: #6B4A34;
      --danger: #B3492F;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, .display { font-family: 'Bodoni Moda', Georgia, serif; }
    img { max-width: 100%; }
    button { font-family: inherit; cursor: pointer; }
    .tabular { font-variant-numeric: tabular-nums; }

    /* ---------- header ---------- */
    .topbar {
      position: sticky;
      top: env(safe-area-inset-top, 0px);
      z-index: 30;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .topbar-inner {
      max-width: 720px;
      margin: 0 auto;
      padding: 14px 16px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .wordmark {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-weight: 600;
      font-size: 1.5rem;
      letter-spacing: 0.02em;
      color: var(--text);
      line-height: 1;
    }
    .wordmark small {
      display: block;
      font-family: 'Inter', sans-serif;
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.28em;
      color: var(--accent);
      margin-top: 3px;
    }
    .table-chip {
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 7px 14px;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text);
      white-space: nowrap;
      cursor: pointer;
    }
    .table-chip:active { background: var(--surface-2); }
    .table-chip .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
    }
    .draft-banner {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 16px 10px;
      font-size: 0.72rem;
      line-height: 1.4;
      color: var(--text-muted);
    }
    .draft-banner strong { color: var(--text); }

    /* ---------- category nav ---------- */
    .catnav {
      position: sticky;
      top: calc(env(safe-area-inset-top, 0px) + 62px);
      z-index: 29;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding-block: 10px;
    }
    .catnav-scroll {
      max-width: 720px;
      margin: 0 auto;
      padding-inline: 16px;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .catnav-scroll::-webkit-scrollbar { display: none; }
    .catpill {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .catpill.is-active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--surface);
    }
    .catpill svg { width: 14px; height: 14px; flex-shrink: 0; }

    /* ---------- main ---------- */
    main {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 16px 140px;
    }
    section.category {
      padding-block: 28px 8px;
      scroll-margin-top: 140px;
    }
    .cat-head {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 4px;
    }
    .cat-head svg { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; }
    .cat-head h2 {
      font-size: 1.4rem;
      font-weight: 600;
      margin: 0;
      text-wrap: balance;
    }
    .cat-sub {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 4px 0 16px;
      max-width: 60ch;
      line-height: 1.5;
    }
    .combo-banner {
      background: var(--accent-soft);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 0.78rem;
      color: var(--text);
      margin-bottom: 16px;
      display: flex;
      gap: 8px;
      align-items: flex-start;
      line-height: 1.5;
    }
    .combo-banner svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; color: var(--accent); }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    @media (max-width: 420px) {
      .card-grid { grid-template-columns: 1fr; }
    }
    .item-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .item-tile {
      aspect-ratio: 4 / 3;
      border-radius: 10px;
      background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 20%, var(--surface-2)), var(--surface-2));
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .item-tile svg { width: 30px; height: 30px; color: var(--accent); opacity: 0.75; }
    .item-tile img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .item-name {
      font-weight: 700;
      font-size: 0.92rem;
      line-height: 1.25;
    }
    .item-desc {
      font-size: 0.76rem;
      color: var(--text-muted);
      line-height: 1.4;
      flex: 1;
    }
    .item-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 2px;
    }
    .item-price {
      font-weight: 700;
      font-size: 0.88rem;
      font-family: 'Bodoni Moda', Georgia, serif;
    }

    .subgroup-label {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 18px 0 8px;
    }
    .subgroup-label:first-child { margin-top: 0; }
    .row-list { display: flex; flex-direction: column; gap: 6px; }
    .item-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
    }
    .item-row .item-name { font-size: 0.85rem; }
    .item-row .item-desc { font-size: 0.72rem; margin-top: 1px; }
    .row-main { flex: 1; min-width: 0; }
    .row-price {
      font-weight: 700;
      font-size: 0.82rem;
      font-family: 'Bodoni Moda', Georgia, serif;
      white-space: nowrap;
    }

    .stepper {
      display: flex;
      align-items: center;
      gap: 0;
      border: 1px solid var(--border);
      border-radius: 999px;
      overflow: hidden;
      background: var(--surface);
      flex-shrink: 0;
    }
    .stepper button {
      width: 26px; height: 26px;
      display: flex; align-items: center; justify-content: center;
      background: none; border: none; color: var(--text);
      font-size: 1rem;
      line-height: 1;
    }
    .stepper button:active { background: var(--surface-2); }
    .stepper .qty {
      min-width: 18px;
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
    }
    .add-btn {
      width: 26px; height: 26px;
      border-radius: 999px;
      border: none;
      background: var(--accent);
      color: var(--surface);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .add-btn svg { width: 14px; height: 14px; }

    .cart-fab {
      position: fixed;
      left: 50%;
      transform: translateX(-50%);
      bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--brown);
      color: var(--surface);
      border: none;
      border-radius: 999px;
      padding: 13px 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      font-weight: 700;
      font-size: 0.88rem;
      max-width: calc(100% - 32px);
    }
    .cart-fab[hidden] { display: none; }
    .cart-fab .badge {
      background: var(--surface);
      color: var(--brown);
      border-radius: 999px;
      min-width: 20px;
      height: 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.72rem;
      padding: 0 5px;
    }
    .cart-fab .total { font-family: 'Bodoni Moda', Georgia, serif; }

    .sheet-overlay {
      position: fixed; inset: 0;
      background: rgba(20,14,8,0.45);
      z-index: 50;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    .sheet-overlay.is-open { opacity: 1; pointer-events: auto; }

    .sheet {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      z-index: 51;
      background: var(--bg);
      border-radius: 20px 20px 0 0;
      max-height: 82vh;
      display: flex;
      flex-direction: column;
      transform: translateY(100%);
      transition: transform 0.25s cubic-bezier(0.16,1,0.3,1);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .sheet.is-open { transform: translateY(0); }
    .sheet-handle {
      width: 36px; height: 4px;
      background: var(--border);
      border-radius: 999px;
      margin: 10px auto 4px;
    }
    .sheet-head {
      padding: 8px 20px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .sheet-head h3 { margin: 0; font-size: 1.15rem; }
    .sheet-close {
      background: none; border: none; color: var(--text-muted);
      font-size: 1.3rem; line-height: 1; padding: 4px;
    }
    .sheet-body {
      overflow-y: auto;
      padding: 12px 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .cart-line {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-block: 8px;
      border-bottom: 1px solid var(--border);
    }
    .cart-line-main { flex: 1; min-width: 0; }
    .cart-line-name { font-weight: 700; font-size: 0.86rem; }
    .cart-line-price { font-size: 0.74rem; color: var(--text-muted); }
    .cart-empty {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
      padding: 30px 10px;
    }
    .sheet-foot {
      border-top: 1px solid var(--border);
      padding: 14px 20px calc(16px + env(safe-area-inset-bottom, 0px));
      background: var(--surface);
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 12px;
    }
    .total-row .label { font-size: 0.85rem; color: var(--text-muted); }
    .total-row .value { font-family: 'Bodoni Moda', Georgia, serif; font-size: 1.3rem; font-weight: 700; }
    .send-btn {
      width: 100%;
      background: var(--accent);
      color: var(--surface);
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-weight: 700;
      font-size: 0.92rem;
    }
    .send-btn:disabled { opacity: 0.5; }
    .send-error {
      color: var(--danger);
      font-size: 0.76rem;
      margin: 10px 0 0;
      line-height: 1.4;
    }

    .confirm-view {
      padding: 30px 20px 10px;
      text-align: center;
    }
    .confirm-icon {
      width: 52px; height: 52px;
      border-radius: 50%;
      background: var(--accent-soft);
      color: var(--accent);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 14px;
    }
    .confirm-icon svg { width: 26px; height: 26px; }
    .confirm-view h3 { margin: 0 0 6px; }
    .confirm-view p { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 18px; }
    .confirm-close {
      background: var(--brown);
      color: var(--surface);
      border: none;
      border-radius: 999px;
      padding: 11px 22px;
      font-weight: 700;
      font-size: 0.85rem;
    }

    /* ---------- table gate ---------- */
    .gate-overlay {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      padding-block: calc(24px + env(safe-area-inset-top, 0px)) calc(24px + env(safe-area-inset-bottom, 0px));
    }
    .gate-card {
      width: 100%;
      max-width: 340px;
      text-align: center;
    }
    .gate-wordmark {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-weight: 600;
      font-size: 2rem;
      color: var(--text);
      margin-bottom: 4px;
    }
    .gate-eyebrow {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.26em;
      color: var(--accent);
      margin-bottom: 26px;
    }
    .gate-question {
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .gate-hint {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 20px;
      line-height: 1.5;
    }
    .gate-input {
      width: 100%;
      text-align: center;
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: 2.4rem;
      font-weight: 600;
      color: var(--text);
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      padding: 14px 10px;
      margin-bottom: 16px;
    }
    .gate-input::-webkit-outer-spin-button,
    .gate-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .gate-input:focus {
      outline: none;
      border-color: var(--accent);
    }
    .gate-btn {
      width: 100%;
      background: var(--accent);
      color: var(--surface);
      border: none;
      border-radius: 12px;
      padding: 15px;
      font-weight: 700;
      font-size: 0.95rem;
    }
    .gate-btn:disabled { opacity: 0.4; }
    .gate-note {
      margin-top: 18px;
      font-size: 0.7rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    [hidden] { display: none !important; }
  </style>
</head>
<body>
  <div class="gate-overlay" id="gate">
    <div class="gate-card">
      <div class="gate-wordmark">Moë</div>
      <div class="gate-eyebrow">COMMANDE À TABLE</div>
      <p class="gate-question">Quel est votre numéro de table ?</p>
      <p class="gate-hint">Il est indiqué sur le socle du QR code, sur votre table.</p>
      <input class="gate-input" id="gate-input" type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="3" placeholder="—" autocomplete="off">
      <button class="gate-btn" id="gate-btn" disabled>Voir le menu</button>
      <p class="gate-note">Version test : votre commande est envoyée en direct à l'équipe.</p>
    </div>
  </div>

  <header class="topbar">
    <div class="topbar-inner">
      <div class="wordmark">Moë<small>COMMANDE À TABLE</small></div>
      <button class="table-chip" id="table-chip-btn" type="button"><span class="dot"></span><span id="table-label">Table —</span></button>
    </div>
    <p class="draft-banner"><strong>Version test.</strong> Les commandes envoyées apparaissent en direct sur l'écran du personnel (bar &amp; cuisine). Les photos des autres sections arrivent au fur et à mesure.</p>
  </header>

  <nav class="catnav">
    <div class="catnav-scroll" id="catnav"></div>
  </nav>

  <main id="main"></main>

  <button class="cart-fab" id="cart-fab" hidden>
    <span class="badge" id="fab-count">0</span>
    <span>Voir la commande</span>
    <span class="total tabular" id="fab-total">0</span>
  </button>

  <div class="sheet-overlay" id="overlay"></div>
  <div class="sheet" id="sheet">
    <div class="sheet-handle"></div>
    <div id="sheet-order-view">
      <div class="sheet-head">
        <h3>Votre commande</h3>
        <button class="sheet-close" id="sheet-close" aria-label="Fermer">✕</button>
      </div>
      <div class="sheet-body" id="cart-lines"></div>
      <div class="sheet-foot">
        <div class="total-row">
          <span class="label">Total</span>
          <span class="value tabular" id="sheet-total">0</span>
        </div>
        <button class="send-btn" id="send-btn" disabled>Envoyer la commande</button>
        <p class="send-error" id="send-error" hidden>Un problème est survenu lors de l'envoi. Réessayez, ou appelez un membre de l'équipe.</p>
      </div>
    </div>
    <div id="sheet-confirm-view" hidden>
      <div class="confirm-view">
        <div class="confirm-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg>
        </div>
        <h3 class="display">Commande envoyée</h3>
        <p id="confirm-detail">L'équipe a reçu votre commande.</p>
        <button class="confirm-close" id="confirm-close">Fermer</button>
      </div>
    </div>
  </div>

  <script define:vars={{ supabaseUrl, supabaseAnonKey, currencyCode }}>
    window.__moeCommandeConfig = { supabaseUrl, supabaseAnonKey, currencyCode };
  </script>
  <script>
    (function () {
      var SUPABASE_URL = window.__moeCommandeConfig.supabaseUrl;
      var SUPABASE_ANON_KEY = window.__moeCommandeConfig.supabaseAnonKey;
      var CURRENCY_CODE = window.__moeCommandeConfig.currencyCode || 'MAD';

      // ---------------------------------------------------------------------
      // Icons — one simple line-icon per category, reused as the placeholder
      // tile art until real photography exists.
      // ---------------------------------------------------------------------
      var ICONS = {
        breakfast: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="7"/><path d="M12 6V3M9 3h6"/></svg>',
        brunch: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0016 0"/><path d="M2 12h20M7 12V7a5 5 0 0110 0v5"/></svg>',
        sandwich: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M4 11h16l-1.5 8h-13z"/><path d="M4 15h16"/></svg>',
        pancake: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="8" rx="8" ry="2.2"/><ellipse cx="12" cy="12.5" rx="8" ry="2.2"/><ellipse cx="12" cy="17" rx="8" ry="2.2"/></svg>',
