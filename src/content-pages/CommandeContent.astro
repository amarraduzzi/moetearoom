---
// Commande à table (QR code sur chaque table), v1 — Sept 2026.
//
// Deliberately NOT built on Layout.astro: this is a focused ordering
// screen meant to be scanned and used at the table, not a marketing page,
// so it skips Header/Footer/WhatsApp entirely and ships its own minimal
// <html> document (same idea as staff-screen/index.html and public/screen
// living outside the Layout-wrapped page tree).
//
// One QR code is printed for every table (not one per table) — the page
// asks the customer to type their table number on arrival instead of
// encoding it in the link (see the #gate overlay below).
//
// Writes real orders into the SAME `orders` table CartWidget.astro used to
// write to before the in-site cart was removed sitewide from the main menu
// (Amar, Sept 2026 — "het menu moet gewoon alleen visueel zijn"). That
// removal only affected the marketing site's Menu page; the Supabase
// project, its `orders` table/RLS policies, and the staff screen at
// /screen were never torn down — this page reconnects to that same
// existing backend rather than rebuilding it, so orders placed here appear
// live on /screen exactly the way they did before. Insert pattern (POST to
// {supabaseUrl}/rest/v1/orders, apikey + Authorization headers, fire on
// submit) is copied from CartWidget.astro's checkout handler.
//
// FR-only for this first version — the rest of the site is FR/EN/AR but a
// table-side ordering screen doesn't need to wait on a full trilingual
// pass to be useful; `lang` is threaded through anyway so EN/AR can be
// added later without restructuring this file.
import { siteConfig } from '../config/site.config';
import type { Language } from '../i18n/languages';
// Shared catalog with the marketing Menu page (see that file's own top
// comment on menu-catalog.ts) — this page is FR-only, so category labels
// (the only field on this shared type that carries all three languages)
// are flattened down to their French string below before reaching the
// page's own vanilla-JS script, which still treats `label` as plain text.
import { CATEGORIES as CATALOG_CATEGORIES, ITEMS as CATALOG_ITEMS } from '../content/menu-catalog';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name: restaurantName } = siteConfig.identity;
const { currency: currencyCode } = siteConfig.identity;
const { supabaseUrl, supabaseAnonKey } = siteConfig.ordering;

const catalogCategories = CATALOG_CATEGORIES.map((c) => ({
  id: c.id,
  label: c.label.fr,
  style: c.style,
  sub: c.sub ?? null,
  combo: c.combo ?? null,
}));
---
<!doctype html>
<html lang={lang} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Commande à table — {restaurantName}</title>
  <meta name="description" content="Commandez directement depuis votre table par QR code." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600;6..96,700&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    /* is:global — most of this page's DOM (menu cards, cart lines,
       category nav) is built client-side via document.createElement /
       innerHTML in the script below, and Astro's default scoped styles
       only tag elements present in the static build-time template with
       the data-astro-cid attribute its compiled selectors match against.
       Scoped mode would silently drop every rule below for anything the
       script renders — global is correct and safe here since this is a
       standalone document that shares no DOM with any other page. */
    :root {
      --bg: #F7F0DC;
      --surface: #FFFCF3;
      --surface-2: #EFE4C4;
      --text: #3A2A1E;
      --text-muted: #7A6A57;
      --border: rgba(58,42,30,0.14);
      --accent: #3F5D45;
      --accent-soft: #E4EADD;
      --brown: #6B4A34;
      --danger: #B3492F;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, .display { font-family: 'Bodoni Moda', Georgia, serif; }
    img { max-width: 100%; }
    button { font-family: inherit; cursor: pointer; }
    .tabular { font-variant-numeric: tabular-nums; }

    /* ---------- header ---------- */
    .topbar {
      position: sticky;
      top: env(safe-area-inset-top, 0px);
      z-index: 30;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    /* Same printed-menu sprig used sitewide (see FloralSprig.astro on the
       marketing pages, and the same hand-rolled pattern as .gate-floral /
       .confirm-floral further down) — this is the ONE header a customer
       sees on every screen of this page (sticky), so a quiet brand accent
       here does more for "does this feel like Moë" than anywhere else on
       the page. Sits behind the wordmark/table-chip, clipped to the bar's
       own height by .topbar's overflow:hidden so it never bleeds into the
       category content below. */
    .topbar-floral {
      position: absolute;
      top: -10px;
      right: -6px;
      width: 96px;
      height: auto;
      opacity: 0.12;
      pointer-events: none;
      z-index: 0;
    }
    .topbar-inner {
      position: relative;
      z-index: 1;
      max-width: 720px;
      margin: 0 auto;
      padding: 14px 16px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .wordmark {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      line-height: 1;
    }
    .wordmark-logo {
      height: 26px;
      width: auto;
      display: block;
    }
    .wordmark small {
      display: block;
      font-family: 'Inter', sans-serif;
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.28em;
      color: var(--accent);
    }
    .table-chip {
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 7px 14px;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text);
      white-space: nowrap;
      cursor: pointer;
    }
    .table-chip:active { background: var(--surface-2); }
    .table-chip .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
    }
    /* Was a full-weight paragraph sitting first on the page, right where a
       customer's eye lands — read as an internal QA note, not hospitality.
       Now a quiet, dismissible pill: one line, low visual weight, closes
       and stays closed for the session (matches how the rest of the page
       treats state — no persistence needed, it's a per-visit table). */
    .draft-banner {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 16px 10px;
      position: relative;
      z-index: 1;
    }
    .draft-banner[hidden] { display: none; }
    .draft-banner-inner {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--accent-soft);
      border-radius: 999px;
      padding: 6px 8px 6px 12px;
    }
    .draft-banner-inner svg {
      width: 14px; height: 14px;
      color: var(--accent);
      flex-shrink: 0;
    }
    .draft-banner-inner span {
      flex: 1;
      font-size: 0.68rem;
      line-height: 1.35;
      color: var(--accent);
    }
    .draft-banner-close {
      flex-shrink: 0;
      width: 20px; height: 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      color: var(--accent);
      font-size: 0.95rem;
      line-height: 1;
      opacity: 0.65;
    }
    .draft-banner-close:active { opacity: 1; background: rgba(0,0,0,0.06); }

    /* ---------- live order strip ----------
       Shows, as soon as the cart has items, a horizontally scrolling row
       of thumbnails for everything ordered so far — the "see what you've
       ordered" visual the table itself asked for, always visible without
       opening the cart sheet. --topbar-h / --strip-h are measured in JS
       (updateStickyOffsets) so the catnav below always stacks correctly
       whether or not the strip is showing. */
    .order-strip {
      position: sticky;
      top: calc(env(safe-area-inset-top, 0px) + var(--topbar-h, 62px));
      z-index: 29;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .order-strip[hidden] { display: none; }
    .order-strip-scroll {
      max-width: 720px;
      margin: 0 auto;
      padding: 9px 16px;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .order-strip-scroll::-webkit-scrollbar { display: none; }
    .order-chip {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 7px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 4px 12px 4px 4px;
      animation: chipIn 0.25s ease;
    }
    @keyframes chipIn {
      from { opacity: 0; transform: scale(0.85); }
      to { opacity: 1; transform: scale(1); }
    }
    .order-chip-thumb {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      background: var(--accent-soft);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .order-chip-thumb svg { width: 14px; height: 14px; color: var(--accent); }
    .order-chip-name {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text);
      max-width: 86px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .order-chip-qty {
      font-size: 0.68rem;
      font-weight: 800;
      color: var(--accent);
      font-family: 'Bodoni Moda', Georgia, serif;
    }

    /* ---------- category nav ---------- */
    .catnav {
      position: sticky;
      top: calc(env(safe-area-inset-top, 0px) + var(--topbar-h, 62px) + var(--strip-h, 0px));
      z-index: 28;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding-block: 10px;
    }
    .catnav-scroll {
      max-width: 720px;
      margin: 0 auto;
      padding-inline: 16px;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      /* Chips used to look cut off mid-word at the viewport edge with no
         hint that the row scrolls — a soft fade on both edges reads as
         "there's more" instead of "this is broken". */
      mask-image: linear-gradient(to right, transparent 0, black 18px, black calc(100% - 28px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0, black 18px, black calc(100% - 28px), transparent 100%);
    }
    .catnav-scroll::-webkit-scrollbar { display: none; }

    /* ---------- search + dietary filters ---------- */
    .filter-row {
      max-width: 720px;
      margin: 8px auto 0;
      padding-inline: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }
    .search-wrap {
      position: relative;
      flex: 1 1 200px;
      min-width: 140px;
    }
    .search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      width: 15px;
      height: 15px;
      color: var(--text-muted);
      pointer-events: none;
    }
    .search-input {
      width: 100%;
      padding: 8px 30px 8px 32px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 0.82rem;
      font-family: inherit;
    }
    .search-input:focus { outline: none; border-color: var(--accent); }
    .search-input::placeholder { color: var(--text-muted); }
    .search-clear {
      position: absolute;
      right: 6px;
      top: 50%;
      transform: translateY(-50%);
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      background: transparent;
    }
    .search-clear svg { width: 12px; height: 12px; }
    .diet-chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .diet-chip {
      flex-shrink: 0;
      padding: 7px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-muted);
      font-size: 0.74rem;
      font-weight: 700;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .diet-chip.is-active {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent);
    }
    .filter-disclaimer {
      max-width: 720px;
      margin: 6px auto 0;
      padding-inline: 16px;
      font-size: 0.68rem;
      color: var(--text-muted);
      text-align: center;
    }
    .no-results {
      max-width: 720px;
      margin: 40px auto;
      padding-inline: 16px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.88rem;
    }

    /* ---------- item badges & dietary tags on cards ---------- */
    .item-badge {
      position: absolute;
      top: 8px;
      left: 8px;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--surface);
      background: var(--accent);
      z-index: 1;
    }
    .item-badge.badge-chef { background: var(--brown); }
    .item-row-badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 0.6rem;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--surface);
      background: var(--accent);
      margin-left: 6px;
      vertical-align: middle;
    }
    .item-row-badge.badge-chef { background: var(--brown); }
    .item-tags {
      font-size: 0.66rem;
      color: var(--accent);
      font-weight: 600;
      margin-top: -2px;
    }
    .catpill {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .catpill.is-active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--surface);
    }
    .catpill svg { width: 14px; height: 14px; flex-shrink: 0; }

    /* ---------- main ---------- */
    main {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 16px 140px;
    }
    section.category, .plate-builder {
      /* Kept in sync with the actual sticky header stack (topbar + live
         order strip + catnav) via JS, instead of a hardcoded guess — the
         strip's height changes as the cart fills, so a fixed value would
         drift and tuck section headings (or the plate dock's scroll
         target) behind the sticky bars. Applied to .plate-builder too,
         since the plate dock scrolls straight to that element rather
         than to the whole section. */
      scroll-margin-top: calc(env(safe-area-inset-top, 0px) + var(--topbar-h, 62px) + var(--strip-h, 0px) + var(--catnav-h, 54px) + 12px);
    }
    section.category {
      padding-block: 18px 8px;
    }
    .cat-head {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 4px;
    }
    .cat-head svg { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; }
    .cat-head h2 {
      font-size: 1.4rem;
      font-weight: 600;
      margin: 0;
      text-wrap: balance;
    }
    .cat-sub {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 4px 0 16px;
      max-width: 60ch;
      line-height: 1.5;
    }
    /* ---------- plate builder ----------
       Replaces the old text "combine these freely" banner on combo
       categories (breakfast, brunch): a plate graphic that fills with
       the customer's own dish photos, live, as they add things from
       this category. Slot positions are fixed per item index so a given
       dish always lands in the same spot on the plate. */
    /* Was a plain white card indistinguishable from the item cards below
       it, with a flat beige circle reading as an unfinished placeholder
       rather than the category's main call-to-action. Now a warm tinted
       card with an eyebrow label, and the circle reads as an empty plate
       waiting to be filled (dashed rim + fork/knife) instead of a blank
       disc — same underlying widget, same JS, just dressed for the job
       it's actually doing. */
    .plate-builder {
      position: relative;
      display: flex;
      align-items: center;
      gap: 16px;
      background: linear-gradient(135deg, var(--accent-soft) 0%, var(--surface) 68%);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 16px;
      margin-bottom: 16px;
    }
    .plate-visual {
      position: relative;
      width: 108px;
      height: 108px;
      border-radius: 50%;
      flex-shrink: 0;
      background: var(--surface);
      border: 2px dashed var(--accent);
      opacity: 0.85;
      box-shadow: 0 3px 10px rgba(0,0,0,0.06);
    }
    .plate-empty {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      text-align: center;
      color: var(--accent);
      line-height: 1.3;
      padding: 0 12px;
    }
    .plate-empty svg { width: 20px; height: 20px; opacity: 0.8; }
    .plate-empty span {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--text-muted);
    }
    .plate-empty[hidden] { display: none; }
    .plate-items { position: absolute; inset: 0; }
    .plate-slot {
      position: absolute;
      width: 30px;
      height: 30px;
      transform: translate(-50%, -50%);
    }
    .plate-slot-0 { left: 50%; top: 14%; }
    .plate-slot-1 { left: 76%; top: 24%; }
    .plate-slot-2 { left: 86%; top: 50%; }
    .plate-slot-3 { left: 76%; top: 76%; }
    .plate-slot-4 { left: 50%; top: 86%; }
    .plate-slot-5 { left: 24%; top: 76%; }
    .plate-slot-6 { left: 14%; top: 50%; }
    .plate-slot-7 { left: 24%; top: 24%; }
    .plate-slot img, .plate-slot .plate-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      background: var(--accent-soft);
      border: 2px solid var(--surface);
      box-shadow: 0 3px 8px rgba(0,0,0,0.2);
      animation: plateSlotIn 0.3s ease;
    }
    .plate-slot .plate-icon svg { width: 13px; height: 13px; color: var(--accent); }
    .plate-slot-qty {
      position: absolute;
      bottom: -3px;
      right: -3px;
      background: var(--accent);
      color: var(--surface);
      font-size: 0.55rem;
      font-weight: 800;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid var(--surface);
    }
    @keyframes plateSlotIn {
      from { transform: scale(0); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .plate-caption {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .plate-caption-title {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text);
    }
    .plate-caption-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.5;
    }
    .plate-caption-desc strong {
      color: var(--accent);
      font-weight: 800;
    }
    @media (prefers-reduced-motion: reduce) {
      .plate-slot img, .plate-slot .plate-icon { animation: none; }
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    @media (max-width: 420px) {
      .card-grid { grid-template-columns: 1fr; }
    }
    .item-card {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .item-tile {
      aspect-ratio: 4 / 3;
      border-radius: 10px;
      background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 20%, var(--surface-2)), var(--surface-2));
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .item-tile svg { width: 30px; height: 30px; color: var(--accent); opacity: 0.75; }
    .item-tile img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Bento layout: the first dish of every photographed category is
       promoted to a wide "hero" tile instead of matching the uniform
       grid — breaks the repeating-card monotony without needing any
       per-item authoring (it's always the category's opening dish). */
    .item-card.is-hero {
      grid-column: 1 / -1;
    }
    .item-card.is-hero .item-tile {
      aspect-ratio: 16 / 8;
    }
    .item-card.is-hero .item-name {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: 1.15rem;
      font-weight: 600;
    }
    .item-card.is-hero .item-desc { font-size: 0.82rem; }
    .item-name {
      font-weight: 700;
      font-size: 0.92rem;
      line-height: 1.25;
    }
    .item-desc {
      font-size: 0.76rem;
      color: var(--text-muted);
      line-height: 1.4;
      flex: 1;
    }
    .item-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 2px;
    }
    .item-price {
      font-weight: 700;
      font-size: 0.88rem;
      font-family: 'Bodoni Moda', Georgia, serif;
    }

    .subgroup-label {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 18px 0 8px;
    }
    .subgroup:first-child .subgroup-label { margin-top: 0; }
    /* Filtering hides a whole .subgroup (or .category) at once when none
       of its items match — see applyFilters() in the script below. */
    .subgroup[hidden], .category[hidden] { display: none; }
    .row-list { display: flex; flex-direction: column; gap: 6px; }
    .item-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
    }
    .item-row .item-name { font-size: 0.85rem; }
    .item-row .item-desc { font-size: 0.72rem; margin-top: 1px; }
    .row-main { flex: 1; min-width: 0; }
    .row-price {
      font-weight: 700;
      font-size: 0.82rem;
      font-family: 'Bodoni Moda', Georgia, serif;
      white-space: nowrap;
    }

    .stepper {
      display: flex;
      align-items: center;
      gap: 0;
      border: 1px solid var(--border);
      border-radius: 999px;
      overflow: hidden;
      background: var(--surface);
      flex-shrink: 0;
    }
    .stepper button {
      width: 26px; height: 26px;
      display: flex; align-items: center; justify-content: center;
      background: none; border: none; color: var(--text);
      font-size: 1rem;
      line-height: 1;
    }
    .stepper button:active { background: var(--surface-2); }
    .stepper .qty {
      min-width: 18px;
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
    }
    .add-btn {
      width: 26px; height: 26px;
      border-radius: 999px;
      border: none;
      background: var(--accent);
      color: var(--surface);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .add-btn svg { width: 14px; height: 14px; }

    .cart-fab {
      position: fixed;
      left: 50%;
      transform: translateX(-50%);
      bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--brown);
      color: var(--surface);
      border: none;
      border-radius: 999px;
      padding: 13px 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      font-weight: 700;
      font-size: 0.88rem;
      max-width: calc(100% - 32px);
    }
    .cart-fab[hidden] { display: none; }
    .cart-fab .badge {
      background: var(--surface);
      color: var(--brown);
      border-radius: 999px;
      min-width: 20px;
      height: 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.72rem;
      padding: 0 5px;
    }
    .cart-fab .total { font-family: 'Bodoni Moda', Georgia, serif; }
    .cart-fab.is-pulsing .badge { animation: fabBadgePulse 0.45s ease; }
    @keyframes fabBadgePulse {
      0% { transform: scale(1); }
      45% { transform: scale(1.4); }
      100% { transform: scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .cart-fab.is-pulsing .badge { animation: none; }
      .order-chip { animation: none; }
    }

    /* ---------- plate dock ----------
       Once the full plate-builder scrolls out of view (above the sticky
       header stack) while still inside its category, this small floating
       badge takes over: a miniature of the same plate, always in view,
       tappable to jump straight back to the full widget. Sits opposite
       the cart button so the two never collide. */
    .plate-dock {
      position: fixed;
      left: 16px;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
      z-index: 39;
      width: 76px;
      height: 76px;
      border-radius: 50%;
      border: none;
      padding: 0;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: plateDockIn 0.25s ease;
    }
    .plate-dock[hidden] { display: none; }
    @keyframes plateDockIn {
      from { opacity: 0; transform: scale(0.7); }
      to { opacity: 1; transform: scale(1); }
    }
    /* Same ring layout as the full plate-visual (identical .plate-slot-N
       percentage positions, reused as-is), just scaled down and with its
       own mini ceramic-plate backdrop — so the dock reads as a shrunk
       copy of the real thing rather than a different widget. */
    .plate-dock-visual {
      position: relative;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, var(--surface) 0%, var(--surface-2) 68%, var(--border) 100%);
      box-shadow: inset 0 2px 8px rgba(0,0,0,0.08), 0 8px 20px rgba(0,0,0,0.22);
    }
    .plate-dock-visual .plate-slot { width: 19px; height: 19px; }
    .plate-dock-visual .plate-slot-qty {
      width: 12px;
      height: 12px;
      font-size: 0.46rem;
      bottom: -2px;
      right: -2px;
    }
    .plate-dock-count {
      position: absolute;
      bottom: -2px;
      right: -2px;
      background: var(--accent);
      color: var(--surface);
      font-size: 0.62rem;
      font-weight: 800;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--bg);
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
    @media (prefers-reduced-motion: reduce) {
      .plate-dock { animation: none; }
    }

    .sheet-overlay {
      position: fixed; inset: 0;
      background: rgba(20,14,8,0.45);
      z-index: 50;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    .sheet-overlay.is-open { opacity: 1; pointer-events: auto; }

    .sheet {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      z-index: 51;
      background: var(--bg);
      border-radius: 20px 20px 0 0;
      max-height: 82vh;
      display: flex;
      flex-direction: column;
      transform: translateY(100%);
      transition: transform 0.25s cubic-bezier(0.16,1,0.3,1);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .sheet.is-open { transform: translateY(0); }
    .sheet-handle {
      width: 36px; height: 4px;
      background: var(--border);
      border-radius: 999px;
      margin: 10px auto 4px;
    }
    .sheet-head {
      padding: 8px 20px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .sheet-head h3 { margin: 0; font-size: 1.15rem; flex: 1; }
    .sheet-head-actions { display: flex; align-items: center; gap: 2px; }
    .sheet-close {
      background: none; border: none; color: var(--text-muted);
      font-size: 1.3rem; line-height: 1; padding: 4px 6px;
    }
    .clear-cart-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .clear-cart-btn svg { width: 19px; height: 19px; }
    .clear-cart-btn[hidden] { display: none; }
    .sheet-body {
      overflow-y: auto;
      padding: 12px 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .cart-line {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding-block: 8px;
      border-bottom: 1px solid var(--border);
    }
    .cart-line .qty-slot-cart { margin-top: 2px; }
    .cart-line-main { flex: 1; min-width: 0; }
    .cart-line-name { font-weight: 700; font-size: 0.86rem; }
    .cart-line-price { font-size: 0.74rem; color: var(--text-muted); margin-bottom: 6px; }
    .cart-line-note-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 6px; }
    .note-chip {
      font-size: 0.65rem;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 4px 9px;
      -webkit-tap-highlight-color: transparent;
    }
    .note-chip.is-active { color: var(--accent); border-color: var(--accent); }
    .note-input {
      width: 100%;
      font-size: 0.76rem;
      font-family: inherit;
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 7px 10px;
    }
    .note-input:focus { outline: none; border-color: var(--accent); }
    .note-input::placeholder { color: var(--text-muted); }
    .cart-empty {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
      padding: 30px 10px;
    }
    .pairing-suggestion {
      margin: 0 20px 14px;
      padding: 10px;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 14px;
    }
    .pairing-thumb {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      overflow: hidden;
      flex-shrink: 0;
      background: var(--surface);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }
    .pairing-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .pairing-body { flex: 1; min-width: 0; }
    .pairing-label { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em; color: var(--accent); text-transform: uppercase; }
    .pairing-name { font-size: 0.8rem; font-weight: 700; }
    .pairing-price { font-size: 0.72rem; color: var(--text-muted); }
    .pairing-add-btn {
      flex-shrink: 0;
      background: var(--accent);
      color: var(--surface);
      border: none;
      border-radius: 999px;
      width: 30px;
      height: 30px;
      font-size: 1.1rem;
      font-weight: 700;
      line-height: 1;
    }
    .sheet-foot {
      border-top: 1px solid var(--border);
      padding: 14px 20px calc(16px + env(safe-area-inset-bottom, 0px));
      background: var(--surface);
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 12px;
    }
    .total-row .label { font-size: 0.85rem; color: var(--text-muted); }
    .total-row .value { font-family: 'Bodoni Moda', Georgia, serif; font-size: 1.3rem; font-weight: 700; }
    .send-btn {
      width: 100%;
      background: var(--accent);
      color: var(--surface);
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-weight: 700;
      font-size: 0.92rem;
    }
    .send-btn:disabled { opacity: 0.5; }
    .send-error {
      color: var(--danger);
      font-size: 0.76rem;
      margin: 10px 0 0;
      line-height: 1.4;
    }
    .clear-confirm[hidden] { display: none; }
    .clear-confirm p {
      margin: 0 0 12px;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text);
      text-align: center;
    }
    .clear-confirm-actions {
      display: flex;
      gap: 10px;
    }
    .clear-cancel-btn, .clear-confirm-btn {
      flex: 1;
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-weight: 700;
      font-size: 0.9rem;
    }
    .clear-cancel-btn {
      background: var(--surface-2);
      color: var(--text);
    }
    .clear-confirm-btn {
      background: var(--danger);
      color: var(--surface);
    }

    .confirm-view {
      position: relative;
      overflow: hidden;
      padding: 30px 20px 10px;
      text-align: center;
    }
    /* Same sprig as the gate screen — the order-confirmation moment is the
       other quiet, non-functional beat in this page, a natural bookend to
       the numpad screen it opened on. */
    .confirm-floral {
      position: absolute;
      top: -12px;
      right: -14px;
      width: 92px;
      height: auto;
      opacity: 0.16;
      pointer-events: none;
      z-index: 0;
    }
    .confirm-icon {
      position: relative;
      z-index: 1;
      width: 52px; height: 52px;
      border-radius: 50%;
      background: var(--accent-soft);
      color: var(--accent);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 14px;
    }
    .confirm-icon svg { width: 26px; height: 26px; }
    .confirm-view h3 { position: relative; z-index: 1; margin: 0 0 6px; }
    .confirm-view p { position: relative; z-index: 1; color: var(--text-muted); font-size: 0.85rem; margin: 0 0 18px; }
    .confirm-close {
      background: var(--brown);
      color: var(--surface);
      border: none;
      border-radius: 999px;
      padding: 11px 22px;
      font-weight: 700;
      font-size: 0.85rem;
    }

    /* ---------- table gate ---------- */
    .gate-overlay {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      padding-block: calc(24px + env(safe-area-inset-top, 0px)) calc(24px + env(safe-area-inset-bottom, 0px));
      overflow: hidden;
    }
    /* Same printed-menu sprig used sitewide (see FloralSprig.astro on the
       marketing pages) — this page ships its own standalone <html> with
       no Tailwind/Layout, so it's hand-rolled here with plain CSS instead
       of that component. Quiet corner accent behind the numpad card, not
       inside it, so it never competes with the tap targets. */
    .gate-floral {
      position: absolute;
      bottom: -24px;
      right: -28px;
      width: 190px;
      height: auto;
      opacity: 0.16;
      pointer-events: none;
      z-index: 0;
    }
    .gate-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 340px;
      text-align: center;
    }
    .gate-logo {
      width: 160px;
      height: auto;
      margin: 0 auto 10px;
      display: block;
    }
    .gate-eyebrow {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.26em;
      color: var(--accent);
      margin-bottom: 26px;
    }
    .gate-question {
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .gate-hint {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 20px;
      line-height: 1.5;
    }
    .gate-display {
      width: 100%;
      text-align: center;
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: 2.4rem;
      font-weight: 600;
      color: var(--text);
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      padding: 14px 10px;
      margin-bottom: 14px;
      letter-spacing: 0.06em;
      transition: border-color 0.15s ease;
    }
    .gate-display.has-value { border-color: var(--accent); }
    .gate-numpad {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 16px;
    }
    .gate-key {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 0;
      -webkit-tap-highlight-color: transparent;
      transition: background 0.12s ease, transform 0.12s ease;
    }
    .gate-key:active { background: var(--surface-2); transform: scale(0.96); }
    .gate-key-clear,
    .gate-key-back {
      font-family: inherit;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--text-muted);
    }
    .gate-key-back { font-size: 1.1rem; }
    .gate-btn {
      width: 100%;
      background: var(--accent);
      color: var(--surface);
      border: none;
      border-radius: 12px;
      padding: 15px;
      font-weight: 700;
      font-size: 0.95rem;
    }
    .gate-btn:disabled { opacity: 0.4; }
    .gate-note {
      margin-top: 18px;
      font-size: 0.7rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* ---------- cinematic hero intro ----------
       Shown once, right after the table number is confirmed: a full-bleed
       shot of the room's food with the logo and a single tap-in, instead
       of dropping straight into a scrolling card grid. Sets the tone
       before the utilitarian ordering UI takes over. */
    .hero-intro {
      position: fixed;
      inset: 0;
      z-index: 65;
      opacity: 0;
      transition: opacity 0.45s ease;
    }
    .hero-intro[hidden] { display: none; }
    .hero-intro.is-visible { opacity: 1; }
    .hero-intro-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hero-intro-scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(20,14,8,0.35) 0%, rgba(20,14,8,0.05) 30%, rgba(20,14,8,0.15) 55%, rgba(20,14,8,0.92) 100%);
    }
    .hero-intro-content {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      text-align: center;
      padding: calc(env(safe-area-inset-top, 0px) + 32px) 28px calc(env(safe-area-inset-bottom, 0px) + 36px);
      transform: translateY(14px);
      transition: transform 0.55s ease;
    }
    .hero-intro.is-visible .hero-intro-content { transform: translateY(0); }
    .hero-intro-logo {
      width: 168px;
      height: auto;
      background: var(--surface);
      border-radius: 18px;
      padding: 14px 18px;
      box-shadow: 0 14px 34px rgba(0,0,0,0.35);
      margin-bottom: auto;
      margin-top: 6px;
    }
    .hero-intro-tag {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.82);
      margin-bottom: 8px;
    }
    .hero-intro-title {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-weight: 600;
      font-size: 1.7rem;
      color: var(--surface);
      line-height: 1.25;
      text-wrap: balance;
      margin-bottom: 22px;
      max-width: 30ch;
    }
    .hero-intro-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--surface);
      color: var(--text);
      border: none;
      border-radius: 999px;
      padding: 15px 26px;
      font-weight: 700;
      font-size: 0.9rem;
      box-shadow: 0 10px 28px rgba(0,0,0,0.35);
    }
    .hero-intro-btn svg { width: 16px; height: 16px; }
    @media (prefers-reduced-motion: reduce) {
      .hero-intro, .hero-intro-content { transition: none; }
    }

    [hidden] { display: none !important; }
  </style>
</head>
<body>
  <div class="gate-overlay" id="gate">
    <img class="gate-floral" src="/images/floral-sprig-flip.webp" alt="" aria-hidden="true" loading="eager" decoding="async">
    <div class="gate-card">
      <img class="gate-logo" src="/images/logo-moe.png" alt="Moë Tea Room">
      <div class="gate-eyebrow">COMMANDE À TABLE</div>
      <p class="gate-question">Quel est votre numéro de table ?</p>
      <p class="gate-hint">Il est indiqué sur le socle du QR code, sur votre table.</p>
      <div class="gate-display" id="gate-display" aria-live="polite">—</div>
      <div class="gate-numpad" id="gate-numpad">
        <button type="button" class="gate-key" data-num="1">1</button>
        <button type="button" class="gate-key" data-num="2">2</button>
        <button type="button" class="gate-key" data-num="3">3</button>
        <button type="button" class="gate-key" data-num="4">4</button>
        <button type="button" class="gate-key" data-num="5">5</button>
        <button type="button" class="gate-key" data-num="6">6</button>
        <button type="button" class="gate-key" data-num="7">7</button>
        <button type="button" class="gate-key" data-num="8">8</button>
        <button type="button" class="gate-key" data-num="9">9</button>
        <button type="button" class="gate-key gate-key-clear" data-action="clear">Effacer</button>
        <button type="button" class="gate-key" data-num="0">0</button>
        <button type="button" class="gate-key gate-key-back" data-action="back" aria-label="Corriger">⌫</button>
      </div>
      <button class="gate-btn" id="gate-btn" disabled>Voir le menu</button>
      <p class="gate-note">Version test : votre commande est envoyée en direct à l'équipe.</p>
    </div>
  </div>

  <div class="hero-intro" id="hero-intro" hidden>
    <img class="hero-intro-img" src="/images/br-tapas-marocaines.webp" alt="">
    <div class="hero-intro-scrim"></div>
    <div class="hero-intro-content">
      <img class="hero-intro-logo" src="/images/logo-moe.png" alt="Moë Tea Room">
      <div>
        <p class="hero-intro-tag">Bienvenue à votre table</p>
        <p class="hero-intro-title">Petites assiettes à partager, thés et matcha faits pour prendre son temps.</p>
        <button class="hero-intro-btn" id="hero-intro-btn" type="button">
          Découvrir le menu
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <header class="topbar">
    <img class="topbar-floral" src="/images/floral-sprig-flip.webp" alt="" aria-hidden="true" loading="eager" decoding="async">
    <div class="topbar-inner">
      <div class="wordmark"><img class="wordmark-logo" src="/images/logo-moe.png" alt="Moë Tea Room"><small>COMMANDE À TABLE</small></div>
      <button class="table-chip" id="table-chip-btn" type="button"><span class="dot"></span><span id="table-label">Table —</span></button>
    </div>
    <div class="draft-banner" id="draft-banner">
      <div class="draft-banner-inner">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg>
        <span><strong>Version test.</strong> Les commandes arrivent en direct chez l'équipe. Photos à venir pour certaines sections.</span>
        <button class="draft-banner-close" id="draft-banner-close" type="button" aria-label="Fermer ce message">×</button>
      </div>
    </div>
  </header>

  <div class="order-strip" id="order-strip" hidden>
    <div class="order-strip-scroll" id="order-strip-scroll"></div>
  </div>

  <nav class="catnav">
    <div class="catnav-scroll" id="catnav"></div>
    <div class="filter-row">
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" id="menu-search" class="search-input" placeholder="Rechercher un plat, une boisson…" autocomplete="off" />
        <button type="button" class="search-clear" id="search-clear" hidden aria-label="Effacer la recherche">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="diet-chips" id="diet-chips">
        <button type="button" class="diet-chip" data-diet="vegetarien">Végétarien</button>
        <button type="button" class="diet-chip" data-diet="vegan">Vegan</button>
        <button type="button" class="diet-chip" data-diet="epice">Épicé</button>
      </div>
    </div>
  </nav>

  <p class="filter-disclaimer">Filtres indicatifs — signalez toute allergie à notre équipe en salle.</p>

  <main id="main"></main>
  <p class="no-results" id="no-results" hidden>Aucun résultat pour cette recherche. Essayez un autre terme ou retirez un filtre.</p>

  <button class="cart-fab" id="cart-fab" hidden>
    <span class="badge" id="fab-count">0</span>
    <span>Voir la commande</span>
    <span class="total tabular" id="fab-total">0</span>
  </button>

  <button class="plate-dock" id="plate-dock" type="button" hidden aria-label="Voir votre assiette en cours">
    <span class="plate-dock-visual" id="plate-dock-visual"></span>
    <span class="plate-dock-count" id="plate-dock-count">0</span>
  </button>

  <div class="sheet-overlay" id="overlay"></div>
  <div class="sheet" id="sheet">
    <div class="sheet-handle"></div>
    <div id="sheet-order-view">
      <div class="sheet-head">
        <h3>Votre commande</h3>
        <div class="sheet-head-actions">
          <button class="clear-cart-btn" id="clear-cart-btn" type="button" hidden aria-label="Vider la commande">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>
          </button>
          <button class="sheet-close" id="sheet-close" aria-label="Fermer">✕</button>
        </div>
      </div>
      <div class="sheet-body" id="cart-lines"></div>
      <div class="pairing-suggestion" id="pairing-suggestion" hidden></div>
      <div class="sheet-foot">
        <div id="sheet-foot-main">
          <div class="total-row">
            <span class="label">Total</span>
            <span class="value tabular" id="sheet-total">0</span>
          </div>
          <button class="send-btn" id="send-btn" disabled>Envoyer la commande</button>
          <p class="send-error" id="send-error" hidden>Un problème est survenu lors de l'envoi. Réessayez, ou appelez un membre de l'équipe.</p>
        </div>
        <div class="clear-confirm" id="clear-confirm" hidden>
          <p>Vider toute la commande ?</p>
          <div class="clear-confirm-actions">
            <button class="clear-cancel-btn" id="clear-cancel-btn" type="button">Annuler</button>
            <button class="clear-confirm-btn" id="clear-confirm-btn" type="button">Oui, vider</button>
          </div>
        </div>
      </div>
    </div>
    <div id="sheet-confirm-view" hidden>
      <div class="confirm-view">
        <img class="confirm-floral" src="/images/floral-sprig.webp" alt="" aria-hidden="true" loading="lazy" decoding="async">
        <div class="confirm-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg>
        </div>
        <h3 class="display">Commande envoyée</h3>
        <p id="confirm-detail">L'équipe a reçu votre commande.</p>
        <button class="confirm-close" id="confirm-close">Fermer</button>
      </div>
    </div>
  </div>

  <script define:vars={{ supabaseUrl, supabaseAnonKey, currencyCode, catalogCategories, catalogItems: CATALOG_ITEMS }}>
    window.__moeCommandeConfig = { supabaseUrl, supabaseAnonKey, currencyCode };
    window.__moeCatalog = { categories: catalogCategories, items: catalogItems };
  </script>
  <script>
    (function () {
      var SUPABASE_URL = window.__moeCommandeConfig.supabaseUrl;
      var SUPABASE_ANON_KEY = window.__moeCommandeConfig.supabaseAnonKey;
      var CURRENCY_CODE = window.__moeCommandeConfig.currencyCode || 'MAD';

      // ---------------------------------------------------------------------
      // Icons — one simple line-icon per category, reused as the placeholder
      // tile art until real photography exists.
      // ---------------------------------------------------------------------
      var ICONS = {
        breakfast: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="7"/><path d="M12 6V3M9 3h6"/></svg>',
        brunch: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0016 0"/><path d="M2 12h20M7 12V7a5 5 0 0110 0v5"/></svg>',
        sandwich: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M4 11h16l-1.5 8h-13z"/><path d="M4 15h16"/></svg>',
        pancake: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="8" rx="8" ry="2.2"/><ellipse cx="12" cy="12.5" rx="8" ry="2.2"/><ellipse cx="12" cy="17" rx="8" ry="2.2"/></svg>',
        drinks: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h11l-1 12a4 4 0 01-4 4h-1a4 4 0 01-4-4z"/><path d="M16 6h2a2.5 2.5 0 010 5h-2"/><path d="M8 19h6"/></svg>',
        patisserie: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="9" rx="2"/><path d="M4 10l1.5-5h13L20 10"/><path d="M9 5V3M12 5V2M15 5V3"/></svg>',
      };

      // ---------------------------------------------------------------------
      // Menu data — shared with the marketing Menu page (see
      // src/content/menu-catalog.ts's own top comment). Injected above as
      // window.__moeCatalog by the define:vars script tag right before
      // this one; ICON_BY_CAT reattaches this page's own line-icon per
      // category (a purely presentational choice, not menu content, so it
      // stays local instead of living in the shared catalog).
      // ---------------------------------------------------------------------
      var ICON_BY_CAT = {
        breakfast: ICONS.breakfast,
        brunch: ICONS.brunch,
        sandwichs: ICONS.sandwich,
        pancakes: ICONS.pancake,
        drinks: ICONS.drinks,
        patisserie: ICONS.patisserie,
      };
      var CATEGORIES = window.__moeCatalog.categories.map(function (c) {
        return { id: c.id, label: c.label, icon: ICON_BY_CAT[c.id], style: c.style, sub: c.sub, combo: c.combo };
      });
      var CATEGORIES_BY_ID = {};
      CATEGORIES.forEach(function (c) { CATEGORIES_BY_ID[c.id] = c; });

      var ITEMS = window.__moeCatalog.items;
      var ITEMS_BY_ID = {};
      ITEMS.forEach(function (it) { ITEMS_BY_ID[it.id] = it; });

      // ---------------------------------------------------------------------
      // Cart state — in-memory only (no localStorage): one order per table
      // visit, cleared once it's actually sent.
      // ---------------------------------------------------------------------
      var cart = {};

      function currency(n) {
        var v = Math.round(n * 100) / 100;
        return (v % 1 === 0 ? v.toFixed(0) : v.toFixed(2)) + ' ' + CURRENCY_CODE;
      }

      function cartCount() {
        var n = 0;
        for (var id in cart) n += cart[id];
        return n;
      }
      function cartTotal() {
        var t = 0;
        for (var id in cart) t += cart[id] * ITEMS_BY_ID[id].price;
        return t;
      }

      function setQty(id, qty) {
        qty = Math.max(0, qty);
        if (qty === 0) delete cart[id];
        else cart[id] = qty;
        renderQtyControls();
        renderCartSheet();
        renderFab();
        renderOrderStrip();
        renderPlateBuilders();
        updateActivePill(); // also refreshes the plate dock's count/photos
      }

      // ---------------------------------------------------------------------
      // Plate builder — the visual "compose your plate" widget on combo
      // categories (breakfast, brunch). Each item keeps a fixed slot on
      // the plate (by its position in the category) so a dish always
      // lands in the same spot once added, rather than reshuffling.
      // ---------------------------------------------------------------------
      function renderPlateBuilder(catId) {
        var container = document.getElementById('plate-items-' + catId);
        if (!container) return;
        var emptyEl = document.getElementById('plate-empty-' + catId);
        var countEl = document.getElementById('plate-count-' + catId);
        var cat = CATEGORIES_BY_ID[catId];
        var catItems = ITEMS.filter(function (it) { return it.cat === catId; });
        var selected = catItems.filter(function (it) { return (cart[it.id] || 0) > 0; });

        container.innerHTML = catItems.map(function (it, i) {
          var qty = cart[it.id] || 0;
          if (!qty) return '';
          var inner = it.image
            ? '<img src="' + it.image + '" alt="">'
            : '<span class="plate-icon">' + cat.icon + '</span>';
          var badge = qty > 1 ? '<span class="plate-slot-qty">' + qty + '</span>' : '';
          return '<div class="plate-slot plate-slot-' + i + '">' + inner + badge + '</div>';
        }).join('');
        if (emptyEl) emptyEl.hidden = selected.length > 0;
        if (countEl) countEl.textContent = selected.length;
      }
      function renderPlateBuilders() {
        CATEGORIES.forEach(function (cat) {
          if (cat.combo) renderPlateBuilder(cat.id);
        });
      }

      // ---------------------------------------------------------------------
      // Live order strip — sits between the header and the category nav,
      // shows a running row of everything ordered so far so the table can
      // always see their build without opening the cart sheet.
      // ---------------------------------------------------------------------
      var orderStripEl = document.getElementById('order-strip');
      var orderStripScrollEl = document.getElementById('order-strip-scroll');

      function renderOrderStrip() {
        var ids = Object.keys(cart);
        if (ids.length === 0) {
          orderStripEl.hidden = true;
        } else {
          orderStripScrollEl.innerHTML = ids.map(function (id) {
            var it = ITEMS_BY_ID[id];
            var qty = cart[id];
            var cat = CATEGORIES_BY_ID[it.cat];
            var thumb = it.image
              ? '<img class="order-chip-thumb" src="' + it.image + '" alt="">'
              : '<span class="order-chip-thumb">' + cat.icon + '</span>';
            return '<div class="order-chip">' + thumb +
              '<span class="order-chip-name">' + it.name + '</span>' +
              '<span class="order-chip-qty tabular">×' + qty + '</span></div>';
          }).join('');
          orderStripEl.hidden = false;
        }
        updateStickyOffsets();
      }
      orderStripScrollEl.addEventListener('click', function () { openSheet(); });

      // The header's height isn't fixed (the strip toggles, the banner can
      // wrap on narrow phones), so the catnav's sticky offset is measured
      // in JS rather than hardcoded — keeps the two sticky layers stacked
      // correctly under every state instead of overlapping.
      function updateStickyOffsets() {
        var topbarH = document.querySelector('.topbar').offsetHeight;
        var stripH = orderStripEl.hidden ? 0 : orderStripEl.offsetHeight;
        var catnavH = document.querySelector('.catnav').offsetHeight;
        document.documentElement.style.setProperty('--topbar-h', topbarH + 'px');
        document.documentElement.style.setProperty('--strip-h', stripH + 'px');
        document.documentElement.style.setProperty('--catnav-h', catnavH + 'px');
      }
      window.addEventListener('resize', updateStickyOffsets);
      updateStickyOffsets();

      // Dismiss the "version test" pill — collapses the topbar by its
      // height, so the sticky offsets need re-measuring right after.
      var draftBannerCloseEl = document.getElementById('draft-banner-close');
      if (draftBannerCloseEl) {
        draftBannerCloseEl.addEventListener('click', function () {
          document.getElementById('draft-banner').hidden = true;
          updateStickyOffsets();
        });
      }

      // ---------------------------------------------------------------------
      // "Fly to cart" micro-interaction: a small ghost of the dish photo
      // (or the category icon, for un-photographed items) arcs toward the
      // cart button on every add, then the button badge pulses. Purely a
      // Web Animations API tween — no library needed.
      // ---------------------------------------------------------------------
      function flyToCart(sourceCard) {
        if (!sourceCard || !fab || fab.hidden) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { pulseFab(); return; }
        var imgEl = sourceCard.querySelector('.item-tile img');
        var size = 44;
        var ghost = document.createElement('div');
        var srcRect;
        if (imgEl) {
          srcRect = imgEl.getBoundingClientRect();
          ghost.style.backgroundImage = 'url(' + imgEl.getAttribute('src') + ')';
          ghost.style.backgroundSize = 'cover';
          ghost.style.backgroundPosition = 'center';
        } else {
          var tile = sourceCard.querySelector('.item-tile') || sourceCard;
          srcRect = tile.getBoundingClientRect();
          ghost.style.background = 'var(--accent)';
        }
        ghost.style.position = 'fixed';
        ghost.style.width = size + 'px';
        ghost.style.height = size + 'px';
        ghost.style.left = (srcRect.left + srcRect.width / 2 - size / 2) + 'px';
        ghost.style.top = (srcRect.top + srcRect.height / 2 - size / 2) + 'px';
        ghost.style.borderRadius = '50%';
        ghost.style.zIndex = '60';
        ghost.style.pointerEvents = 'none';
        ghost.style.boxShadow = '0 6px 18px rgba(0,0,0,0.3)';
        document.body.appendChild(ghost);

        var fabRect = fab.getBoundingClientRect();
        var dx = (fabRect.left + 24) - (srcRect.left + srcRect.width / 2 - size / 2);
        var dy = (fabRect.top + fabRect.height / 2) - (srcRect.top + srcRect.height / 2 - size / 2);
        var anim = ghost.animate([
          { transform: 'translate(0px, 0px) scale(1)', opacity: 1 },
          { transform: 'translate(' + (dx * 0.6) + 'px, ' + (dy * 0.35) + 'px) scale(0.7)', opacity: 1, offset: 0.6 },
          { transform: 'translate(' + dx + 'px, ' + dy + 'px) scale(0.15)', opacity: 0.4 },
        ], { duration: 500, easing: 'cubic-bezier(0.3, 0.7, 0.35, 1)' });
        anim.onfinish = function () {
          ghost.remove();
          pulseFab();
        };
      }

      function pulseFab() {
        if (!fab) return;
        fab.classList.remove('is-pulsing');
        void fab.offsetWidth;
        fab.classList.add('is-pulsing');
      }

      var catnavEl = document.getElementById('catnav');
      CATEGORIES.forEach(function (cat) {
        var btn = document.createElement('button');
        btn.className = 'catpill';
        btn.dataset.target = cat.id;
        btn.innerHTML = cat.icon + '<span>' + cat.label + '</span>';
        btn.addEventListener('click', function () {
          document.getElementById('cat-' + cat.id).scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        catnavEl.appendChild(btn);
      });

      var mainEl = document.getElementById('main');

      function qtyControlHtml(id) {
        var qty = cart[id] || 0;
        if (qty === 0) {
          return '<button class="add-btn" data-add="' + id + '" aria-label="Ajouter">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>';
        }
        return '<div class="stepper">' +
          '<button data-dec="' + id + '" aria-label="Retirer">−</button>' +
          '<span class="qty tabular">' + qty + '</span>' +
          '<button data-inc="' + id + '" aria-label="Ajouter">+</button>' +
          '</div>';
      }

      // Bento layout helper: the hero card is the first photographed item
      // in a list, so a section with no photos yet just renders as a
      // uniform grid (nothing to promote) instead of guessing.
      function firstPhotoId(list) {
        for (var i = 0; i < list.length; i++) {
          if (list[i].image) return list[i].id;
        }
        return null;
      }

      // ---------------------------------------------------------------------
      // Dietary tags & badges — small merchandising/filtering layer on top
      // of the catalog. TAG_LABELS is the single place that turns a raw
      // tag id into what the customer reads, shared between the item
      // cards/rows and the filter chip row.
      // ---------------------------------------------------------------------
      var TAG_LABELS = { vegan: 'Vegan', epice: 'Épicé', viande: 'Viande' };
      var BADGE_LABELS = { populaire: 'Populaire', chef: 'Coup de cœur' };

      function badgeBlockHtml(it) {
        if (!it.badge) return '';
        return '<span class="item-badge badge-' + it.badge + '">' + BADGE_LABELS[it.badge] + '</span>';
      }
      function badgeInlineHtml(it) {
        if (!it.badge) return '';
        return '<span class="item-row-badge badge-' + it.badge + '">' + BADGE_LABELS[it.badge] + '</span>';
      }
      // "Végétarien" isn't a stored tag — everything on this menu is
      // vegetarian except the handful explicitly tagged 'viande', so the
      // display line only ever needs to call out vegan/épicé.
      function tagsLineHtml(it) {
        if (!it.tags || !it.tags.length) return '';
        var shown = it.tags.filter(function (t) { return t === 'vegan' || t === 'epice'; });
        if (!shown.length) return '';
        return '<div class="item-tags">' + shown.map(function (t) { return TAG_LABELS[t]; }).join(' · ') + '</div>';
      }
      function isVegetarian(it) { return !it.tags || it.tags.indexOf('viande') === -1; }

      CATEGORIES.forEach(function (cat) {
        var section = document.createElement('section');
        section.className = 'category';
        section.id = 'cat-' + cat.id;

        var head = '<div class="cat-head">' + cat.icon + '<h2>' + cat.label + '</h2></div>';
        if (cat.sub) head += '<p class="cat-sub">' + cat.sub + '</p>';
        if (cat.combo) {
          // Visual "build your plate" widget instead of a text banner: as
          // the customer adds dishes from this category, their photos
          // appear scattered on a plate graphic, live, so composing a
          // combo actually looks like composing a plate.
          head +=
            '<div class="plate-builder" id="plate-builder-' + cat.id + '">' +
              '<div class="plate-visual">' +
                '<div class="plate-items" id="plate-items-' + cat.id + '"></div>' +
                '<div class="plate-empty" id="plate-empty-' + cat.id + '">' +
                  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v6a2 2 0 0 0 2 2v10M7 3v18M11 3v8M15 3c-1.5 1-2 3-2 5s1 3 2 3v10"/></svg>' +
                  '<span>Composez<br>votre assiette</span>' +
                '</div>' +
              '</div>' +
              '<div class="plate-caption">' +
                '<p class="plate-caption-title">Composez votre assiette</p>' +
                '<p class="plate-caption-desc"><strong id="plate-count-' + cat.id + '">0</strong> assiette(s) sélectionnée(s) — ' + cat.combo + '</p>' +
              '</div>' +
            '</div>';
        }
        section.innerHTML = head;

        var items = ITEMS.filter(function (it) { return it.cat === cat.id; });

        if (cat.style === 'cards') {
          var grid = document.createElement('div');
          grid.className = 'card-grid';
          var heroId = firstPhotoId(items);
          items.forEach(function (it) {
            var card = document.createElement('div');
            card.className = 'item-card' + (it.id === heroId ? ' is-hero' : '');
            card.dataset.id = it.id;
            var tileInner = it.image
              ? '<img src="' + it.image + '" alt="" loading="lazy">'
              : cat.icon;
            card.innerHTML =
              badgeBlockHtml(it) +
              '<div class="item-tile">' + tileInner + '</div>' +
              '<div class="item-name">' + it.name + '</div>' +
              (it.desc ? '<div class="item-desc">' + it.desc + '</div>' : '<div class="item-desc"></div>') +
              tagsLineHtml(it) +
              '<div class="item-foot"><span class="item-price tabular">' + currency(it.price) + '</span><span class="qty-slot" data-slot="' + it.id + '">' + qtyControlHtml(it.id) + '</span></div>';
            grid.appendChild(card);
          });
          section.appendChild(grid);
        } else {
          var subs = [];
          items.forEach(function (it) { if (it.sub && subs.indexOf(it.sub) === -1) subs.push(it.sub); });
          var list = document.createElement('div');
          subs.forEach(function (subLabel) {
            // Wrapped as one unit (label + its items) so the filter pass
            // below can hide/show a whole subgroup — e.g. all of "Chaud"
            // — as soon as none of its items match, instead of leaving a
            // dangling subheading over an empty grid.
            var subWrap = document.createElement('div');
            subWrap.className = 'subgroup';
            var subEl = document.createElement('div');
            subEl.className = 'subgroup-label';
            subEl.textContent = subLabel;
            subWrap.appendChild(subEl);
            var subItems = items.filter(function (it) { return it.sub === subLabel; });
            // A subgroup with real photography (e.g. Moëtcha) gets the same
            // full-photo card treatment as the dish categories, instead of
            // the compact thumbnail row used for un-photographed subgroups.
            var hasPhotos = subItems.some(function (it) { return !!it.image; });
            if (hasPhotos) {
              var subGrid = document.createElement('div');
              subGrid.className = 'card-grid';
              var subHeroId = firstPhotoId(subItems);
              subItems.forEach(function (it) {
                var card = document.createElement('div');
                card.className = 'item-card' + (it.id === subHeroId ? ' is-hero' : '');
                card.dataset.id = it.id;
                var tileInner = it.image
                  ? '<img src="' + it.image + '" alt="" loading="lazy">'
                  : cat.icon;
                card.innerHTML =
                  badgeBlockHtml(it) +
                  '<div class="item-tile">' + tileInner + '</div>' +
                  '<div class="item-name">' + it.name + '</div>' +
                  (it.desc ? '<div class="item-desc">' + it.desc + '</div>' : '<div class="item-desc"></div>') +
                  tagsLineHtml(it) +
                  '<div class="item-foot"><span class="item-price tabular">' + currency(it.price) + '</span><span class="qty-slot" data-slot="' + it.id + '">' + qtyControlHtml(it.id) + '</span></div>';
                subGrid.appendChild(card);
              });
              subWrap.appendChild(subGrid);
              list.appendChild(subWrap);
              return;
            }
            var rowList = document.createElement('div');
            rowList.className = 'row-list';
            subItems.forEach(function (it) {
              var row = document.createElement('div');
              row.className = 'item-row';
              row.dataset.id = it.id;
              row.innerHTML =
                '<div class="row-main"><div class="item-name">' + it.name + badgeInlineHtml(it) + '</div>' +
                (it.desc ? '<div class="item-desc">' + it.desc + '</div>' : '') +
                tagsLineHtml(it) + '</div>' +
                '<span class="row-price tabular">' + currency(it.price) + '</span>' +
                '<span class="qty-slot" data-slot="' + it.id + '">' + qtyControlHtml(it.id) + '</span>';
              rowList.appendChild(row);
            });
            subWrap.appendChild(rowList);
            list.appendChild(subWrap);
          });
          section.appendChild(list);
        }

        mainEl.appendChild(section);
      });

      // ---------------------------------------------------------------------
      // Search + dietary filters. Runs after the static render above (item
      // count is small — under 100 — so a direct DOM show/hide pass on
      // every keystroke/toggle is plenty fast, no need to diff or rebuild).
      // Hides, in order: individual cards/rows that don't match → any
      // .subgroup left with nothing visible → any .category section left
      // with nothing visible → shows the page-level "no results" message
      // only if every category ends up empty.
      // ---------------------------------------------------------------------
      var searchInput = document.getElementById('menu-search');
      var searchClearBtn = document.getElementById('search-clear');
      var dietChipsEl = document.getElementById('diet-chips');
      var noResultsEl = document.getElementById('no-results');
      var activeDiets = {};

      function normalize(s) {
        return (s || '').toString().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      }

      function itemMatchesDiets(it) {
        for (var diet in activeDiets) {
          if (!activeDiets[diet]) continue;
          if (diet === 'vegetarien') { if (!isVegetarian(it)) return false; }
          else if (!it.tags || it.tags.indexOf(diet) === -1) return false;
        }
        return true;
      }

      function applyFilters() {
        var query = normalize(searchInput.value.trim());
        searchClearBtn.hidden = query.length === 0;

        document.querySelectorAll('.item-card[data-id], .item-row[data-id]').forEach(function (el) {
          var it = ITEMS_BY_ID[el.dataset.id];
          var matchesSearch = !query || normalize(it.name).indexOf(query) !== -1 || normalize(it.desc).indexOf(query) !== -1;
          var visible = matchesSearch && itemMatchesDiets(it);
          el.hidden = !visible;
        });

        document.querySelectorAll('.subgroup').forEach(function (sub) {
          var anyVisible = sub.querySelector('.item-card:not([hidden]), .item-row:not([hidden])');
          sub.hidden = !anyVisible;
        });

        var anyCategoryVisible = false;
        document.querySelectorAll('.category').forEach(function (section) {
          var anyVisible = section.querySelector('.item-card:not([hidden]), .item-row:not([hidden])');
          section.hidden = !anyVisible;
          if (anyVisible) anyCategoryVisible = true;
        });

        noResultsEl.hidden = anyCategoryVisible;
        updateStickyOffsets();
      }

      searchInput.addEventListener('input', applyFilters);
      searchClearBtn.addEventListener('click', function () {
        searchInput.value = '';
        applyFilters();
        searchInput.focus();
      });
      dietChipsEl.addEventListener('click', function (e) {
        var chip = e.target.closest('.diet-chip');
        if (!chip) return;
        var diet = chip.getAttribute('data-diet');
        activeDiets[diet] = !activeDiets[diet];
        chip.classList.toggle('is-active', !!activeDiets[diet]);
        applyFilters();
      });

      // Delegate qty-button clicks (+, -, add) — one listener instead of one
      // per button since a re-render swaps innerHTML on every change.
      mainEl.addEventListener('click', function (e) {
        var addId = e.target.closest('[data-add]');
        var incId = e.target.closest('[data-inc]');
        var decId = e.target.closest('[data-dec]');
        var sourceCard = e.target.closest('.item-card') || e.target.closest('.item-row');
        if (addId) { setQty(addId.getAttribute('data-add'), 1); flyToCart(sourceCard); }
        else if (incId) { setQty(incId.getAttribute('data-inc'), (cart[incId.getAttribute('data-inc')] || 0) + 1); flyToCart(sourceCard); }
        else if (decId) setQty(decId.getAttribute('data-dec'), (cart[decId.getAttribute('data-dec')] || 0) - 1);
      });

      function renderQtyControls() {
        document.querySelectorAll('.qty-slot').forEach(function (slot) {
          var id = slot.getAttribute('data-slot');
          slot.innerHTML = qtyControlHtml(id);
        });
      }

      // ---------------------------------------------------------------------
      // Active category highlight on scroll
      // ---------------------------------------------------------------------
      var sections = CATEGORIES.map(function (c) { return document.getElementById('cat-' + c.id); });
      var pills = Array.prototype.slice.call(document.querySelectorAll('.catpill'));
      function updateActivePill() {
        var probeY = 150;
        var activeIdx = 0;
        sections.forEach(function (sec, i) {
          if (sec.getBoundingClientRect().top - probeY <= 0) activeIdx = i;
        });
        pills.forEach(function (p, i) { p.classList.toggle('is-active', i === activeIdx); });
        updatePlateDock(CATEGORIES[activeIdx]);
      }
      window.addEventListener('scroll', updateActivePill, { passive: true });
      window.addEventListener('resize', updateActivePill);

      // ---------------------------------------------------------------------
      // Plate dock — the mini floating version of the plate builder (see
      // renderPlateBuilder above). Shows only once the full-size plate for
      // the currently-viewed category has scrolled above the sticky header
      // stack, and only while that category still has items on it.
      // ---------------------------------------------------------------------
      var plateDockEl = document.getElementById('plate-dock');
      var plateDockVisualEl = document.getElementById('plate-dock-visual');
      var plateDockCountEl = document.getElementById('plate-dock-count');

      function updatePlateDock(activeCat) {
        if (!activeCat || !activeCat.combo) { plateDockEl.hidden = true; return; }
        var plateEl = document.getElementById('plate-builder-' + activeCat.id);
        if (!plateEl) { plateDockEl.hidden = true; return; }

        var catItems = ITEMS.filter(function (it) { return it.cat === activeCat.id; });
        var selected = catItems.filter(function (it) { return (cart[it.id] || 0) > 0; });
        if (selected.length === 0) { plateDockEl.hidden = true; return; }

        var headerH = document.querySelector('.topbar').offsetHeight +
          (orderStripEl.hidden ? 0 : orderStripEl.offsetHeight) +
          document.querySelector('.catnav').offsetHeight;
        var scrolledPast = plateEl.getBoundingClientRect().bottom < headerH;
        plateDockEl.hidden = !scrolledPast;
        if (!scrolledPast) return;

        // Same fixed per-dish slot index as the full plate (see
        // renderPlateBuilder) — a dish sits in the same ring position in
        // both places, just smaller here.
        plateDockVisualEl.innerHTML = catItems.map(function (it, i) {
          var qty = cart[it.id] || 0;
          if (!qty) return '';
          var inner = it.image
            ? '<img src="' + it.image + '" alt="">'
            : '<span class="plate-icon">' + activeCat.icon + '</span>';
          var badge = qty > 1 ? '<span class="plate-slot-qty">' + qty + '</span>' : '';
          return '<div class="plate-slot plate-slot-' + i + '">' + inner + badge + '</div>';
        }).join('');
        plateDockCountEl.textContent = selected.length;
        plateDockEl.onclick = function () {
          plateEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };
      }
      updateActivePill();

      // ---------------------------------------------------------------------
      // Cart sheet + FAB
      // ---------------------------------------------------------------------
      var fab = document.getElementById('cart-fab');
      var fabCount = document.getElementById('fab-count');
      var fabTotal = document.getElementById('fab-total');
      var overlay = document.getElementById('overlay');
      var sheet = document.getElementById('sheet');
      var cartLinesEl = document.getElementById('cart-lines');
      var sheetTotalEl = document.getElementById('sheet-total');
      var sendBtn = document.getElementById('send-btn');
      var sendErrorEl = document.getElementById('send-error');
      var orderView = document.getElementById('sheet-order-view');
      var confirmView = document.getElementById('sheet-confirm-view');
      var clearCartBtn = document.getElementById('clear-cart-btn');
      var clearConfirmEl = document.getElementById('clear-confirm');
      var sheetFootMainEl = document.getElementById('sheet-foot-main');
      var clearCancelBtn = document.getElementById('clear-cancel-btn');
      var clearConfirmBtn = document.getElementById('clear-confirm-btn');

      function renderFab() {
        var n = cartCount();
        fab.hidden = n === 0;
        fabCount.textContent = n;
        fabTotal.textContent = currency(cartTotal());
      }

      // Per-item remarks (allergies, "sans oignon", ...), kept in memory and
      // sent along with the order. Stored outside the DOM so a re-render
      // triggered by a qty change elsewhere never wipes text mid-typing.
      var itemNotes = {};
      var NOTE_PRESETS = ['Sans oignon', 'Épicé', 'Allergie ⚠'];

      // ---------------------------------------------------------------------
      // "Ça se marie bien avec" — a light, rule-based pairing suggestion
      // shown in the cart sheet. Not a recommendation engine, just a
      // curated nudge toward the drink/side that goes with what's already
      // in the order; only ever suggests one thing at a time.
      // ---------------------------------------------------------------------
      var pairingSuggestionEl = document.getElementById('pairing-suggestion');
      var PAIRING_RULES = [
        { when: 'breakfast', suggest: 'dr-moetcha-classic' },
        { when: 'brunch', suggest: 'dr-moetcha-nana' },
        { when: 'sandwichs', suggest: 'dr-citron-presse' },
        { when: 'pancakes', suggest: 'dr-moetcha-amlou' },
      ];
      function renderPairingSuggestion() {
        var cartIds = Object.keys(cart);
        if (cartIds.length === 0) { pairingSuggestionEl.hidden = true; return; }
        var cartCats = {};
        cartIds.forEach(function (id) { cartCats[ITEMS_BY_ID[id].cat] = true; });
        var pick = null;
        for (var i = 0; i < PAIRING_RULES.length; i++) {
          var rule = PAIRING_RULES[i];
          if (cartCats[rule.when] && !cart[rule.suggest] && ITEMS_BY_ID[rule.suggest]) { pick = rule.suggest; break; }
        }
        if (!pick) { pairingSuggestionEl.hidden = true; return; }
        var it = ITEMS_BY_ID[pick];
        var cat = CATEGORIES_BY_ID[it.cat];
        var thumb = it.image ? '<img src="' + it.image + '" alt="">' : cat.icon;
        pairingSuggestionEl.innerHTML =
          '<div class="pairing-thumb">' + thumb + '</div>' +
          '<div class="pairing-body"><div class="pairing-label">Ça se marie bien avec</div>' +
          '<div class="pairing-name">' + it.name + '</div>' +
          '<div class="pairing-price tabular">' + currency(it.price) + '</div></div>' +
          '<button type="button" class="pairing-add-btn" data-pairing-add="' + it.id + '" aria-label="Ajouter">+</button>';
        pairingSuggestionEl.hidden = false;
      }
      pairingSuggestionEl.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-pairing-add]');
        if (!btn) return;
        setQty(btn.getAttribute('data-pairing-add'), 1);
      });

      function renderCartSheet() {
        var ids = Object.keys(cart);
        if (ids.length === 0) {
          cartLinesEl.innerHTML = '<p class="cart-empty">Votre commande est vide pour l’instant.<br>Ajoutez des plats depuis le menu.</p>';
          sendBtn.disabled = true;
        } else {
          cartLinesEl.innerHTML = '';
          ids.forEach(function (id) {
            var it = ITEMS_BY_ID[id];
            var qty = cart[id];
            var line = document.createElement('div');
            line.className = 'cart-line';
            line.innerHTML =
              '<div class="cart-line-main"><div class="cart-line-name">' + it.name + '</div>' +
              '<div class="cart-line-price tabular">' + currency(it.price) + ' × ' + qty + ' = ' + currency(it.price * qty) + '</div>' +
              '<div class="cart-line-note-chips">' + NOTE_PRESETS.map(function (p) {
                return '<button type="button" class="note-chip" data-chip-for="' + id + '" data-chip-text="' + p + '">' + p + '</button>';
              }).join('') + '</div>' +
              '<input type="text" class="note-input" data-note-for="' + id + '" placeholder="Remarque (facultatif)" value="' + (itemNotes[id] || '').replace(/"/g, '&quot;') + '"></div>' +
              '<span class="qty-slot-cart"></span>';
            var stepperSlot = line.querySelector('.qty-slot-cart');
            stepperSlot.innerHTML = qtyControlHtml(id);
            cartLinesEl.appendChild(line);
          });
          sendBtn.disabled = false;
        }
        sheetTotalEl.textContent = currency(cartTotal());
        clearCartBtn.hidden = ids.length === 0;
        if (ids.length === 0) hideClearConfirm();
        renderPairingSuggestion();
      }

      // ---------------------------------------------------------------------
      // Clear whole order — a trash icon next to the sheet's close button.
      // Tapping it swaps the total/send-button area for an inline
      // "are you sure" bar instead of a browser confirm() dialog, so it
      // can't be triggered by accident but doesn't interrupt the page.
      // ---------------------------------------------------------------------
      function showClearConfirm() {
        sheetFootMainEl.hidden = true;
        clearConfirmEl.hidden = false;
      }
      function hideClearConfirm() {
        clearConfirmEl.hidden = true;
        sheetFootMainEl.hidden = false;
      }
      clearCartBtn.addEventListener('click', showClearConfirm);
      clearCancelBtn.addEventListener('click', hideClearConfirm);
      clearConfirmBtn.addEventListener('click', function () {
        cart = {};
        itemNotes = {};
        hideClearConfirm();
        renderQtyControls();
        renderCartSheet();
        renderFab();
        renderOrderStrip();
        renderPlateBuilders();
        updateActivePill();
      });

      cartLinesEl.addEventListener('click', function (e) {
        var incId = e.target.closest('[data-inc]');
        var decId = e.target.closest('[data-dec]');
        var addId = e.target.closest('[data-add]');
        var chip = e.target.closest('.note-chip');
        if (incId) setQty(incId.getAttribute('data-inc'), (cart[incId.getAttribute('data-inc')] || 0) + 1);
        else if (decId) setQty(decId.getAttribute('data-dec'), (cart[decId.getAttribute('data-dec')] || 0) - 1);
        else if (addId) setQty(addId.getAttribute('data-add'), 1);
        else if (chip) {
          var forId = chip.getAttribute('data-chip-for');
          var text = chip.getAttribute('data-chip-text');
          var input = cartLinesEl.querySelector('.note-input[data-note-for="' + forId + '"]');
          if (!input) return;
          var parts = input.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
          if (parts.indexOf(text) === -1) parts.push(text);
          input.value = parts.join(', ');
          itemNotes[forId] = input.value;
          chip.classList.add('is-active');
          input.focus();
          var end = input.value.length;
          input.setSelectionRange(end, end);
        }
      });
      cartLinesEl.addEventListener('input', function (e) {
        var input = e.target.closest('.note-input');
        if (!input) return;
        itemNotes[input.getAttribute('data-note-for')] = input.value;
      });

      function openSheet() {
        orderView.hidden = false;
        confirmView.hidden = true;
        overlay.classList.add('is-open');
        sheet.classList.add('is-open');
      }
      function closeSheet() {
        overlay.classList.remove('is-open');
        sheet.classList.remove('is-open');
      }

      fab.addEventListener('click', openSheet);
      overlay.addEventListener('click', closeSheet);
      document.getElementById('sheet-close').addEventListener('click', closeSheet);
      document.getElementById('confirm-close').addEventListener('click', function () {
        closeSheet();
      });

      // ---------------------------------------------------------------------
      // Send order — writes straight into the SAME Supabase `orders` table
      // CartWidget.astro used to write to (see this file's top comment).
      // Fails safe: on a network/API error the cart is left untouched and
      // an inline message asks the customer to retry or flag a team member,
      // instead of silently pretending the order went through.
      // ---------------------------------------------------------------------
      sendBtn.addEventListener('click', function () {
        if (sendBtn.disabled) return;
        var n = cartCount();
        var tableLabel = document.getElementById('table-label').textContent;
        var tableNumber = tableLabel.replace(/^Table\s*/, '');
        var ids = Object.keys(cart);
        var total = cartTotal();
        var now = new Date();
        var hhmm = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');

        var payload = {
          order_ref: 'QR T' + tableNumber + ' · ' + hhmm,
          customer_name: tableLabel,
          customer_phone: null,
          order_type: 'dinein',
          address_or_table: tableLabel,
          items: ids.map(function (id) {
            var it = ITEMS_BY_ID[id];
            return { name: it.name, quantity: cart[id], price: it.price, station: it.station, note: itemNotes[id] || null };
          }),
          total: total,
          notes: null,
          status: 'pending',
        };

        function finishSuccess() {
          document.getElementById('confirm-detail').textContent =
            'L’équipe a reçu votre commande (' + n + (n > 1 ? ' articles' : ' article') + ') pour la ' + tableLabel.toLowerCase() + '.';
          sendErrorEl.hidden = true;
          orderView.hidden = true;
          confirmView.hidden = false;
          cart = {};
          itemNotes = {};
          renderQtyControls();
          renderFab();
          renderOrderStrip();
          renderPlateBuilders();
          updateActivePill();
          sendBtn.disabled = false;
          sendBtn.textContent = 'Envoyer la commande';
        }

        if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
          console.warn('[commande] Supabase non configuré — la commande ne remontera pas sur l’écran du personnel.');
          finishSuccess();
          return;
        }

        sendBtn.disabled = true;
        sendErrorEl.hidden = true;
        sendBtn.textContent = 'Envoi en cours…';

        fetch(SUPABASE_URL + '/rest/v1/orders', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: SUPABASE_ANON_KEY,
            Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
            Prefer: 'return=minimal',
          },
          body: JSON.stringify(payload),
        })
          .then(function (res) {
            if (!res.ok) throw new Error('http ' + res.status);
            finishSuccess();
          })
          .catch(function (err) {
            console.error('[commande] order insert failed', err);
            sendBtn.disabled = false;
            sendBtn.textContent = 'Envoyer la commande';
            sendErrorEl.hidden = false;
          });
      });

      // ---------------------------------------------------------------------
      // Table number — one single QR code is printed for every table, so the
      // page asks the customer to type their own table number on arrival
      // instead of encoding it per table in the link. Kept in memory only
      // (per visit); the chip in the header reopens this same step to
      // correct a typo mid-session.
      // ---------------------------------------------------------------------
      var gate = document.getElementById('gate');
      var gateDisplay = document.getElementById('gate-display');
      var gateNumpad = document.getElementById('gate-numpad');
      var gateBtn = document.getElementById('gate-btn');
      var tableChipBtn = document.getElementById('table-chip-btn');
      var tableLabelEl = document.getElementById('table-label');
      var gateValue = '';

      function validGateValue() {
        return gateValue.length > 0 ? gateValue : null;
      }
      function renderGateDisplay() {
        gateDisplay.textContent = gateValue.length > 0 ? gateValue : '—';
        gateDisplay.classList.toggle('has-value', gateValue.length > 0);
        gateBtn.disabled = !validGateValue();
      }
      function confirmTable() {
        var v = validGateValue();
        if (!v) return;
        tableLabelEl.textContent = 'Table ' + v;
        gate.hidden = true;
        showHeroIntro();
      }
      function openGate() {
        gateValue = '';
        renderGateDisplay();
        gate.hidden = false;
      }

      gateNumpad.addEventListener('click', function (e) {
        var key = e.target.closest('.gate-key');
        if (!key) return;
        if (key.dataset.num !== undefined) {
          if (gateValue.length < 3) gateValue += key.dataset.num;
        } else if (key.dataset.action === 'back') {
          gateValue = gateValue.slice(0, -1);
        } else if (key.dataset.action === 'clear') {
          gateValue = '';
        }
        renderGateDisplay();
      });
      // Physical keyboard support (handy for desktop / testing; the numpad
      // above is the primary input on the actual table-side device).
      window.addEventListener('keydown', function (e) {
        if (gate.hidden) return;
        if (/^[0-9]$/.test(e.key)) { if (gateValue.length < 3) gateValue += e.key; renderGateDisplay(); }
        else if (e.key === 'Backspace') { gateValue = gateValue.slice(0, -1); renderGateDisplay(); }
        else if (e.key === 'Enter') { confirmTable(); }
      });
      gateBtn.addEventListener('click', confirmTable);
      tableChipBtn.addEventListener('click', openGate);

      // ---------------------------------------------------------------------
      // Cinematic hero intro — shown once per visit, right after the table
      // number is confirmed. Re-opening the gate later (to fix a typo) does
      // not replay it, so it stays a one-time "welcome" moment rather than
      // an obstacle every time the table chip is tapped.
      // ---------------------------------------------------------------------
      var heroIntro = document.getElementById('hero-intro');
      var heroIntroBtn = document.getElementById('hero-intro-btn');
      var heroIntroShown = false;
      function showHeroIntro() {
        if (heroIntroShown) return;
        heroIntroShown = true;
        heroIntro.hidden = false;
        requestAnimationFrame(function () { heroIntro.classList.add('is-visible'); });
      }
      function dismissHeroIntro() {
        heroIntro.classList.remove('is-visible');
        setTimeout(function () { heroIntro.hidden = true; }, 450);
      }
      heroIntroBtn.addEventListener('click', dismissHeroIntro);

      openGate();

      renderFab();
      renderCartSheet();
      renderPlateBuilders();
    })();
  </script>
</body>
</html>
