        { id: 'pa-eclair-amlou', cat: 'patisserie', station: 'cuisine', sub: 'Éclairs', name: 'Éclair Amlou', desc: 'Amande, miel, argan.', price: 40 },
        { id: 'pa-eclair-signature', cat: 'patisserie', station: 'cuisine', sub: 'Éclairs', name: 'Éclair Signature Moë', desc: 'Création du moment.', price: 42 },
        // ---- Pâtisserie — Boulangerie ----
        { id: 'pa-croissant', cat: 'patisserie', station: 'cuisine', sub: 'Boulangerie', name: 'Croissant Pur Beurre', price: 11 },
        { id: 'pa-pain-chocolat', cat: 'patisserie', station: 'cuisine', sub: 'Boulangerie', name: 'Pain au Chocolat', price: 13 },
        { id: 'pa-pain-suisse', cat: 'patisserie', station: 'cuisine', sub: 'Boulangerie', name: 'Pain Suisse', price: 13 },
        { id: 'pa-pain-raisins', cat: 'patisserie', station: 'cuisine', sub: 'Boulangerie', name: 'Pain aux Raisins', price: 13 },
        { id: 'pa-baguette', cat: 'patisserie', station: 'cuisine', sub: 'Boulangerie', name: 'Baguette Tradition', price: 6.5 },
        { id: 'pa-brioche', cat: 'patisserie', station: 'cuisine', sub: 'Boulangerie', name: 'Brioche Artisanale', price: 35 },
      ];

      var ITEMS_BY_ID = {};
      ITEMS.forEach(function (it) { ITEMS_BY_ID[it.id] = it; });

      // ---------------------------------------------------------------------
      // Cart state — in-memory only (no localStorage): one order per table
      // visit, cleared once it's actually sent.
      // ---------------------------------------------------------------------
      var cart = {};

      function currency(n) {
        var v = Math.round(n * 100) / 100;
        return (v % 1 === 0 ? v.toFixed(0) : v.toFixed(2)) + ' ' + CURRENCY_CODE;
      }

      function cartCount() {
        var n = 0;
        for (var id in cart) n += cart[id];
        return n;
      }
      function cartTotal() {
        var t = 0;
        for (var id in cart) t += cart[id] * ITEMS_BY_ID[id].price;
        return t;
      }

      function setQty(id, qty) {
        qty = Math.max(0, qty);
        if (qty === 0) delete cart[id];
        else cart[id] = qty;
        renderQtyControls();
        renderCartSheet();
        renderFab();
        renderOrderStrip();
        renderPlateBuilders();
        updateActivePill(); // also refreshes the plate dock's count/photos
      }

      // ---------------------------------------------------------------------
      // Plate builder — the visual "compose your plate" widget on combo
      // categories (breakfast, brunch). Each item keeps a fixed slot on
      // the plate (by its position in the category) so a dish always
      // lands in the same spot once added, rather than reshuffling.
      // ---------------------------------------------------------------------
      function renderPlateBuilder(catId) {
        var container = document.getElementById('plate-items-' + catId);
        if (!container) return;
        var emptyEl = document.getElementById('plate-empty-' + catId);
        var countEl = document.getElementById('plate-count-' + catId);
        var cat = CATEGORIES_BY_ID[catId];
        var catItems = ITEMS.filter(function (it) { return it.cat === catId; });
        var selected = catItems.filter(function (it) { return (cart[it.id] || 0) > 0; });

        container.innerHTML = catItems.map(function (it, i) {
          var qty = cart[it.id] || 0;
          if (!qty) return '';
          var inner = it.image
            ? '<img src="' + it.image + '" alt="">'
            : '<span class="plate-icon">' + cat.icon + '</span>';
          var badge = qty > 1 ? '<span class="plate-slot-qty">' + qty + '</span>' : '';
          return '<div class="plate-slot plate-slot-' + i + '">' + inner + badge + '</div>';
        }).join('');
        if (emptyEl) emptyEl.hidden = selected.length > 0;
        if (countEl) countEl.textContent = selected.length;
      }
      function renderPlateBuilders() {
        CATEGORIES.forEach(function (cat) {
          if (cat.combo) renderPlateBuilder(cat.id);
        });
      }

      // ---------------------------------------------------------------------
      // Live order strip — sits between the header and the category nav,
      // shows a running row of everything ordered so far so the table can
      // always see their build without opening the cart sheet.
      // ---------------------------------------------------------------------
      var orderStripEl = document.getElementById('order-strip');
      var orderStripScrollEl = document.getElementById('order-strip-scroll');

      function renderOrderStrip() {
        var ids = Object.keys(cart);
        if (ids.length === 0) {
          orderStripEl.hidden = true;
        } else {
          orderStripScrollEl.innerHTML = ids.map(function (id) {
            var it = ITEMS_BY_ID[id];
            var qty = cart[id];
            var cat = CATEGORIES_BY_ID[it.cat];
            var thumb = it.image
              ? '<img class="order-chip-thumb" src="' + it.image + '" alt="">'
              : '<span class="order-chip-thumb">' + cat.icon + '</span>';
            return '<div class="order-chip">' + thumb +
              '<span class="order-chip-name">' + it.name + '</span>' +
              '<span class="order-chip-qty tabular">×' + qty + '</span></div>';
          }).join('');
          orderStripEl.hidden = false;
        }
        updateStickyOffsets();
      }
      orderStripScrollEl.addEventListener('click', function () { openSheet(); });

      // The header's height isn't fixed (the strip toggles, the banner can
      // wrap on narrow phones), so the catnav's sticky offset is measured
      // in JS rather than hardcoded — keeps the two sticky layers stacked
      // correctly under every state instead of overlapping.
      function updateStickyOffsets() {
        var topbarH = document.querySelector('.topbar').offsetHeight;
        var stripH = orderStripEl.hidden ? 0 : orderStripEl.offsetHeight;
        var catnavH = document.querySelector('.catnav').offsetHeight;
        document.documentElement.style.setProperty('--topbar-h', topbarH + 'px');
        document.documentElement.style.setProperty('--strip-h', stripH + 'px');
        document.documentElement.style.setProperty('--catnav-h', catnavH + 'px');
      }
      window.addEventListener('resize', updateStickyOffsets);
      updateStickyOffsets();

      // ---------------------------------------------------------------------
      // "Fly to cart" micro-interaction: a small ghost of the dish photo
      // (or the category icon, for un-photographed items) arcs toward the
      // cart button on every add, then the button badge pulses. Purely a
      // Web Animations API tween — no library needed.
      // ---------------------------------------------------------------------
      function flyToCart(sourceCard) {
        if (!sourceCard || !fab || fab.hidden) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { pulseFab(); return; }
        var imgEl = sourceCard.querySelector('.item-tile img');
        var size = 44;
        var ghost = document.createElement('div');
        var srcRect;
        if (imgEl) {
          srcRect = imgEl.getBoundingClientRect();
          ghost.style.backgroundImage = 'url(' + imgEl.getAttribute('src') + ')';
          ghost.style.backgroundSize = 'cover';
          ghost.style.backgroundPosition = 'center';
        } else {
          var tile = sourceCard.querySelector('.item-tile') || sourceCard;
          srcRect = tile.getBoundingClientRect();
          ghost.style.background = 'var(--accent)';
        }
        ghost.style.position = 'fixed';
        ghost.style.width = size + 'px';
        ghost.style.height = size + 'px';
        ghost.style.left = (srcRect.left + srcRect.width / 2 - size / 2) + 'px';
        ghost.style.top = (srcRect.top + srcRect.height / 2 - size / 2) + 'px';
        ghost.style.borderRadius = '50%';
        ghost.style.zIndex = '60';
        ghost.style.pointerEvents = 'none';
        ghost.style.boxShadow = '0 6px 18px rgba(0,0,0,0.3)';
        document.body.appendChild(ghost);

        var fabRect = fab.getBoundingClientRect();
        var dx = (fabRect.left + 24) - (srcRect.left + srcRect.width / 2 - size / 2);
        var dy = (fabRect.top + fabRect.height / 2) - (srcRect.top + srcRect.height / 2 - size / 2);
        var anim = ghost.animate([
          { transform: 'translate(0px, 0px) scale(1)', opacity: 1 },
          { transform: 'translate(' + (dx * 0.6) + 'px, ' + (dy * 0.35) + 'px) scale(0.7)', opacity: 1, offset: 0.6 },
          { transform: 'translate(' + dx + 'px, ' + dy + 'px) scale(0.15)', opacity: 0.4 },
        ], { duration: 500, easing: 'cubic-bezier(0.3, 0.7, 0.35, 1)' });
        anim.onfinish = function () {
          ghost.remove();
          pulseFab();
        };
      }

      function pulseFab() {
        if (!fab) return;
        fab.classList.remove('is-pulsing');
        void fab.offsetWidth;
        fab.classList.add('is-pulsing');
      }

      var catnavEl = document.getElementById('catnav');
      CATEGORIES.forEach(function (cat) {
        var btn = document.createElement('button');
        btn.className = 'catpill';
        btn.dataset.target = cat.id;
        btn.innerHTML = cat.icon + '<span>' + cat.label + '</span>';
        btn.addEventListener('click', function () {
          document.getElementById('cat-' + cat.id).scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        catnavEl.appendChild(btn);
      });

      var mainEl = document.getElementById('main');

      function qtyControlHtml(id) {
        var qty = cart[id] || 0;
        if (qty === 0) {
          return '<button class="add-btn" data-add="' + id + '" aria-label="Ajouter">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>';
        }
        return '<div class="stepper">' +
          '<button data-dec="' + id + '" aria-label="Retirer">−</button>' +
          '<span class="qty tabular">' + qty + '</span>' +
          '<button data-inc="' + id + '" aria-label="Ajouter">+</button>' +
          '</div>';
      }

      // Bento layout helper: the hero card is the first photographed item
      // in a list, so a section with no photos yet just renders as a
      // uniform grid (nothing to promote) instead of guessing.
      function firstPhotoId(list) {
        for (var i = 0; i < list.length; i++) {
          if (list[i].image) return list[i].id;
        }
        return null;
      }

      CATEGORIES.forEach(function (cat) {
        var section = document.createElement('section');
        section.className = 'category';
        section.id = 'cat-' + cat.id;

        var head = '<div class="cat-head">' + cat.icon + '<h2>' + cat.label + '</h2></div>';
        if (cat.sub) head += '<p class="cat-sub">' + cat.sub + '</p>';
        if (cat.combo) {
          // Visual "build your plate" widget instead of a text banner: as
          // the customer adds dishes from this category, their photos
          // appear scattered on a plate graphic, live, so composing a
          // combo actually looks like composing a plate.
          head +=
            '<div class="plate-builder" id="plate-builder-' + cat.id + '">' +
              '<div class="plate-visual">' +
                '<div class="plate-items" id="plate-items-' + cat.id + '"></div>' +
                '<p class="plate-empty" id="plate-empty-' + cat.id + '">Composez<br>votre assiette</p>' +
              '</div>' +
              '<p class="plate-caption"><strong id="plate-count-' + cat.id + '">0</strong> assiette(s) sélectionnée(s) — ' + cat.combo + '</p>' +
            '</div>';
        }
        section.innerHTML = head;

        var items = ITEMS.filter(function (it) { return it.cat === cat.id; });

        if (cat.style === 'cards') {
          var grid = document.createElement('div');
          grid.className = 'card-grid';
          var heroId = firstPhotoId(items);
          items.forEach(function (it) {
            var card = document.createElement('div');
            card.className = 'item-card' + (it.id === heroId ? ' is-hero' : '');
            var tileInner = it.image
              ? '<img src="' + it.image + '" alt="" loading="lazy">'
              : cat.icon;
            card.innerHTML =
              '<div class="item-tile">' + tileInner + '</div>' +
              '<div class="item-name">' + it.name + '</div>' +
              (it.desc ? '<div class="item-desc">' + it.desc + '</div>' : '<div class="item-desc"></div>') +
              '<div class="item-foot"><span class="item-price tabular">' + currency(it.price) + '</span><span class="qty-slot" data-slot="' + it.id + '">' + qtyControlHtml(it.id) + '</span></div>';
            grid.appendChild(card);
          });
          section.appendChild(grid);
        } else {
          var subs = [];
          items.forEach(function (it) { if (it.sub && subs.indexOf(it.sub) === -1) subs.push(it.sub); });
          var list = document.createElement('div');
          subs.forEach(function (subLabel) {
            var subEl = document.createElement('div');
            subEl.className = 'subgroup-label';
            subEl.textContent = subLabel;
            list.appendChild(subEl);
            var subItems = items.filter(function (it) { return it.sub === subLabel; });
            // A subgroup with real photography (e.g. Moëtcha) gets the same
            // full-photo card treatment as the dish categories, instead of
            // the compact thumbnail row used for un-photographed subgroups.
            var hasPhotos = subItems.some(function (it) { return !!it.image; });
            if (hasPhotos) {
              var subGrid = document.createElement('div');
              subGrid.className = 'card-grid';
              var subHeroId = firstPhotoId(subItems);
              subItems.forEach(function (it) {
                var card = document.createElement('div');
                card.className = 'item-card' + (it.id === subHeroId ? ' is-hero' : '');
                var tileInner = it.image
                  ? '<img src="' + it.image + '" alt="" loading="lazy">'
                  : cat.icon;
                card.innerHTML =
                  '<div class="item-tile">' + tileInner + '</div>' +
                  '<div class="item-name">' + it.name + '</div>' +
                  (it.desc ? '<div class="item-desc">' + it.desc + '</div>' : '<div class="item-desc"></div>') +
                  '<div class="item-foot"><span class="item-price tabular">' + currency(it.price) + '</span><span class="qty-slot" data-slot="' + it.id + '">' + qtyControlHtml(it.id) + '</span></div>';
                subGrid.appendChild(card);
              });
              list.appendChild(subGrid);
              return;
            }
            var rowList = document.createElement('div');
            rowList.className = 'row-list';
            subItems.forEach(function (it) {
              var row = document.createElement('div');
              row.className = 'item-row';
              row.innerHTML =
                '<div class="row-main"><div class="item-name">' + it.name + '</div>' +
                (it.desc ? '<div class="item-desc">' + it.desc + '</div>' : '') + '</div>' +
                '<span class="row-price tabular">' + currency(it.price) + '</span>' +
                '<span class="qty-slot" data-slot="' + it.id + '">' + qtyControlHtml(it.id) + '</span>';
              rowList.appendChild(row);
            });
            list.appendChild(rowList);
          });
          section.appendChild(list);
        }

        mainEl.appendChild(section);
      });

      // Delegate qty-button clicks (+, -, add) — one listener instead of one
      // per button since a re-render swaps innerHTML on every change.
      mainEl.addEventListener('click', function (e) {
        var addId = e.target.closest('[data-add]');
        var incId = e.target.closest('[data-inc]');
        var decId = e.target.closest('[data-dec]');
        var sourceCard = e.target.closest('.item-card') || e.target.closest('.item-row');
        if (addId) { setQty(addId.getAttribute('data-add'), 1); flyToCart(sourceCard); }
        else if (incId) { setQty(incId.getAttribute('data-inc'), (cart[incId.getAttribute('data-inc')] || 0) + 1); flyToCart(sourceCard); }
        else if (decId) setQty(decId.getAttribute('data-dec'), (cart[decId.getAttribute('data-dec')] || 0) - 1);
      });

      function renderQtyControls() {
        document.querySelectorAll('.qty-slot').forEach(function (slot) {
          var id = slot.getAttribute('data-slot');
          slot.innerHTML = qtyControlHtml(id);
        });
      }

      // ---------------------------------------------------------------------
      // Active category highlight on scroll
      // ---------------------------------------------------------------------
      var sections = CATEGORIES.map(function (c) { return document.getElementById('cat-' + c.id); });
      var pills = Array.prototype.slice.call(document.querySelectorAll('.catpill'));
      function updateActivePill() {
        var probeY = 150;
        var activeIdx = 0;
        sections.forEach(function (sec, i) {
          if (sec.getBoundingClientRect().top - probeY <= 0) activeIdx = i;
        });
        pills.forEach(function (p, i) { p.classList.toggle('is-active', i === activeIdx); });
        updatePlateDock(CATEGORIES[activeIdx]);
      }
      window.addEventListener('scroll', updateActivePill, { passive: true });
      window.addEventListener('resize', updateActivePill);

      // ---------------------------------------------------------------------
      // Plate dock — the mini floating version of the plate builder (see
      // renderPlateBuilder above). Shows only once the full-size plate for
      // the currently-viewed category has scrolled above the sticky header
      // stack, and only while that category still has items on it.
      // ---------------------------------------------------------------------
      var plateDockEl = document.getElementById('plate-dock');
      var plateDockVisualEl = document.getElementById('plate-dock-visual');
      var plateDockCountEl = document.getElementById('plate-dock-count');

      function updatePlateDock(activeCat) {
        if (!activeCat || !activeCat.combo) { plateDockEl.hidden = true; return; }
        var plateEl = document.getElementById('plate-builder-' + activeCat.id);
        if (!plateEl) { plateDockEl.hidden = true; return; }

        var catItems = ITEMS.filter(function (it) { return it.cat === activeCat.id; });
        var selected = catItems.filter(function (it) { return (cart[it.id] || 0) > 0; });
        if (selected.length === 0) { plateDockEl.hidden = true; return; }

        var headerH = document.querySelector('.topbar').offsetHeight +
          (orderStripEl.hidden ? 0 : orderStripEl.offsetHeight) +
          document.querySelector('.catnav').offsetHeight;
        var scrolledPast = plateEl.getBoundingClientRect().bottom < headerH;
        plateDockEl.hidden = !scrolledPast;
        if (!scrolledPast) return;

        // Same fixed per-dish slot index as the full plate (see
        // renderPlateBuilder) — a dish sits in the same ring position in
        // both places, just smaller here.
        plateDockVisualEl.innerHTML = catItems.map(function (it, i) {
          var qty = cart[it.id] || 0;
          if (!qty) return '';
          var inner = it.image
            ? '<img src="' + it.image + '" alt="">'
            : '<span class="plate-icon">' + activeCat.icon + '</span>';
          var badge = qty > 1 ? '<span class="plate-slot-qty">' + qty + '</span>' : '';
          return '<div class="plate-slot plate-slot-' + i + '">' + inner + badge + '</div>';
        }).join('');
        plateDockCountEl.textContent = selected.length;
        plateDockEl.onclick = function () {
          plateEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };
      }
      updateActivePill();

      // ---------------------------------------------------------------------
      // Cart sheet + FAB
      // ---------------------------------------------------------------------
      var fab = document.getElementById('cart-fab');
      var fabCount = document.getElementById('fab-count');
      var fabTotal = document.getElementById('fab-total');
      var overlay = document.getElementById('overlay');
      var sheet = document.getElementById('sheet');
      var cartLinesEl = document.getElementById('cart-lines');
      var sheetTotalEl = document.getElementById('sheet-total');
      var sendBtn = document.getElementById('send-btn');
      var sendErrorEl = document.getElementById('send-error');
      var orderView = document.getElementById('sheet-order-view');
      var confirmView = document.getElementById('sheet-confirm-view');

      function renderFab() {
        var n = cartCount();
        fab.hidden = n === 0;
        fabCount.textContent = n;
        fabTotal.textContent = currency(cartTotal());
      }

      function renderCartSheet() {
        var ids = Object.keys(cart);
        if (ids.length === 0) {
          cartLinesEl.innerHTML = '<p class="cart-empty">Votre commande est vide pour l’instant.<br>Ajoutez des plats depuis le menu.</p>';
          sendBtn.disabled = true;
        } else {
          cartLinesEl.innerHTML = '';
          ids.forEach(function (id) {
            var it = ITEMS_BY_ID[id];
            var qty = cart[id];
            var line = document.createElement('div');
            line.className = 'cart-line';
            line.innerHTML =
              '<div class="cart-line-main"><div class="cart-line-name">' + it.name + '</div>' +
              '<div class="cart-line-price tabular">' + currency(it.price) + ' × ' + qty + ' = ' + currency(it.price * qty) + '</div></div>' +
              '<span class="qty-slot-cart"></span>';
            var stepperSlot = line.querySelector('.qty-slot-cart');
            stepperSlot.innerHTML = qtyControlHtml(id);
            cartLinesEl.appendChild(line);
          });
          sendBtn.disabled = false;
        }
        sheetTotalEl.textContent = currency(cartTotal());
      }

      cartLinesEl.addEventListener('click', function (e) {
        var incId = e.target.closest('[data-inc]');
        var decId = e.target.closest('[data-dec]');
        var addId = e.target.closest('[data-add]');
        if (incId) setQty(incId.getAttribute('data-inc'), (cart[incId.getAttribute('data-inc')] || 0) + 1);
        else if (decId) setQty(decId.getAttribute('data-dec'), (cart[decId.getAttribute('data-dec')] || 0) - 1);
        else if (addId) setQty(addId.getAttribute('data-add'), 1);
      });

      function openSheet() {
        orderView.hidden = false;
        confirmView.hidden = true;
        overlay.classList.add('is-open');
        sheet.classList.add('is-open');
      }
      function closeSheet() {
        overlay.classList.remove('is-open');
        sheet.classList.remove('is-open');
      }

      fab.addEventListener('click', openSheet);
      overlay.addEventListener('click', closeSheet);
      document.getElementById('sheet-close').addEventListener('click', closeSheet);
      document.getElementById('confirm-close').addEventListener('click', function () {
        closeSheet();
      });

      // ---------------------------------------------------------------------
      // Send order — writes straight into the SAME Supabase `orders` table
      // CartWidget.astro used to write to (see this file's top comment).
      // Fails safe: on a network/API error the cart is left untouched and
      // an inline message asks the customer to retry or flag a team member,
      // instead of silently pretending the order went through.
      // ---------------------------------------------------------------------
      sendBtn.addEventListener('click', function () {
        if (sendBtn.disabled) return;
        var n = cartCount();
        var tableLabel = document.getElementById('table-label').textContent;
        var tableNumber = tableLabel.replace(/^Table\s*/, '');
        var ids = Object.keys(cart);
        var total = cartTotal();
        var now = new Date();
        var hhmm = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');

        var payload = {
          order_ref: 'QR T' + tableNumber + ' · ' + hhmm,
          customer_name: tableLabel,
          customer_phone: null,
          order_type: 'dinein',
          address_or_table: tableLabel,
          items: ids.map(function (id) {
            var it = ITEMS_BY_ID[id];
            return { name: it.name, quantity: cart[id], price: it.price, station: it.station };
          }),
          total: total,
          notes: null,
          status: 'pending',
        };

        function finishSuccess() {
          document.getElementById('confirm-detail').textContent =
            'L’équipe a reçu votre commande (' + n + (n > 1 ? ' articles' : ' article') + ') pour la ' + tableLabel.toLowerCase() + '.';
          sendErrorEl.hidden = true;
          orderView.hidden = true;
          confirmView.hidden = false;
          cart = {};
          renderQtyControls();
          renderFab();
          sendBtn.disabled = false;
          sendBtn.textContent = 'Envoyer la commande';
        }

        if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
          console.warn('[commande] Supabase non configuré — la commande ne remontera pas sur l’écran du personnel.');
          finishSuccess();
          return;
        }

        sendBtn.disabled = true;
        sendErrorEl.hidden = true;
        sendBtn.textContent = 'Envoi en cours…';

        fetch(SUPABASE_URL + '/rest/v1/orders', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: SUPABASE_ANON_KEY,
            Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
            Prefer: 'return=minimal',
          },
          body: JSON.stringify(payload),
        })
          .then(function (res) {
            if (!res.ok) throw new Error('http ' + res.status);
            finishSuccess();
          })
          .catch(function (err) {
            console.error('[commande] order insert failed', err);
            sendBtn.disabled = false;
            sendBtn.textContent = 'Envoyer la commande';
            sendErrorEl.hidden = false;
          });
      });

      // ---------------------------------------------------------------------
      // Table number — one single QR code is printed for every table, so the
      // page asks the customer to type their own table number on arrival
      // instead of encoding it per table in the link. Kept in memory only
      // (per visit); the chip in the header reopens this same step to
      // correct a typo mid-session.
      // ---------------------------------------------------------------------
      var gate = document.getElementById('gate');
      var gateInput = document.getElementById('gate-input');
      var gateBtn = document.getElementById('gate-btn');
      var tableChipBtn = document.getElementById('table-chip-btn');
      var tableLabelEl = document.getElementById('table-label');

      function validGateValue() {
        var v = gateInput.value.replace(/\D/g, '');
        return v.length > 0 ? v : null;
      }
      function updateGateBtn() {
        gateBtn.disabled = !validGateValue();
      }
      function confirmTable() {
        var v = validGateValue();
        if (!v) return;
        tableLabelEl.textContent = 'Table ' + v;
        gate.hidden = true;
        showHeroIntro();
      }
      function openGate() {
        gateInput.value = '';
        updateGateBtn();
        gate.hidden = false;
        setTimeout(function () { gateInput.focus(); }, 50);
      }

      gateInput.addEventListener('input', updateGateBtn);
      gateInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') confirmTable();
      });
      gateBtn.addEventListener('click', confirmTable);
      tableChipBtn.addEventListener('click', openGate);

      // ---------------------------------------------------------------------
      // Cinematic hero intro — shown once per visit, right after the table
      // number is confirmed. Re-opening the gate later (to fix a typo) does
      // not replay it, so it stays a one-time "welcome" moment rather than
      // an obstacle every time the table chip is tapped.
      // ---------------------------------------------------------------------
      var heroIntro = document.getElementById('hero-intro');
      var heroIntroBtn = document.getElementById('hero-intro-btn');
      var heroIntroShown = false;
      function showHeroIntro() {
        if (heroIntroShown) return;
        heroIntroShown = true;
        heroIntro.hidden = false;
        requestAnimationFrame(function () { heroIntro.classList.add('is-visible'); });
      }
      function dismissHeroIntro() {
        heroIntro.classList.remove('is-visible');
        setTimeout(function () { heroIntro.hidden = true; }, 450);
      }
      heroIntroBtn.addEventListener('click', dismissHeroIntro);

      openGate();

      renderFab();
      renderCartSheet();
      renderPlateBuilders();
    })();
  </script>
</body>
</html>
