---
// Commande à table (QR code sur chaque table), v1 — Sept 2026.
//
// Deliberately NOT built on Layout.astro: this is a focused ordering
// screen meant to be scanned and used at the table, not a marketing page,
// so it skips Header/Footer/WhatsApp entirely and ships its own minimal
// <html> document (same idea as staff-screen/index.html and public/screen
// living outside the Layout-wrapped page tree).
//
// One QR code is printed for every table (not one per table) — the page
// asks the customer to type their table number on arrival instead of
// encoding it in the link (see the #gate overlay below).
//
// Writes real orders into the SAME `orders` table CartWidget.astro used to
// write to before the in-site cart was removed sitewide from the main menu
// (Amar, Sept 2026 — "het menu moet gewoon alleen visueel zijn"). That
// removal only affected the marketing site's Menu page; the Supabase
// project, its `orders` table/RLS policies, and the staff screen at
// /screen were never torn down — this page reconnects to that same
// existing backend rather than rebuilding it, so orders placed here appear
// live on /screen exactly the way they did before. Insert pattern (POST to
// {supabaseUrl}/rest/v1/orders, apikey + Authorization headers, fire on
// submit) is copied from CartWidget.astro's checkout handler.
//
// FR-only for this first version — the rest of the site is FR/EN/AR but a
// table-side ordering screen doesn't need to wait on a full trilingual
// pass to be useful; `lang` is threaded through anyway so EN/AR can be
// added later without restructuring this file.
import { siteConfig } from '../config/site.config';
import type { Language } from '../i18n/languages';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name: restaurantName } = siteConfig.identity;
const { currency: currencyCode } = siteConfig.identity;
const { supabaseUrl, supabaseAnonKey } = siteConfig.ordering;
---
<!doctype html>
<html lang={lang} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Commande à table — {restaurantName}</title>
  <meta name="description" content="Commandez directement depuis votre table par QR code." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600;6..96,700&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    /* is:global — most of this page's DOM (menu cards, cart lines,
       category nav) is built client-side via document.createElement /
       innerHTML in the script below, and Astro's default scoped styles
       only tag elements present in the static build-time template with
       the data-astro-cid attribute its compiled selectors match against.
       Scoped mode would silently drop every rule below for anything the
       script renders — global is correct and safe here since this is a
       standalone document that shares no DOM with any other page. */
    :root {
      --bg: #F7F0DC;
      --surface: #FFFCF3;
      --surface-2: #EFE4C4;
      --text: #3A2A1E;
      --text-muted: #7A6A57;
      --border: rgba(58,42,30,0.14);
      --accent: #3F5D45;
      --accent-soft: #E4EADD;
      --brown: #6B4A34;
      --danger: #B3492F;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, .display { font-family: 'Bodoni Moda', Georgia, serif; }
    img { max-width: 100%; }
    button { font-family: inherit; cursor: pointer; }
    .tabular { font-variant-numeric: tabular-nums; }

    /* ---------- header ---------- */
    .topbar {
      position: sticky;
      top: env(safe-area-inset-top, 0px);
      z-index: 30;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .topbar-inner {
      max-width: 720px;
      margin: 0 auto;
      padding: 14px 16px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .wordmark {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      line-height: 1;
    }
    .wordmark-logo {
      height: 26px;
      width: auto;
      display: block;
    }
    .wordmark small {
      display: block;
      font-family: 'Inter', sans-serif;
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 0.28em;
      color: var(--accent);
    }
    .table-chip {
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 7px 14px;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text);
      white-space: nowrap;
      cursor: pointer;
    }
    .table-chip:active { background: var(--surface-2); }
    .table-chip .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
    }
    .draft-banner {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 16px 10px;
      font-size: 0.72rem;
      line-height: 1.4;
      color: var(--text-muted);
    }
    .draft-banner strong { color: var(--text); }

    /* ---------- live order strip ----------
       Shows, as soon as the cart has items, a horizontally scrolling row
       of thumbnails for everything ordered so far — the "see what you've
       ordered" visual the table itself asked for, always visible without
       opening the cart sheet. --topbar-h / --strip-h are measured in JS
       (updateStickyOffsets) so the catnav below always stacks correctly
       whether or not the strip is showing. */
    .order-strip {
      position: sticky;
      top: calc(env(safe-area-inset-top, 0px) + var(--topbar-h, 62px));
      z-index: 29;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .order-strip[hidden] { display: none; }
    .order-strip-scroll {
      max-width: 720px;
      margin: 0 auto;
      padding: 9px 16px;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .order-strip-scroll::-webkit-scrollbar { display: none; }
    .order-chip {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 7px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 4px 12px 4px 4px;
      animation: chipIn 0.25s ease;
    }
    @keyframes chipIn {
      from { opacity: 0; transform: scale(0.85); }
      to { opacity: 1; transform: scale(1); }
    }
    .order-chip-thumb {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      background: var(--accent-soft);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .order-chip-thumb svg { width: 14px; height: 14px; color: var(--accent); }
    .order-chip-name {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text);
      max-width: 86px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .order-chip-qty {
      font-size: 0.68rem;
      font-weight: 800;
      color: var(--accent);
      font-family: 'Bodoni Moda', Georgia, serif;
    }

    /* ---------- category nav ---------- */
    .catnav {
      position: sticky;
      top: calc(env(safe-area-inset-top, 0px) + var(--topbar-h, 62px) + var(--strip-h, 0px));
      z-index: 28;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding-block: 10px;
    }
    .catnav-scroll {
      max-width: 720px;
      margin: 0 auto;
      padding-inline: 16px;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .catnav-scroll::-webkit-scrollbar { display: none; }
    .catpill {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .catpill.is-active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--surface);
    }
    .catpill svg { width: 14px; height: 14px; flex-shrink: 0; }

    /* ---------- main ---------- */
    main {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 16px 140px;
    }
    section.category, .plate-builder {
      /* Kept in sync with the actual sticky header stack (topbar + live
         order strip + catnav) via JS, instead of a hardcoded guess — the
         strip's height changes as the cart fills, so a fixed value would
         drift and tuck section headings (or the plate dock's scroll
         target) behind the sticky bars. Applied to .plate-builder too,
         since the plate dock scrolls straight to that element rather
         than to the whole section. */
      scroll-margin-top: calc(env(safe-area-inset-top, 0px) + var(--topbar-h, 62px) + var(--strip-h, 0px) + var(--catnav-h, 54px) + 12px);
    }
    section.category {
      padding-block: 28px 8px;
    }
    .cat-head {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 4px;
    }
    .cat-head svg { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; }
    .cat-head h2 {
      font-size: 1.4rem;
      font-weight: 600;
      margin: 0;
      text-wrap: balance;
    }
    .cat-sub {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 4px 0 16px;
      max-width: 60ch;
      line-height: 1.5;
    }
    /* ---------- plate builder ----------
       Replaces the old text "combine these freely" banner on combo
       categories (breakfast, brunch): a plate graphic that fills with
       the customer's own dish photos, live, as they add things from
       this category. Slot positions are fixed per item index so a given
       dish always lands in the same spot on the plate. */
    .plate-builder {
      display: flex;
      align-items: center;
      gap: 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      margin-bottom: 16px;
    }
    .plate-visual {
      position: relative;
      width: 108px;
      height: 108px;
      border-radius: 50%;
      flex-shrink: 0;
      background: radial-gradient(circle at 35% 30%, var(--surface) 0%, var(--surface-2) 68%, var(--border) 100%);
      box-shadow: inset 0 2px 10px rgba(0,0,0,0.08), 0 3px 10px rgba(0,0,0,0.08);
    }
    .plate-empty {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 0.6rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--text-muted);
      line-height: 1.4;
      padding: 0 10px;
    }
    .plate-empty[hidden] { display: none; }
    .plate-items { position: absolute; inset: 0; }
    .plate-slot {
      position: absolute;
      width: 30px;
      height: 30px;
      transform: translate(-50%, -50%);
    }
    .plate-slot-0 { left: 50%; top: 14%; }
    .plate-slot-1 { left: 76%; top: 24%; }
    .plate-slot-2 { left: 86%; top: 50%; }
    .plate-slot-3 { left: 76%; top: 76%; }
    .plate-slot-4 { left: 50%; top: 86%; }
    .plate-slot-5 { left: 24%; top: 76%; }
    .plate-slot-6 { left: 14%; top: 50%; }
    .plate-slot-7 { left: 24%; top: 24%; }
    .plate-slot img, .plate-slot .plate-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      background: var(--accent-soft);
      border: 2px solid var(--surface);
      box-shadow: 0 3px 8px rgba(0,0,0,0.2);
      animation: plateSlotIn 0.3s ease;
    }
    .plate-slot .plate-icon svg { width: 13px; height: 13px; color: var(--accent); }
    .plate-slot-qty {
      position: absolute;
      bottom: -3px;
      right: -3px;
      background: var(--accent);
      color: var(--surface);
      font-size: 0.55rem;
      font-weight: 800;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid var(--surface);
    }
    @keyframes plateSlotIn {
      from { transform: scale(0); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .plate-caption {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.5;
    }
    .plate-caption strong {
      color: var(--accent);
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: 1rem;
    }
    @media (prefers-reduced-motion: reduce) {
      .plate-slot img, .plate-slot .plate-icon { animation: none; }
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    @media (max-width: 420px) {
      .card-grid { grid-template-columns: 1fr; }
    }
    .item-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .item-tile {
      aspect-ratio: 4 / 3;
      border-radius: 10px;
      background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 20%, var(--surface-2)), var(--surface-2));
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .item-tile svg { width: 30px; height: 30px; color: var(--accent); opacity: 0.75; }
    .item-tile img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Bento layout: the first dish of every photographed category is
       promoted to a wide "hero" tile instead of matching the uniform
       grid — breaks the repeating-card monotony without needing any
       per-item authoring (it's always the category's opening dish). */
    .item-card.is-hero {
      grid-column: 1 / -1;
    }
    .item-card.is-hero .item-tile {
      aspect-ratio: 16 / 8;
    }
    .item-card.is-hero .item-name {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: 1.15rem;
      font-weight: 600;
    }
    .item-card.is-hero .item-desc { font-size: 0.82rem; }
    .item-name {
      font-weight: 700;
      font-size: 0.92rem;
      line-height: 1.25;
    }
    .item-desc {
      font-size: 0.76rem;
      color: var(--text-muted);
      line-height: 1.4;
      flex: 1;
    }
    .item-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 2px;
    }
    .item-price {
      font-weight: 700;
      font-size: 0.88rem;
      font-family: 'Bodoni Moda', Georgia, serif;
    }

    .subgroup-label {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 18px 0 8px;
    }
    .subgroup-label:first-child { margin-top: 0; }
    .row-list { display: flex; flex-direction: column; gap: 6px; }
    .item-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
    }
    .item-row .item-name { font-size: 0.85rem; }
    .item-row .item-desc { font-size: 0.72rem; margin-top: 1px; }
    .row-main { flex: 1; min-width: 0; }
    .row-price {
      font-weight: 700;
      font-size: 0.82rem;
      font-family: 'Bodoni Moda', Georgia, serif;
      white-space: nowrap;
    }

    .stepper {
      display: flex;
      align-items: center;
      gap: 0;
      border: 1px solid var(--border);
      border-radius: 999px;
      overflow: hidden;
      background: var(--surface);
      flex-shrink: 0;
    }
    .stepper button {
      width: 26px; height: 26px;
      display: flex; align-items: center; justify-content: center;
      background: none; border: none; color: var(--text);
      font-size: 1rem;
      line-height: 1;
    }
    .stepper button:active { background: var(--surface-2); }
    .stepper .qty {
      min-width: 18px;
      text-align: center;
      font-size: 0.8rem;
      font-weight: 700;
    }
    .add-btn {
      width: 26px; height: 26px;
      border-radius: 999px;
      border: none;
      background: var(--accent);
      color: var(--surface);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .add-btn svg { width: 14px; height: 14px; }

    .cart-fab {
      position: fixed;
      left: 50%;
      transform: translateX(-50%);
      bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--brown);
      color: var(--surface);
      border: none;
      border-radius: 999px;
      padding: 13px 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      font-weight: 700;
      font-size: 0.88rem;
      max-width: calc(100% - 32px);
    }
    .cart-fab[hidden] { display: none; }
    .cart-fab .badge {
      background: var(--surface);
      color: var(--brown);
      border-radius: 999px;
      min-width: 20px;
      height: 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.72rem;
      padding: 0 5px;
    }
    .cart-fab .total { font-family: 'Bodoni Moda', Georgia, serif; }
    .cart-fab.is-pulsing .badge { animation: fabBadgePulse 0.45s ease; }
    @keyframes fabBadgePulse {
      0% { transform: scale(1); }
      45% { transform: scale(1.4); }
      100% { transform: scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .cart-fab.is-pulsing .badge { animation: none; }
      .order-chip { animation: none; }
    }

    /* ---------- plate dock ----------
       Once the full plate-builder scrolls out of view (above the sticky
       header stack) while still inside its category, this small floating
       badge takes over: a miniature of the same plate, always in view,
       tappable to jump straight back to the full widget. Sits opposite
       the cart button so the two never collide. */
    .plate-dock {
      position: fixed;
      left: 16px;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
      z-index: 39;
      width: 76px;
      height: 76px;
      border-radius: 50%;
      border: none;
      padding: 0;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: plateDockIn 0.25s ease;
    }
    .plate-dock[hidden] { display: none; }
    @keyframes plateDockIn {
      from { opacity: 0; transform: scale(0.7); }
      to { opacity: 1; transform: scale(1); }
    }
    /* Same ring layout as the full plate-visual (identical .plate-slot-N
       percentage positions, reused as-is), just scaled down and with its
       own mini ceramic-plate backdrop — so the dock reads as a shrunk
       copy of the real thing rather than a different widget. */
    .plate-dock-visual {
      position: relative;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, var(--surface) 0%, var(--surface-2) 68%, var(--border) 100%);
      box-shadow: inset 0 2px 8px rgba(0,0,0,0.08), 0 8px 20px rgba(0,0,0,0.22);
    }
    .plate-dock-visual .plate-slot { width: 19px; height: 19px; }
    .plate-dock-visual .plate-slot-qty {
      width: 12px;
      height: 12px;
      font-size: 0.46rem;
      bottom: -2px;
      right: -2px;
    }
    .plate-dock-count {
      position: absolute;
      bottom: -2px;
      right: -2px;
      background: var(--accent);
      color: var(--surface);
      font-size: 0.62rem;
      font-weight: 800;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--bg);
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
    @media (prefers-reduced-motion: reduce) {
      .plate-dock { animation: none; }
    }

    .sheet-overlay {
      position: fixed; inset: 0;
      background: rgba(20,14,8,0.45);
      z-index: 50;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    .sheet-overlay.is-open { opacity: 1; pointer-events: auto; }

    .sheet {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      z-index: 51;
      background: var(--bg);
      border-radius: 20px 20px 0 0;
      max-height: 82vh;
      display: flex;
      flex-direction: column;
      transform: translateY(100%);
      transition: transform 0.25s cubic-bezier(0.16,1,0.3,1);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .sheet.is-open { transform: translateY(0); }
    .sheet-handle {
      width: 36px; height: 4px;
      background: var(--border);
      border-radius: 999px;
      margin: 10px auto 4px;
    }
    .sheet-head {
      padding: 8px 20px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .sheet-head h3 { margin: 0; font-size: 1.15rem; }
    .sheet-close {
      background: none; border: none; color: var(--text-muted);
      font-size: 1.3rem; line-height: 1; padding: 4px;
    }
    .sheet-body {
      overflow-y: auto;
      padding: 12px 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .cart-line {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-block: 8px;
      border-bottom: 1px solid var(--border);
    }
    .cart-line-main { flex: 1; min-width: 0; }
    .cart-line-name { font-weight: 700; font-size: 0.86rem; }
    .cart-line-price { font-size: 0.74rem; color: var(--text-muted); }
    .cart-empty {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
      padding: 30px 10px;
    }
    .sheet-foot {
      border-top: 1px solid var(--border);
      padding: 14px 20px calc(16px + env(safe-area-inset-bottom, 0px));
      background: var(--surface);
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 12px;
    }
    .total-row .label { font-size: 0.85rem; color: var(--text-muted); }
    .total-row .value { font-family: 'Bodoni Moda', Georgia, serif; font-size: 1.3rem; font-weight: 700; }
    .send-btn {
      width: 100%;
      background: var(--accent);
      color: var(--surface);
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-weight: 700;
      font-size: 0.92rem;
    }
    .send-btn:disabled { opacity: 0.5; }
    .send-error {
      color: var(--danger);
      font-size: 0.76rem;
      margin: 10px 0 0;
      line-height: 1.4;
    }

    .confirm-view {
      padding: 30px 20px 10px;
      text-align: center;
    }
    .confirm-icon {
      width: 52px; height: 52px;
      border-radius: 50%;
      background: var(--accent-soft);
      color: var(--accent);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 14px;
    }
    .confirm-icon svg { width: 26px; height: 26px; }
    .confirm-view h3 { margin: 0 0 6px; }
    .confirm-view p { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 18px; }
    .confirm-close {
      background: var(--brown);
      color: var(--surface);
      border: none;
      border-radius: 999px;
      padding: 11px 22px;
      font-weight: 700;
      font-size: 0.85rem;
    }

    /* ---------- table gate ---------- */
    .gate-overlay {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      padding-block: calc(24px + env(safe-area-inset-top, 0px)) calc(24px + env(safe-area-inset-bottom, 0px));
    }
    .gate-card {
      width: 100%;
      max-width: 340px;
      text-align: center;
    }
    .gate-logo {
      width: 160px;
      height: auto;
      margin: 0 auto 10px;
      display: block;
    }
    .gate-eyebrow {
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.26em;
      color: var(--accent);
      margin-bottom: 26px;
    }
    .gate-question {
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .gate-hint {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 20px;
      line-height: 1.5;
    }
    .gate-input {
      width: 100%;
      text-align: center;
      font-family: 'Bodoni Moda', Georgia, serif;
      font-size: 2.4rem;
      font-weight: 600;
      color: var(--text);
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      padding: 14px 10px;
      margin-bottom: 16px;
    }
    .gate-input::-webkit-outer-spin-button,
    .gate-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .gate-input:focus {
      outline: none;
      border-color: var(--accent);
    }
    .gate-btn {
      width: 100%;
      background: var(--accent);
      color: var(--surface);
      border: none;
      border-radius: 12px;
      padding: 15px;
      font-weight: 700;
      font-size: 0.95rem;
    }
    .gate-btn:disabled { opacity: 0.4; }
    .gate-note {
      margin-top: 18px;
      font-size: 0.7rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* ---------- cinematic hero intro ----------
       Shown once, right after the table number is confirmed: a full-bleed
       shot of the room's food with the logo and a single tap-in, instead
       of dropping straight into a scrolling card grid. Sets the tone
       before the utilitarian ordering UI takes over. */
    .hero-intro {
      position: fixed;
      inset: 0;
      z-index: 65;
      opacity: 0;
      transition: opacity 0.45s ease;
    }
    .hero-intro[hidden] { display: none; }
    .hero-intro.is-visible { opacity: 1; }
    .hero-intro-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hero-intro-scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(20,14,8,0.35) 0%, rgba(20,14,8,0.05) 30%, rgba(20,14,8,0.15) 55%, rgba(20,14,8,0.92) 100%);
    }
    .hero-intro-content {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      text-align: center;
      padding: calc(env(safe-area-inset-top, 0px) + 32px) 28px calc(env(safe-area-inset-bottom, 0px) + 36px);
      transform: translateY(14px);
      transition: transform 0.55s ease;
    }
    .hero-intro.is-visible .hero-intro-content { transform: translateY(0); }
    .hero-intro-logo {
      width: 168px;
      height: auto;
      background: var(--surface);
      border-radius: 18px;
      padding: 14px 18px;
      box-shadow: 0 14px 34px rgba(0,0,0,0.35);
      margin-bottom: auto;
      margin-top: 6px;
    }
    .hero-intro-tag {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.82);
      margin-bottom: 8px;
    }
    .hero-intro-title {
      font-family: 'Bodoni Moda', Georgia, serif;
      font-weight: 600;
      font-size: 1.7rem;
      color: var(--surface);
      line-height: 1.25;
      text-wrap: balance;
      margin-bottom: 22px;
      max-width: 30ch;
    }
    .hero-intro-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--surface);
      color: var(--text);
      border: none;
      border-radius: 999px;
      padding: 15px 26px;
      font-weight: 700;
      font-size: 0.9rem;
      box-shadow: 0 10px 28px rgba(0,0,0,0.35);
    }
    .hero-intro-btn svg { width: 16px; height: 16px; }
    @media (prefers-reduced-motion: reduce) {
      .hero-intro, .hero-intro-content { transition: none; }
    }

    [hidden] { display: none !important; }
  </style>
</head>
<body>
  <div class="gate-overlay" id="gate">
    <div class="gate-card">
      <img class="gate-logo" src="/images/logo-moe.png" alt="Moë Tea Room">
