---
// Home page body — one shared template for all three languages. The
// per-locale route files (src/pages/index.astro, src/pages/en/index.astro,
// src/pages/ar/index.astro) are just `<HomeContent lang="..." />`; every
// piece of markup, motion and structure lives here exactly once instead of
// being copy-pasted three times, so a future design change only has to
// happen in one place. See src/i18n/languages.ts + src/i18n/ui.ts for the
// translation plumbing this relies on.
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import LogoWatermark from '../components/LogoWatermark.astro';
import FloralSprig from '../components/FloralSprig.astro';
import { siteConfig } from '../config/site.config';
import { getOrderCtaLabel } from '../lib/nav';
import { menuHighlights } from '../content/menu-highlights';
import { testimonials, aggregateRating } from '../content/testimonials';
import { t, arrow, localizedPath, type Language, type LocalizedText } from '../i18n/languages';
import { common, place } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = t(place.city, lang);
const country = t(place.country, lang);
const orderCtaLabel = getOrderCtaLabel(lang);

// Page-specific copy — kept next to the markup that uses it rather than in
// the shared src/i18n/ui.ts, since none of this repeats on other pages.
const copy = {
  metaTitle: {
    fr: `${siteConfig.identity.name} — ${primaryKeyword} à ${city}`,
    en: `${siteConfig.identity.name} — ${primaryKeyword} in ${city}`,
    ar: `${siteConfig.identity.name} — ${primaryKeyword} في ${city}`,
  },
  metaDescription: {
    fr: `${siteConfig.identity.name} est un ${primaryKeyword} artisanal à ${city} : éclairs, tartelettes et pâtisseries faites maison chaque jour, à savourer sur place dans un cadre chaleureux ou à commander via WhatsApp.`,
    en: `${siteConfig.identity.name} is an artisan ${primaryKeyword} in ${city}: hand-piped eclairs, tarts and pastries made fresh daily, enjoyed in a warm setting or ordered straight to your door via WhatsApp.`,
    ar: `${siteConfig.identity.name} هو ${primaryKeyword} حرفي في ${city}: إكلير وتارت وحلويات محضّرة يوميًا بشكل يدوي، تُستمتع بها في أجواء دافئة أو تُطلب عبر واتساب.`,
  },
  heroTitle: {
    fr: `${siteConfig.identity.name}, ${primaryKeyword} authentique à ${city}`,
    en: `${siteConfig.identity.name}, authentic ${primaryKeyword} in ${city}`,
    ar: `${siteConfig.identity.name}، ${primaryKeyword} أصيل في ${city}`,
  },
  heroSubtitle: {
    fr: 'Éclairs et pâtisseries façonnés à la main chaque matin, servis dans un salon feutré au cœur de Rabat.',
    en: 'Hand-piped eclairs and pastries made fresh every morning, served in a cozy salon in the heart of Rabat.',
    ar: 'إكلير وحلويات مُحضّرة يدويًا كل صباح، تُقدَّم في صالون دافئ في قلب الرباط.',
  },
  selectionKicker: { fr: 'Sélection', en: 'Selection', ar: 'مختارات' },
  incontournablesTitle: { fr: 'Nos incontournables', en: 'Customer favorites', ar: 'أطباقنا المميزة' },
  // Moëtcha homepage spotlight (Amar, Sept 2026: "we willen dit flink
  // pushen ... prominent in beeld op de hoofdpagina") — its own full-width
  // band right after the hero, see the section below. label/brandLine/
  // intro are pulled straight from menu-highlights.ts's Moëtcha entry
  // (moetchaHighlight below) so the copy lives in one place; only the CTA
  // label is specific to this band.
  moetchaCta: { fr: 'Découvrir Moëtcha', en: 'Discover Moëtcha', ar: 'اكتشفوا موتشا' },
  videoKicker: { fr: 'À l’intérieur', en: 'Step inside', ar: 'من الداخل' },
  videoTitle: { fr: 'Une immersion chez Moë', en: 'A glimpse inside Moë', ar: 'لمحة من داخل موي' },
  videoSubtitle: {
    fr: 'Le décor, l’ambiance, les détails — une minute pour se faire une idée avant de passer la porte.',
    en: 'The décor, the atmosphere, the details — a minute to get a feel for the place before you walk in.',
    ar: 'الديكور، الأجواء، التفاصيل — دقيقة واحدة لتكوين فكرة قبل أن تدخل.',
  },
  videoAlt: {
    fr: `Vidéo d'ambiance de ${siteConfig.identity.name}, ${primaryKeyword} à ${city}`,
    en: `Ambiance video of ${siteConfig.identity.name}, ${primaryKeyword} in ${city}`,
    ar: `فيديو أجواء ${siteConfig.identity.name}، ${primaryKeyword} في ${city}`,
  },
  videoUnmute: { fr: 'Activer le son', en: 'Unmute', ar: 'تشغيل الصوت' },
  videoMute: { fr: 'Couper le son', en: 'Mute', ar: 'كتم الصوت' },
  platSignatureKicker: { fr: 'Plat signature', en: 'Signature dish', ar: 'الطبق المميز' },
  platSignatureQuote: {
    fr: 'Notre cheesecake à la vanille, croûte de noix concassées et coulis de dattes caramélisées — la pâtisserie que nos clients recommandent le plus.',
    en: 'Our vanilla cheesecake, crushed-nut crust and warm date-caramel drizzle — the pastry our regulars recommend the most.',
    ar: 'تشيزكيك الفانيليا بقاعدة من المكسرات المطحونة وصلصة التمر المكرمل — الحلوى التي ينصح بها زبائننا أكثر من غيرها.',
  },
  galleryAlt1: {
    fr: `Plats de ${siteConfig.identity.name}, ${primaryKeyword} à ${city}`,
    en: `Dishes from ${siteConfig.identity.name}, ${primaryKeyword} in ${city}`,
    ar: `أطباق من ${siteConfig.identity.name}, ${primaryKeyword} في ${city}`,
  },
  galleryAlt2: {
    fr: 'Éclairs à la crème et au saumon fumé, dressés à la main avec fleurs comestibles et feuille d\'or.',
    en: 'Cream and smoked-salmon eclairs, hand-finished with edible flowers and gold leaf.',
    ar: 'إكلير بالكريمة والسلمون المدخن، مُزيّن يدويًا بأزهار صالحة للأكل وأوراق ذهبية.',
  },
  galleryAlt3: {
    fr: 'Coffret découverte de nos éclairs signature, prêt à offrir ou à emporter.',
    en: 'A gift box of our signature eclairs, ready to give or take away.',
    ar: 'علبة هدايا من إكلير المميز لدينا، جاهزة للإهداء أو للطلب الخارجي.',
  },
  // REPLACE — three genuine reasons specific to this restaurant. These
  // three are a neutral, commonly-true starting point (recipes, cooking
  // method, delivery), not filler to leave as-is.
  whyUs: [
    {
      title: { fr: 'Recettes authentiques', en: 'Authentic recipes', ar: 'وصفات أصيلة' },
      body: {
        fr: 'Pâte à choux, crème pâtissière et caramels préparés maison chaque matin, sans mélanges industriels.',
        en: 'Choux pastry, pastry cream and caramels made from scratch every morning — no industrial mixes.',
        ar: 'عجينة الشو والكريم الحلويات والكراميل تُحضَّر يدويًا كل صباح، دون خلطات جاهزة.',
      },
    },
    {
      title: { fr: 'Savoir-faire artisanal', en: 'Hands-on craft', ar: 'حرفية أصيلة' },
      body: {
        fr: 'Chaque éclair est dressé, garni et décoré à la main pièce par pièce, jamais en série.',
        en: 'Every eclair is piped, filled and finished by hand, one at a time — never mass-produced.',
        ar: 'كل إكلير يُشكَّل ويُحشى ويُزيَّن يدويًا قطعة بقطعة، وليس بشكل آلي.',
      },
    },
    {
      title: { fr: 'Livraison rapide', en: 'Fast delivery', ar: 'توصيل سريع' },
      body: {
        fr: `Commande directement reliée à notre cuisine à ${city} — préparation immédiate.`,
        en: `Orders go straight to our kitchen in ${city} — prepared right away.`,
        ar: `الطلبات تصل مباشرة إلى مطبخنا في ${city} — تُحضَّر فورًا.`,
      },
    },
  ],
  reviewAriaLabel: { fr: 'Avis', en: 'Review', ar: 'تقييم' },
} satisfies Record<string, { fr: string; en: string; ar: string } | { title: any; body: any }[]>;

// Restaurant + LocalBusiness structured data — the single most important
// JSON-LD block on the whole site, since Home is what Google/AI engines
// most often use to resolve "what is this place, where is it, is it open".
// Address/locality stay romanized (siteConfig.identity.city/country) across
// all three language versions — mixing scripts here risks breaking
// schema.org and Google Maps matching, which matters more than the display
// language of the address field.
const restaurantJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: siteConfig.identity.name,
  image: new URL('/images/hero-home.webp', siteConfig.identity.siteUrl).toString(),
  '@id': siteConfig.identity.siteUrl,
  url: siteConfig.identity.siteUrl,
  telephone: siteConfig.contact.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.contact.address,
    addressLocality: siteConfig.identity.city,
    addressCountry: siteConfig.identity.country,
  },
  servesCuisine: siteConfig.identity.cuisineType,
  priceRange: '€€', // REPLACE if this client's actual price range differs
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating.ratingValue,
    reviewCount: aggregateRating.reviewCount,
  },
};

// Point 1+2 of the "Nos incontournables" fix (Amar, Sept 2026): was
// `menuHighlights.flatMap((c) => c.items).slice(0, 4)` — literally "the
// first 4 items in the data file", which happened to be the 4 "Menu sur le
// pouce" items (burger, croque, quesadilla, Le Mex) — none of which have a
// photo, while the eclairs (the actual signature product, see the hero
// subtitle) do. Only ONE category's photo is actually verified to match
// what it's captioned as (the eclair counter shot) — the "Boulangerie"
// photo turned out to show pastry-counter tarts, not croissants/baguettes
// (fixed in menu-highlights.ts), so it's deliberately NOT paired with a
// specific named item here; forcing a mismatched photo→dish pairing would
// just trade one inaccuracy for another. Instead: one real photo card
// (the verified match) plus three photo-less items that get the
// illustrated icon treatment (point 3) — no guessing which photo belongs
// to which dish.
const highlightBadges: Record<string, LocalizedText> = {
  'Éclair Signature Moë': { fr: 'Signature', en: 'Signature', ar: 'مميز' },
  'Thé Vert Marocain': { fr: 'Incontournable', en: 'Classic', ar: 'أساسي' },
  // 'Matcha Latte' swapped for the new Moëtcha sub-line's flagship flavor
  // (Amar, Sept 2026) — same slot, badge changed from nothing to "Nouveau"
  // since this is a genuinely new product launch, not just a rename.
  'Moëtcha Classic': { fr: 'Nouveau', en: 'New', ar: 'جديد' },
};
const allMenuItems = menuHighlights.flatMap((c) =>
  c.items.map((item) => ({ ...item, image: item.image ?? c.image, imageAlt: item.imageAlt ?? c.imageAlt }))
);
const highlightItems = ['Éclair Signature Moë', 'Thé Vert Marocain', 'Moëtcha Classic', 'Frappé Café Lotus']
  .map((name) => allMenuItems.find((item) => item.name === name))
  .filter((item): item is (typeof allMenuItems)[number] => Boolean(item));

// Moëtcha spotlight band data — reuses the same menu-highlights.ts entry
// as highlightItems above instead of duplicating the copy. Only the 4
// non-glacé flavors are shown here (Classic, Nana, Amlou, Zahr) — the
// "Glacé" variant of each is one tap away on /menu, no need to show all 8
// in a homepage teaser.
const moetchaHighlight = menuHighlights.find((c) => c.label.fr === 'Moëtcha');
const moetchaPhotoItems = (moetchaHighlight?.items ?? []).filter((it) => !it.name.endsWith('Glacé')).slice(0, 4);
// MenuHighlightItem has no `badge` field (that's menu-catalog.ts's thing,
// used on /commande's item cards) — matches menu-catalog.ts's own
// dr-moetcha-nana badge: 'populaire' so the two stay consistent instead
// of duplicating a badge field here just for one homepage tile.
const moetchaBadges: Record<string, LocalizedText> = {
  'Moëtcha Nana': { fr: 'Populaire', en: 'Popular', ar: 'الأكثر طلبًا' },
};
// menu-catalog.ts's CATEGORIES order (Sept 2026: Moëtcha split out of
// Boissons into its own category, 3rd in the list) — index 2 = moetcha.
// If that order ever changes, update this index to match.
// /menu's content was fully replaced (Amar, Sept 2026 — see
// menu-formules.ts's top comment) and no longer has a "Moëtcha" category
// at index 2 — the closest thing left on /menu is its own "Matcha
// Signature Moë" section (different flavor names/prices, see that
// file's comment; flagged to Amar). Anchor updated so this CTA doesn't
// silently scroll to the wrong place.
const moetchaMenuHref = `${localizedPath('/menu', lang)}#matcha-signature`;

const ratingRounded = Math.round(Number(aggregateRating.ratingValue));
const ratingStars = '★'.repeat(ratingRounded) + '☆'.repeat(5 - ratingRounded);

const path = localizedPath('/', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  ogImage="/images/hero-home.webp"
  jsonLd={restaurantJsonLd}
>
  <!-- Hero -->
  <section class="relative min-h-[640px] sm:h-[92vh] flex items-end sm:items-center overflow-hidden">
    <img
      src="/images/hero-home.webp"
      alt={t(copy.metaDescription, lang)}
      class="absolute inset-0 w-full h-full object-cover"
      style="filter: saturate(1.15) contrast(1.06); object-position: center 65%"
    />
    <!-- No panel, no outline gimmick — that read as sticker text on the
         dark-brown headline color. The professional fix is what real
         photography-led restaurant sites actually do: put the text in a
         light color that belongs on a photo (near-white, not the page's
         dark-brown body color) and darken the photo itself under it with a
         proper photographic vignette — feathered, no hard edge, no visible
         box — plus one soft drop-shadow for depth. Vignette is strongest
         bottom-left (where the text sits) and fades out toward the top and
         right, so the food on the right stays bright and untouched. -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(115deg, rgba(20,14,8,0.72) 0%, rgba(20,14,8,0.52) 22%, rgba(20,14,8,0.18) 46%, transparent 62%), linear-gradient(0deg, rgba(20,14,8,0.55) 0%, rgba(20,14,8,0.05) 40%, transparent 60%)"
    ></div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-6 sm:pb-0 w-full">
      <div class="max-w-xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.3em] mb-4 px-3 py-1.5 rounded-full" style="color: var(--color-background); background-color: var(--color-accent)">
          {city} · {country}
        </span>
        <h1 class="hero-shadow font-display text-[2.5rem] leading-[1.05] sm:text-5xl lg:text-6xl font-bold tracking-tight text-balance" style="color: #FFFCF3">
          {t(copy.heroTitle, lang)}
        </h1>
        <p class="hero-shadow mt-4 sm:mt-5 text-base sm:text-lg max-w-md font-medium" style="color: rgba(255,252,243,0.92)">
          {t(copy.heroSubtitle, lang)}
        </p>
        <div class="mt-6 sm:mt-8 flex flex-wrap gap-3">
          <Button href={orderCtaLabel.href} variant="cta">{orderCtaLabel.label}</Button>
          <Button href={localizedPath('/menu', lang)} variant="outline" class="hero-outline-btn">{t(common.voirLeMenu, lang)}</Button>
        </div>
        <p class="hero-shadow mt-5 flex items-center gap-2 text-sm font-semibold" style="color: #FFFCF3">
          <span style="color: var(--color-accent); letter-spacing: 1px">{ratingStars}</span>
          {aggregateRating.ratingValue}/5 · {aggregateRating.reviewCount} {t(common.avisTripadvisorSuffix, lang)}
        </p>
      </div>
    </div>
  </section>

  <!-- Moëtcha spotlight — Amar, Sept 2026: "we willen in de toekomst
       Moëtcha flink pushen in marketing ... het moet prominent in beeld
       komen op de hoofdpagina". Own full-width band right after the hero
       (the very first thing after the fold, ahead of "Nos incontournables"
       where it was previously just one of four tiles), and its own color:
       the same green /commande's order flow already uses (#3F5D45), not
       the site's gold accent, so it reads as a distinct sub-brand moment
       rather than another homepage section. Copy comes from
       menu-highlights.ts's Moëtcha entry so it isn't duplicated here. -->
  {moetchaHighlight && (
    <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #4C6E4E 0%, #3F5D45 45%, #2E452F 100%)" data-reveal>
      {/* Soft glow instead of a flat fill — same section-glow pattern used
          on About/Avis/further down this page, just a lighter sage tone so
          it reads against the green instead of needing --color-accent. */}
      <div class="section-glow" style="width: 420px; height: 420px; background: #C9DCC2; opacity: 0.16; right: -140px; top: -120px;"></div>
      {/* Same printed-menu sprig used elsewhere on the site (see
          FloralSprig.astro), brightened via CSS filter to read as a cream
          flourish on this dark green instead of the usual green-on-cream —
          the first use of this asset outside a light background. */}
      <FloralSprig corner="bottom-left" size="w-64 sm:w-96" opacity={0.14} class="moetcha-sprig" />
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
        <div class="grid lg:grid-cols-[1.05fr,1fr] gap-10 lg:gap-16 items-center">
          <div class="relative">
            {moetchaHighlight.brandLine && (
              <span class="block text-[10px] font-bold uppercase tracking-[0.3em] mb-4" style="color: rgba(255,252,243,0.7)">
                {t(moetchaHighlight.brandLine, lang)}
              </span>
            )}
            <h2 class="font-display text-3xl sm:text-4xl font-semibold" style="color: #FFFCF3">
              {t(moetchaHighlight.label, lang)}
            </h2>
            {moetchaHighlight.intro && (
              <p class="mt-4 max-w-md text-sm sm:text-base leading-relaxed" style="color: rgba(255,252,243,0.85)">
                {t(moetchaHighlight.intro, lang)}
              </p>
            )}
            <a href={moetchaMenuHref} class="moetcha-cta inline-flex items-center gap-2 mt-7 px-6 py-3.5 rounded-lg text-sm font-bold">
              {t(copy.moetchaCta, lang)}
              <svg class="moetcha-cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
          {/* Staggered 2-col grid (second column nudged down on larger
              screens) instead of a flush, identical grid — a small move
              that stops 4 same-size tiles from reading as a spreadsheet. */}
          <div class="grid grid-cols-2 gap-3 sm:gap-4">
            {moetchaPhotoItems.map((item, i) => (
              <a
                href={moetchaMenuHref}
                class={`moetcha-item-card relative rounded-xl overflow-hidden block ${i % 2 === 1 ? 'sm:mt-8' : ''}`}
                data-reveal
                style={`transition-delay: ${i * 70}ms`}
              >
                {moetchaBadges[item.name] && (
                  <span class="moetcha-item-badge absolute top-2.5 z-10 text-[9px] font-bold uppercase tracking-wide px-2 py-1 rounded-full" style="inset-inline-start: 0.625rem">
                    {t(moetchaBadges[item.name], lang)}
                  </span>
                )}
                {item.image && (
                  <div class="aspect-square">
                    <img src={item.image} alt={item.imageAlt ? t(item.imageAlt, lang) : item.name} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                )}
                <div class="p-3">
                  <p class="text-xs sm:text-sm font-bold leading-tight" style="color: #FFFCF3">{item.name}</p>
                  <p class="text-[11px] mt-1" style="color: rgba(255,252,243,0.65)">{item.price} {siteConfig.identity.currency}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Menu highlights -->
  <!-- Point 5: this section used to sit on the exact same cream as the
       hero-adjacent page background — nothing signaled "new section,
       worth stopping for". section-tint-warm (already used lower down for
       the testimonial band) lifts it one step and ties it to the brand's
       warm-brown instead of leaving it flat. -->
  <div class="section-tint-warm">
    <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24 overflow-hidden">
      {/* Same printed-menu sprig used on the Menu page (see FloralSprig.astro)
          — Amar asked (Sept 2026) for the physical card's own botanical
          graphic to also appear, subtly, on the site. Placed here rather
          than stacked with the gold-wordmark LogoWatermark further down
          this page, so the two decorative signatures don't compete in the
          same viewport. */}
      <FloralSprig corner="top-right" />
      <div class="relative">
        <div class="flex items-baseline justify-between mb-8 pb-3" style="border-bottom: 1px solid var(--color-border)">
          <div>
            <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-1" style="color: var(--color-accent)">{t(copy.selectionKicker, lang)}</span>
            <h2 class="font-display text-2xl sm:text-3xl font-semibold" style="color: var(--color-text-primary)">{t(copy.incontournablesTitle, lang)}</h2>
          </div>
          <a href={localizedPath('/menu', lang)} class="text-sm font-bold" style="color: var(--color-accent)">{t(common.menuComplet, lang)} {arrow(lang)}</a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {highlightItems.map((item, i) => (
          <div
            class="card-lift rounded-2xl overflow-hidden relative"
            style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 80}ms`}
            data-reveal
          >
            {highlightBadges[item.name] && (
              // Point 4a: a small proof/status tag — "Signature" on the
              // eclair, "Incontournable" on the mint tea — gives two of the
              // four cards a reason to be looked at first instead of all
              // four competing equally.
              <span
                class="absolute top-3 z-10 text-[10px] font-bold uppercase tracking-[0.15em] px-2.5 py-1 rounded-full"
                style="inset-inline-start: 0.75rem; color: var(--color-background); background-color: var(--color-accent)"
              >
                {t(highlightBadges[item.name], lang)}
              </span>
            )}
            {item.image ? (
              <div class="photo-frame aspect-square">
                <img src={item.image} alt={item.imageAlt ? t(item.imageAlt, lang) : item.name} class="w-full h-full object-cover" loading="lazy" />
              </div>
            ) : (
              // Point 3: no standalone photo exists for this dish (see the
              // highlightItems note above) — instead of the old bare 18px
              // leaf glyph adrift in a corner, this fills the exact same
              // aspect-square slot the photo cards use (so the row keeps
              // lining up) with a full-bleed brand-tinted tile: a soft
              // radial gradient, a faint ring for texture, and an
              // illustration sized to actually compete with the photos
              // next to it instead of disappearing.
              <div
                class="aspect-square flex items-center justify-center relative overflow-hidden"
                style={`background: radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--color-accent) ${i % 2 === 0 ? '24%' : '16%'}, var(--color-surface)) 0%, color-mix(in srgb, var(--color-primary) 16%, var(--color-surface)) 100%)`}
              >
                <div
                  class="absolute rounded-full"
                  style="width: 135%; height: 135%; border: 1.5px solid color-mix(in srgb, var(--color-accent) 20%, transparent)"
                >
                </div>
                {item.name === 'Thé Vert Marocain' ? (
                  <svg width="52" height="52" viewBox="0 0 24 24" fill="none" class="relative" style="color: var(--color-primary)">
                    <path
                      d="M6 9h11l-1 8.5a2 2 0 01-2 1.5H9a2 2 0 01-2-1.5L6 9z"
                      stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"
                    />
                    <path d="M17 10.5h1.5a2.5 2.5 0 010 5H17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    <path d="M9.5 4.5c.8.9.8 1.8 0 2.7M12.5 4.5c.8.9.8 1.8 0 2.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.7" />
                  </svg>
                ) : item.name === 'Matcha Latte' ? (
                  <svg width="52" height="52" viewBox="0 0 24 24" fill="none" class="relative" style="color: var(--color-primary)">
                    <path
                      d="M6.5 9h11l-.9 8a3 3 0 01-3 2.7h-3.2a3 3 0 01-3-2.7L6.5 9z"
                      stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"
                    />
                    <ellipse cx="12" cy="9" rx="5.5" ry="1.6" stroke="currentColor" stroke-width="1.4" />
                    <path d="M9 6.3c1-1.4 1-2.4 0-3.6M12 6.3c1-1.4 1-2.4 0-3.6M15 6.3c1-1.4 1-2.4 0-3.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.6" />
                  </svg>
                ) : item.name === 'Frappé Café Lotus' ? (
                  <svg width="52" height="52" viewBox="0 0 24 24" fill="none" class="relative" style="color: var(--color-primary)">
                    <path
                      d="M7.5 8h9l-.8 10.2a2 2 0 01-2 1.8h-3.4a2 2 0 01-2-1.8L7.5 8z"
                      stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"
                    />
                    <path d="M6.5 8h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    <path d="M12 8V3.5M12 3.5c-1 0-1.6.6-1.6 1.4M12 3.5c1 0 1.6.6 1.6 1.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    <path d="M9.8 11.5h4.4M9.5 14.3h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.6" />
                  </svg>
                ) : (
                  <svg width="44" height="44" viewBox="0 0 24 24" fill="none" class="relative" style="color: var(--color-primary)">
                    <path d="M12 3c-1.5 3-4.5 4.5-4.5 8.5a4.5 4.5 0 009 0C16.5 7.5 13.5 6 12 3z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  </svg>
                )}
              </div>
            )}
            <div class="p-5">
              <h3 class="menu-item-name font-display font-semibold text-lg" style="color: var(--color-text-primary)">{item.name}</h3>
              <p class="text-sm mt-1.5 leading-relaxed" style="color: var(--color-text-muted)">{t(item.description, lang)}</p>
              <p
                class="menu-item-price inline-flex mt-3 text-sm font-bold px-2.5 py-1 rounded-full"
                style="color: var(--color-accent); background-color: color-mix(in srgb, var(--color-accent) 10%, transparent)"
              >
                {item.price} {siteConfig.identity.currency}
