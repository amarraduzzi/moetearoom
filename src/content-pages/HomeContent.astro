          </div>
        ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Ambiance video — a real, on-site "impression" clip rather than another
       photo. Portrait source (9:16, phone-shot), so it's framed like one
       instead of forced into a wide crop: a phone-style card on desktop
       next to the intro copy, full-width-but-capped and stacked on mobile.
       Muted/looped/autoplaying like a reel (this is exactly that kind of
       clip) but only once it's actually on screen — see the script below —
       so it never adds weight to a page load that never scrolls this far,
       and a visible tap-to-unmute control means sound is still one tap
       away for anyone who wants it. -->
  <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24 overflow-hidden">
    <div class="section-glow" style="width: 340px; height: 340px; background: var(--color-primary); opacity: 0.12; left: -120px; top: 10%;"></div>
    <div class="relative grid sm:grid-cols-2 gap-10 sm:gap-16 items-center">
      <div class="order-2 sm:order-1 text-center sm:text-start" data-reveal>
        <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-1" style="color: var(--color-accent)">{t(copy.videoKicker, lang)}</span>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold" style="color: var(--color-text-primary)">{t(copy.videoTitle, lang)}</h2>
        <p class="mt-3 max-w-md mx-auto sm:mx-0 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">
          {t(copy.videoSubtitle, lang)}
        </p>
      </div>

      <div class="order-1 sm:order-2 flex justify-center" data-reveal="scale">
        <!-- Phone-style card: a slim brand-gradient bezel around the actual
             video so a portrait clip reads as a deliberate "reel" frame
             instead of an odd letterboxed rectangle. -->
        <div class="relative w-full max-w-[280px] sm:max-w-[320px] rounded-[2.25rem] p-2 shadow-2xl" style="background: linear-gradient(160deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);">
          <div class="video-frame relative rounded-[1.85rem] overflow-hidden aspect-[9/16]" style="background: #14100c">
            <video
              id="promo-video"
              class="absolute inset-0 w-full h-full object-cover"
              poster="/images/promo-poster.webp"
              muted
              loop
              playsinline
              preload="none"
              aria-label={t(copy.videoAlt, lang)}
            >
              <source src="/videos/promo-1.webm" type="video/webm" />
              <source src="/videos/promo-1.mp4" type="video/mp4" />
            </video>
            <button
              type="button"
              id="promo-video-sound"
              class="video-sound-btn"
              aria-label={t(copy.videoUnmute, lang)}
              data-label-mute={t(copy.videoUnmute, lang)}
              data-label-unmute={t(copy.videoMute, lang)}
              aria-pressed="false"
            >
              <svg class="icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9.5v5h4l5 4.5v-14l-5 4.5H3z" />
                <path d="M17 8.5a5 5 0 010 7M19.5 6a8.5 8.5 0 010 12" />
              </svg>
              <svg class="icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9.5v5h4l5 4.5v-14l-5 4.5H3z" />
                <path d="M16 9l5 5.5M21 9l-5 5.5" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Ambiance video: only load/play once it's actually scrolled into
    // view (preload="none" above keeps it off the initial page weight),
    // pause again once it scrolls back out, and a tap on the sound button
    // unmutes without taking over the page's autoplay/loop behaviour.
    document.addEventListener('astro:page-load', () => {
      const video = document.getElementById('promo-video');
      const soundBtn = document.getElementById('promo-video-sound');
      if (!(video instanceof HTMLVideoElement) || !soundBtn) return;

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.4 }
      );
      observer.observe(video);

      soundBtn.addEventListener('click', () => {
        video.muted = !video.muted;
        soundBtn.classList.toggle('is-unmuted', !video.muted);
        soundBtn.setAttribute('aria-pressed', String(!video.muted));
        soundBtn.setAttribute(
          'aria-label',
          (video.muted ? soundBtn.dataset.labelMute : soundBtn.dataset.labelUnmute) || ''
        );
      });
    });
  </script>

  <Ornament />

  <!-- Signature spotlight — was a text-over-photo hero with a gradient
       overlay, which on this light/cream theme meant dark brown text
       blended against a warm, busy food photo: never enough contrast, and
       "vaag" (hazy) rather than crisp at any tuning of the gradient. Redone
       as a hard-edged split: the quote sits on a solid, flat panel (its own
       background color, zero blend with the photo) and the photo runs
       full-bleed beside/below it, untouched and sharp — legibility is now
       structural, not a matter of overlay opacity. -->
  <section class="signature-spotlight" data-reveal="scale">
    <div class="signature-spotlight-text">
      <span class="signature-kicker">{t(copy.platSignatureKicker, lang)}</span>
      <p class="pull-quote">
        {t(copy.platSignatureQuote, lang)}
      </p>
      <a href={localizedPath('/menu', lang)} class="signature-cta">{t(common.voirLeMenuComplet, lang)} {arrow(lang)}</a>
    </div>
    <div class="signature-spotlight-image ken-burns">
      <img
        src="/images/signature-dish.webp"
        alt={t(copy.platSignatureQuote, lang)}
        loading="lazy"
      />
    </div>
  </section>

  <!-- Photo gallery -->
  <div class="section-tint">
    <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
        <div class="photo-frame rounded-2xl col-span-2 sm:col-span-1 aspect-square" data-reveal="scale">
          <img src="/images/gallery-1.webp" alt={t(copy.galleryAlt1, lang)} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="photo-frame rounded-2xl aspect-square" data-reveal="scale" style="transition-delay: 100ms">
          <img src="/images/gallery-2.webp" alt={t(copy.galleryAlt2, lang)} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="photo-frame rounded-2xl aspect-square" data-reveal="scale" style="transition-delay: 200ms">
          <img src="/images/gallery-3.webp" alt={t(copy.galleryAlt3, lang)} class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>
  </div>

  <!-- section-tint (gallery, above) uses --color-surface and the plain
       page background below it is --color-background — on this light
       cream theme those two are only a few percent apart in lightness, so
       the section boundary was nearly invisible (flagged Sept 2026: no
       "scheiding" between the photo grid and the features band below it).
       Reordering wouldn't fix that — the same two near-identical tones
       would still touch, just in the other order. A deliberate divider
       (already the site's own pattern for marking a transition, see
       Ornament.astro) is what actually reads as a break. -->
  <Ornament />

  <!-- Why us / E-E-A-T signals -->
  <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24 grid sm:grid-cols-3 gap-8 overflow-hidden">
    <LogoWatermark size="w-[22rem] h-[22rem]" />
    {copy.whyUs.map((f, i) => (
      <div data-reveal style={`transition-delay: ${i * 100}ms`}>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="1.5" class="mb-4" style="color: var(--color-accent)">
          <path
            d={
              i === 0
                ? 'M12 2c-1 3-4 4-4 8a4 4 0 008 0c0-4-3-5-4-8zM6 20h12'
                : i === 1
                  ? 'M5 21V9a7 7 0 0114 0v12M5 21h14M9 21v-6h6v6'
                  : 'M3 7h11v8H3zM14 10h4l3 3v2h-7zM6 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z'
            }
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <h3 class="font-display text-xl font-semibold mb-2" style="color: var(--color-text-primary)">{t(f.title, lang)}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--color-text-muted)">{t(f.body, lang)}</p>
      </div>
    ))}
  </section>

  <!-- Testimonial carousel -->
  <section class="section-tint-warm relative max-w-none px-0 py-16 sm:py-28 overflow-hidden" data-reveal>
    <div class="section-glow" style="width: 380px; height: 380px; background: var(--color-accent); opacity: 0.14; right: -140px; bottom: -60px;"></div>

    <div class="relative testimonial-carousel max-w-3xl mx-auto px-5 sm:px-8">
      <div class="testimonial-track">
        {testimonials.map((tItem, i) => (
          <div class="testimonial-slide text-center" data-slide={i}>
            <span
              class="inline-flex items-center justify-center w-12 h-12 rounded-full font-display font-bold text-lg mb-5"
              style="background: var(--color-surface); border: 1.5px solid var(--color-accent); color: var(--color-accent)"
            >
              {tItem.name.charAt(0)}
            </span>
            <p class="pull-quote">{t(tItem.text, lang)}</p>
            <p class="mt-6 text-sm font-bold" style="color: var(--color-accent)">— {tItem.name}</p>
          </div>
        ))}
      </div>

      <div class="testimonial-dots flex items-center justify-center gap-2 mt-8">
        {testimonials.map((_, i) => (
          <button
            type="button"
            class="testimonial-dot w-2 h-2 rounded-full transition-all"
            style="background-color: var(--color-border)"
            data-dot={i}
            aria-label={`${t(copy.reviewAriaLabel, lang)} ${i + 1}`}
          ></button>
        ))}
      </div>

      <p class="text-center mt-4">
        <a href={localizedPath('/avis', lang)} class="text-sm font-bold" style="color: var(--color-accent)">{t(common.lireTousLesAvis, lang)} {arrow(lang)}</a>
      </p>
    </div>
  </section>

  <style>
    /* Moëtcha spotlight band — cream-outline pill on the dark green
       background, filling solid cream on hover (same fill-sweep idea as
       Button.astro's outline variant, hand-rolled here since this band
       doesn't use --color-accent). */
    .moetcha-cta {
      color: #FFFCF3;
      border: 1.5px solid rgba(255, 252, 243, 0.55);
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }
    .moetcha-cta:hover {
      background-color: #FFFCF3;
      color: #3F5D45;
      border-color: #FFFCF3;
    }
    .moetcha-cta-arrow { transition: transform 0.2s ease; }
    .moetcha-cta:hover .moetcha-cta-arrow { transform: translateX(3px); }
    [dir='rtl'] .moetcha-cta-arrow { transform: scaleX(-1); }
    [dir='rtl'] .moetcha-cta:hover .moetcha-cta-arrow { transform: scaleX(-1) translateX(3px); }
    .moetcha-item-card {
      background-color: rgba(255, 252, 243, 0.08);
      box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.4);
      transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    }
    .moetcha-item-card:hover {
      background-color: rgba(255, 252, 243, 0.14);
      transform: translateY(-3px);
      box-shadow: 0 16px 30px -12px rgba(0, 0, 0, 0.5);
    }
    .moetcha-item-badge {
      color: #3F5D45;
      background-color: #FFFCF3;
    }
    /* Green line-art sprig (see FloralSprig.astro) inverted to read as a
       quiet cream flourish on this dark background instead of vanishing
       into it — every other usage of this asset sits on cream and never
       gets this filter. */
    :global(.moetcha-sprig) {
      filter: brightness(0) invert(1);
    }

    /* No panel, no text-stroke — just a soft, tight drop-shadow so the
       near-white text keeps a hairline of separation from the photo in the
       few spots the vignette runs light (a bright plate edge, a highlight).
       One shadow, not a stacked halo — this is what "professional" looks
       like next to a text-stroke effect, which reads as sticker/meme text. */
    .hero-shadow {
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 18px rgba(0, 0, 0, 0.45);
    }
    /* Ambiance video card — a thin, slightly darkened bottom gradient so
       the sound toggle always has contrast against the footage under it,
       whatever the frame happens to show at that moment. */
    .video-frame::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(0, 0, 0, 0.45) 0%, transparent 22%);
      pointer-events: none;
    }
    .video-sound-btn {
      position: absolute;
      z-index: 2;
      bottom: 12px;
      inset-inline-end: 12px;
      width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: rgba(20, 16, 12, 0.55);
      backdrop-filter: blur(3px);
      color: #fffcf3;
      transition: background-color 0.2s ease, transform 0.2s ease;
    }
    .video-sound-btn:hover {
      background: rgba(20, 16, 12, 0.75);
      transform: scale(1.06);
    }
    .video-sound-btn .icon-unmuted {
      display: none;
    }
    .video-sound-btn.is-unmuted .icon-muted {
      display: none;
    }
    .video-sound-btn.is-unmuted .icon-unmuted {
      display: block;
    }
    /* The secondary hero button normally uses the accent-green outline,
       tuned for sitting on the page's cream background — on top of a
       darkened photo that green outline nearly disappears. White border
       reads correctly against the vignette instead. */
    /* :global() because this class lands on the <a> Button.astro renders,
       which carries Button's own scope hash, not this component's — a
       plain scoped selector here would silently never match it. */
    :global(.hero-outline-btn) {
      border-color: rgba(255, 252, 243, 0.75) !important;
      color: #fffcf3 !important;
    }
    :global(.hero-outline-btn::before) {
      background-color: #fffcf3 !important;
    }
    :global(.hero-outline-btn:hover),
    :global(.hero-outline-btn:active) {
      color: #2a1d13 !important;
    }
    .testimonial-track { position: relative; min-height: 220px; }
    .testimonial-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none;
    }
    .testimonial-slide.is-active {
      position: relative;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .testimonial-dot.is-active { background-color: var(--color-accent) !important; width: 22px; }
  </style>

  <script>
    document.querySelectorAll<HTMLElement>('.testimonial-carousel').forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.testimonial-slide'));
      const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.testimonial-dot'));
      let active = 0;
      let timer: ReturnType<typeof setInterval>;

      function show(index: number) {
        active = (index + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('is-active', i === active));
        dots.forEach((d, i) => d.classList.toggle('is-active', i === active));
      }
      function start() {
        timer = setInterval(() => show(active + 1), 6000);
      }
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          clearInterval(timer);
          start();
        });
      });
      show(0);
      start();
    });
  </script>
</Layout>
