---
// See HomeContent.astro's top comment for the shared-body-per-route
// pattern this and every other src/content-pages/*.astro file follows.
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Ornament from '../components/Ornament.astro';
import LogoWatermark from '../components/LogoWatermark.astro';
import { siteConfig } from '../config/site.config';
import { testimonials, aggregateRating } from '../content/testimonials';
import { t, localizedPath, arrow, type Language } from '../i18n/languages';
import { common, place } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = t(place.city, lang);
const avg = aggregateRating.ratingValue;

// Individual Review + AggregateRating JSON-LD, on-domain — the standing note
// in site.config.ts explains why: AI answer engines scan review PAGES for
// recommendations, not just the Google Business Profile listing itself.
// Uses the FRENCH text as the canonical reviewBody regardless of page
// language (schema.org doesn't take a language-tagged string array here,
// and the source-of-truth text is the translated-from-real-review FR copy).
const reviewsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating.ratingValue,
    reviewCount: aggregateRating.reviewCount,
  },
  review: testimonials.map((rev) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: rev.name },
    datePublished: rev.date,
    reviewRating: { '@type': 'Rating', ratingValue: String(rev.rating), bestRating: '5' },
    reviewBody: t(rev.text, lang),
  })),
};

const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const googleRatingRounded = siteConfig.social.googleRating ? Math.round(Number(siteConfig.social.googleRating)) : 0;

const localeMap = { fr: 'fr-FR', en: 'en-US', ar: 'ar-MA' } as const;

const copy = {
  metaTitle: { fr: `Avis clients — ${primaryKeyword} à ${city} | ${name}`, en: `Customer reviews — ${primaryKeyword} in ${city} | ${name}`, ar: `آراء العملاء — ${primaryKeyword} في ${city} | ${name}` },
  metaDescription: {
    fr: `Ce que disent nos clients de ${name}, ${primaryKeyword} à ${city} : note moyenne ${avg}/5 sur ${aggregateRating.reviewCount} avis vérifiés.`,
    en: `What our customers say about ${name}, ${primaryKeyword} in ${city}: average rating ${avg}/5 across ${aggregateRating.reviewCount} verified reviews.`,
    ar: `ما يقوله عملاؤنا عن ${name}, ${primaryKeyword} في ${city}: متوسط تقييم ${avg}/5 من أصل ${aggregateRating.reviewCount} تقييمًا موثقًا.`,
  },
  heroTitle: { fr: 'Avis clients', en: 'Customer reviews', ar: 'آراء العملاء' },
  heroAlt: { fr: `Plat servi chez ${name}`, en: `A dish served at ${name}`, ar: `طبق يُقدَّم في ${name}` },
  avisSuffix: { fr: 'avis', en: 'reviews', ar: 'تقييمًا' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const path = localizedPath('/avis', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  jsonLd={reviewsJsonLd}
>
  <PageHero kicker={city} title={t(copy.heroTitle, lang)} image="/images/gallery-2.webp" alt={t(copy.heroAlt, lang)} />
  <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-10 sm:pt-12 pb-8">
    <p class="text-lg" style="color: var(--color-accent)">
      {stars(Math.round(Number(avg)))} <span style="color: var(--color-text-muted)">{avg}/5 · {aggregateRating.reviewCount} {t(copy.avisSuffix, lang)}</span>
    </p>
    <!-- Google was entirely missing from this page before — everything
         here was Tripadvisor-only, even though Google Business Profile is
         where most local searchers actually check ratings first and where
         review velocity matters most for local SEO (see the standing note
         in site.config.ts). The star rating shown is the real, confirmed
         Google figure — no review count, since that number was never
         verified with the client and this site doesn't fabricate figures. -->
    {siteConfig.social.googleReviewsUrl && (
      <a
        href={siteConfig.social.googleReviewsUrl}
        target="_blank"
        rel="noreferrer"
        class="mt-2 flex items-center gap-1.5 text-sm font-bold hover:underline"
        style="color: var(--color-text-muted)"
      >
        {siteConfig.social.googleRating && (
          <>
            <span style="color: var(--color-accent)">{stars(googleRatingRounded)}</span>
            {siteConfig.social.googleRating}/5 {t(common.surGoogle, lang)} ·
          </>
        )}
        {t(common.laisserAvisGoogle, lang)} {arrow(lang)}
      </a>
    )}
  </section>

  <!-- The single best review, set as an unboxed pull-quote — a deliberate
       "wow" moment before the page drops into the regular grid of shorter
       cards below, instead of every review getting equal, flat weight. -->
  {testimonials[0] && (
    <section class="relative max-w-3xl mx-auto px-5 sm:px-8 pb-10 sm:pb-16 text-center overflow-hidden" data-reveal>
      <div class="section-glow" style="width: 360px; height: 360px; background: var(--color-accent); opacity: 0.08; left: -120px; top: -40px;"></div>
      <LogoWatermark size="w-[20rem] h-[20rem]" />
      <span class="relative font-display block text-6xl leading-none mb-2" style="color: var(--color-accent)">"</span>
      <p class="relative pull-quote -mt-6">{t(testimonials[0].text, lang)}</p>
      <p class="relative mt-6 text-sm font-bold" style="color: var(--color-accent)">
        {testimonials[0].name} · {stars(testimonials[0].rating)}
      </p>
      {testimonials[0].sourceUrl && (
        <a href={testimonials[0].sourceUrl} target="_blank" rel="noreferrer" class="relative inline-block mt-3 text-sm font-bold" style="color: var(--color-text-muted)">
          {t(common.voirTousLesAvisTripadvisor, lang)} {arrow(lang)}
        </a>
      )}
    </section>
  )}

  <Ornament />

  <!-- Warm variant instead of the neutral grey tint — Avis is the trust
       page, it earns some of the same wine-red warmth we brought into
       Menu and Home rather than staying the one page still on plain grey.
       Cards also alternate background + monogram ring color (gold /
       bordeaux) so a single mobile column reads as a rhythm instead of
       five identical grey boxes stacked on top of each other, and each
       card gets the same initial-monogram treatment as the Home carousel
       so a name isn't just floating text with nothing to anchor it. -->
  <div class="section-tint-warm">
    <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-16 pb-10 sm:pb-16 grid sm:grid-cols-2 gap-5">
      {testimonials.slice(1).map((rev, i) => {
        const warm = i % 2 === 1;
        return (
          <div
            class="card-lift rounded-xl p-5 flex gap-4"
            style={`background-color: ${warm ? 'color-mix(in srgb, var(--color-primary-dark) 12%, var(--color-surface-muted))' : 'var(--color-surface-muted)'}; border: 1px solid var(--color-border); transition-delay: ${i * 80}ms`}
            data-reveal
          >
            <span
              class="shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-full font-display font-bold text-sm"
              style={`background: var(--color-surface); border: 1.5px solid ${warm ? 'var(--color-primary)' : 'var(--color-accent)'}; color: ${warm ? 'var(--color-primary)' : 'var(--color-accent)'}`}
            >
              {rev.name.charAt(0)}
            </span>
            <div class="min-w-0">
              <p class="text-sm" style="color: var(--color-accent)">{stars(rev.rating)}</p>
              <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-text-primary)">"{t(rev.text, lang)}"</p>
              <p class="mt-3 text-xs font-bold" style="color: var(--color-text-muted)">
                {rev.name} · {new Date(rev.date).toLocaleDateString(localeMap[lang], { year: 'numeric', month: 'long' })}
                {rev.sourceUrl && (
                  <a href={rev.sourceUrl} target="_blank" rel="noreferrer" class="ml-1 font-normal underline" style="color: var(--color-text-muted)">
                    (Tripadvisor)
                  </a>
                )}
              </p>
            </div>
          </div>
        );
      })}
    </section>
  </div>

  <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-10 pb-20 sm:pt-20 text-center">
    <Button href={localizedPath('/menu', lang)} variant="filled">{t(common.decouvrirLeMenu, lang)}</Button>
  </section>
</Layout>
