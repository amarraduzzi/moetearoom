---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { siteConfig } from '../config/site.config';
import { isRTL, type Language } from '../i18n/languages';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  lang?: Language;
}
const { title, description, path, ogImage, jsonLd, noindex, lang = 'fr' } = Astro.props;
const rtl = isRTL(lang);

// Wires site.config.ts's `colors` into the actual CSS custom properties
// global.css's :root block declares — WITHOUT this, changing colors in
// site.config.ts would silently do nothing (the exact same class of bug the
// order-landing-page engine had with its typography fields before that got
// fixed). This is what makes site.config.ts genuinely the one file you edit
// per client for color, not just documentation that looks like it works.
//
// !important on every declaration is deliberate, not decorative: Vite/Astro
// bundles global.css as an external stylesheet and injects its <link> AFTER
// this inline <style> in the compiled <head> (build-order detail, not
// something this file controls). Both blocks target :root at equal
// specificity, so without !important the external stylesheet's hard-coded
// template defaults (red/gold) load later and silently win the cascade —
// site.config.ts's colors would never actually render, however correct the
// values here are. This was a live bug: verified by diffing the rendered
// :root against this override on a production build.
const c = siteConfig.colors;
const extraTokens: Record<string, string | undefined> = {
  '--color-surface': c.surface,
  '--color-surface-muted': c.surfaceMuted,
  '--color-text-primary': c.textPrimary,
  '--color-text-muted': c.textMuted,
  '--color-border': c.border,
};
const extraOverrides = Object.entries(extraTokens)
  .filter(([, value]) => value)
  .map(([token, value]) => `${token}:${value} !important;`)
  .join('');
const colorOverrides = `:root{--color-primary:${c.primary} !important;--color-primary-dark:${c.primaryDark} !important;--color-accent:${c.accent} !important;--color-background:${c.background} !important;${extraOverrides}}`;
---
<!doctype html>
<html lang={lang} dir={rtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Real client logo now, not the generic placeholder letter — cropped
         from their own storefront photography (see logo-mark.png / the
         Header). Point 5 of the "what's still missing" pass: the browser
         tab was still showing a plain gold "I" on black. -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} path={path} lang={lang} ogImage={ogImage} jsonLd={jsonLd} noindex={noindex} />
    <style set:html={colorOverrides} />
    <!-- Astro's built-in View Transitions — final punch-list item #2. Turns
         page-to-page navigation into a soft cross-fade instead of a hard
         reload, at near-zero cost (no framework runtime, this is a native
         browser API Astro wires up for us). Every page keeps working with
         JS disabled or on browsers without View Transitions support — it's
         strictly progressive enhancement, never a requirement to navigate,
         which matters for a site whose whole architecture is built around
         being readable without JS (see astro.config.mjs). -->
    <ViewTransitions />
    <!-- Fonts: same pair as the order-landing-page engine (Bodoni Moda display
         + Inter body) so the two sites read as one family. Noto Naskh Arabic
         added for the /ar/ pages — Bodoni Moda has no Arabic glyphs at all,
         it would silently fall back to the browser's default serif and break
         the display-font pairing on every Arabic heading. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600;6..96,700&family=Inter:wght@400;500;600;700;800&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain-overlay"></div>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
    <!-- CartWidget.astro (in-site cart + checkout) removed sitewide (Amar,
         Sept 2026 — "de klant wil opeens de menu pagina niet meer
         doorlinken naar het scherm... Het menu moet gewoon alleen
         visueel zijn dus. Dus winkelwagen eruit"): the menu is
         browse-only now, ordering happens by phone/WhatsApp/reservation
         instead. The component file itself was deleted along with
         src/lib/cart.ts and the "+Ajouter" wiring in MenuContent.astro. -->


    <script>
      // Sitewide scroll-reveal — see the [data-reveal] rules in global.css
      // for what this toggles. One observer, reused for every element with
      // the attribute, on every page (no per-page wiring needed).
      //
      // Wrapped in 'astro:page-load' (fires on first load AND after every
      // View Transitions navigation) instead of running once at parse time
      // — without this, [data-reveal] elements on any page reached via
      // client-side navigation after the first would never get observed,
      // since a plain top-level script only runs once per real page load.
      document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      });
    </script>

    <script>
      // Magnetic pointer-follow for [data-magnetic] elements (the order
      // CTA button) — ported from the order-engine's MagneticButton idea
      // without framer-motion: the button nudges a few px toward the
      // cursor as it approaches, snaps back on leave. This is what "visual
      // power" without extra color/ornament looks like — the element
      // itself feels alive to touch instead of announcing itself with a
      // louder paint job.
      //
      // Same 'astro:page-load' wrapping as the reveal observer above, for
      // the same reason — otherwise the magnetic effect silently stops
      // working on any page reached via a client-side View Transition.
      document.addEventListener('astro:page-load', () => {
        const strength = 18;
        document.querySelectorAll('[data-magnetic]').forEach((el) => {
          const button = el;
          button.addEventListener('mousemove', (e) => {
            const rect = button.getBoundingClientRect();
            const relX = (e.clientX - rect.left - rect.width / 2) / rect.width;
            const relY = (e.clientY - rect.top - rect.height / 2) / rect.height;
            button.style.transform = `translate(${relX * strength}px, ${relY * strength}px)`;
          });
          button.addEventListener('mouseleave', () => {
            button.style.transform = 'translate(0, 0)';
          });
        });
      });
    </script>
  </body>
</html>
